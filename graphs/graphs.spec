%bcond check 1

%global app_id  se.sjoerd.Graphs

Name:           graphs
Version:        2.0.7
Release:        1%{?dist}
Summary:        Plot and manipulate data

License:        GPL-3.0-or-later
URL:            https://gitlab.gnome.org/World/Graphs
Source:         %{url}/-/archive/v%{version}/Graphs-v%{version}.tar.gz

BuildRequires:  blueprint-compiler
BuildRequires:  gcc
BuildRequires:  meson >= 1.2.0
BuildRequires:  vala
BuildRequires:  /usr/bin/g-ir-compiler
BuildRequires:  pkgconfig(gee-0.8)
BuildRequires:  pkgconfig(gio-2.0)
BuildRequires:  pkgconfig(glib-2.0)
BuildRequires:  pkgconfig(gobject-2.0)
BuildRequires:  pkgconfig(gtk4)
BuildRequires:  pkgconfig(libadwaita-1) >= 1.8.0
BuildRequires:  pkgconfig(sqlite3)
# meson checks that python3 has these modules
BuildRequires:  python3-devel
BuildRequires:  python3dist(gio-pyio)
BuildRequires:  python3dist(matplotlib)
BuildRequires:  python3dist(numexpr)
BuildRequires:  python3dist(numpy)
BuildRequires:  python3dist(scipy)
BuildRequires:  python3dist(sympy)

BuildRequires:  /usr/bin/appstreamcli
BuildRequires:  desktop-file-utils
BuildRequires:  gettext
BuildRequires:  itstool
%if %{with check}
BuildRequires:  python3dist(pytest)
%endif

Requires:       hicolor-icon-theme
# The Gtk-4.0 and Adw-1 typelibs, for the Python code
Requires:       gtk4
Requires:       libadwaita
Requires:       python3-gobject
Requires:       python3-matplotlib-gtk4
Requires:       python3dist(gio-pyio)
Requires:       python3dist(numexpr)
Requires:       python3dist(numpy)
Requires:       python3dist(scipy)
Requires:       python3dist(sympy)

%description
Graphs is a simple, yet powerful tool that allows you to plot and
manipulate your data with ease. New data can be imported from a wide
variety of file types, or generated by equation. Data can be transformed
with operations such as normalization, shifting and smoothing, fitted
with curves, and plotted in a range of styles.

%prep
%autosetup -n Graphs-v%{version}
# The tests' meson target installs them next to the build directory and
# runs them from there; %%check runs them against the build root instead.
sed -i "/^subdir('tests')$/d" meson.build

%conf
%meson

%build
%meson_build

%install
%meson_install
%find_lang %{name} --with-gnome

%if %{with check}
%check
%meson_test
export GI_TYPELIB_PATH=%{buildroot}%{_libdir}/girepository-1.0
export LD_LIBRARY_PATH=%{buildroot}%{_libdir}
export pkgdatadir=%{_datadir}/graphs application_id=%{app_id}
%pytest tests
%endif

%files -f %{name}.lang
%license LICENSE
%doc README.md
%{_bindir}/graphs
%{_libdir}/libgraphs.so
%{_libdir}/girepository-1.0/Graphs-1.typelib
%{python3_sitelib}/graphs/
%{_datadir}/applications/%{app_id}.desktop
%{_datadir}/dbus-1/services/%{app_id}.service
%{_datadir}/glib-2.0/schemas/%{app_id}.gschema.xml
%{_datadir}/icons/hicolor/scalable/apps/%{app_id}.svg
%{_datadir}/icons/hicolor/symbolic/apps/%{app_id}-symbolic.svg
%{_datadir}/mime/packages/%{app_id}.mime.xml
%{_mandir}/man1/graphs.1*
%{_metainfodir}/%{app_id}.metainfo.xml

