+      break;
+    case 15:
+      FPSCR_OP("mtfsfi 3,15");
+      break;
+    case 16:
+      FPSCR_OP("mtfsfi 4,0");
+      break;
+    case 17:
+      FPSCR_OP("mtfsfi 4,5");
+      break;
+    case 18:
+      FPSCR_OP("mtfsfi 4,10");
+      break;
+    case 19:
+      FPSCR_OP("mtfsfi 4,15");
+      break;
+    case 20:
+      FPSCR_OP("mtfsfi 5,0");
+      break;
+    case 21:
+      FPSCR_OP("mtfsfi 5,5");
+      break;
+    case 22:
+      FPSCR_OP("mtfsfi 5,10");
+      break;
+    case 23:
+      FPSCR_OP("mtfsfi 5,15");
+      break;
+    case 24:
+      FPSCR_OP("mtfsfi 6,0");
+      break;
+    case 25:
+      FPSCR_OP("mtfsfi 6,5");
+      break;
+    case 26:
+      FPSCR_OP("mtfsfi 6,10");
+      break;
+    case 27:
+      FPSCR_OP("mtfsfi 6,15");
+      break;
+    case 28:
+      FPSCR_OP("mtfsfi 7,0");
+      break;
+    case 29:
+      FPSCR_OP("mtfsfi 7,5");
+      break;
+    case 30:
+      FPSCR_OP("mtfsfi 7,10");
+      break;
+    case 31:
+      FPSCR_OP("mtfsfi 7,15");
+      break;
+    }
+    Record64("mtfsfi", Bits(d), Bits(fpscr), cr & 0x00F00000);
+    switch (Random() % 8)
+    {
+    case 0:
+      FPSCR_OP("mcrfs 2,0");
+      break;
+    case 1:
+      FPSCR_OP("mcrfs 2,1");
+      break;
+    case 2:
+      FPSCR_OP("mcrfs 2,2");
+      break;
+    case 3:
+      FPSCR_OP("mcrfs 2,3");
+      break;
+    case 4:
+      FPSCR_OP("mcrfs 2,4");
+      break;
+    case 5:
+      FPSCR_OP("mcrfs 2,5");
+      break;
+    case 6:
+      FPSCR_OP("mcrfs 2,6");
+      break;
+    case 7:
+      FPSCR_OP("mcrfs 2,7");
