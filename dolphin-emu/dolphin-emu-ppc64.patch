+    double ps0, ps1;
+    asm volatile("mtfsf 0xff,%3\n\tps_merge00 %0,%2,%2\n\tmffs %0\n\tps_merge11 %1,%0,%0\n\t"
+                 "mtfsf 0xff,%4"
+                 : "=&f"(ps0), "=&f"(ps1)
+                 : "f"(a), "f"(start), "f"(0.0));
+    Record64("mffs", Bits(ps0), Bits(ps1), 0);
+  }
+  End("fpscr");
