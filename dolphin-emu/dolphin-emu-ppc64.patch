+static void TestFusedMultiplyAddCases(void)
+{
+  static const u32 ties[][3] = {
+      // a, b, c
+      {0x42480000, 0x1b1c72a0, 0xbc88cc38},  // From Mario Strikers Charged
+      {0xc1b4fd47, 0x29ff8325, 0xbf019c77},
+      {0xc2118627, 0xb47a1e02, 0xc13b95b2},
