@@ -0,0 +1,43 @@
+# Builds the guest CPU test program, which runs on Dolphin to compare its CPU cores.
+# Needs a 32-bit big-endian PowerPC cross compiler, e.g. Fedora's gcc-powerpc64-linux-gnu.
+#
+#   make
+#   ./run.sh path/to/dolphin-emu-nogui cputest.elf 0 > interpreter.txt
+#   ./run.sh path/to/dolphin-emu-nogui cputest.elf 6 > jit.txt
+#   diff interpreter.txt jit.txt
+
+CC = powerpc64-linux-gnu-gcc
+CFLAGS = -m32 -mcpu=750 -mbig-endian -O2 -ffreestanding -fno-builtin -nostdlib -fno-pic \
+	-fno-stack-protector -fno-asynchronous-unwind-tables -Wa,-mgekko
+LDFLAGS = -static -Wl,-T,link.ld -Wl,--build-id=none -Wl,-z,noexecstack
+
+all: cputest.elf cputest-jit.elf cputest-jit-fprf.elf cputest-mmu.elf cputest-timing.elf fuzz.elf
+
+cputest.elf: crt0.S cputest.c link.ld
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ crt0.S cputest.c
+
+# For comparing the JITs, which don't update the FPSCR's status bits, with the interpreter. Run
+# the FPRF one with -C Dolphin.Core.FPRF=True.
+cputest-jit.elf: crt0.S cputest.c link.ld
+	$(CC) $(CFLAGS) -DFPSCR_MASK=0xFFu $(LDFLAGS) -o $@ crt0.S cputest.c
+
+cputest-jit-fprf.elf: crt0.S cputest.c link.ld
+	$(CC) $(CFLAGS) -DFPSCR_MASK=0x1F0FFu $(LDFLAGS) -o $@ crt0.S cputest.c
+
+# Also tests data storage exceptions, which need MMU mode: run it with -C Dolphin.Core.MMU=True.
+# The JIT keeps page table mappings until tlbie with page table fastmem, so its report of the
+# TLB's replacement, "page-table tlb set", only matches with -C Dolphin.Core.PageTableFastmem=False.
+cputest-mmu.elf: crt0.S cputest.c link.ld
+	$(CC) $(CFLAGS) -DFPSCR_MASK=0xFFu -DTEST_DSI $(LDFLAGS) -o $@ crt0.S cputest.c
+
+# Only the timing test, whose report depends on how a core forms blocks: compare a JIT's with its
+# report from a build known to be good. Run it with -C Dolphin.Core.CPUThread=False.
+cputest-timing.elf: crt0.S cputest.c link.ld
+	$(CC) $(CFLAGS) -DFPSCR_MASK=0xFFu -DTEST_TIMING $(LDFLAGS) -o $@ crt0.S cputest.c
+
+# The fuzzer, which fuzz.py runs.
+fuzz.elf: crt0.S fuzz_run.S fuzz.c link.ld
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ crt0.S fuzz_run.S fuzz.c
+
+clean:
+	rm -f cputest.elf cputest-jit.elf cputest-jit-fprf.elf cputest-mmu.elf cputest-timing.elf fuzz.elf
diff --git a/Tools/ppc64-jit-tests/bench.sh b/Tools/ppc64-jit-tests/bench.sh
new file mode 100755
index 0000000000..9bf07c169f
--- /dev/null
+++ b/Tools/ppc64-jit-tests/bench.sh
@@ -0,0 +1,39 @@
+#!/bin/bash
+# Runs a game at normal speed with the Null video backend and dual core (unless its settings say
+# otherwise, as some games need single core), and prints how busy the CPU (or CPU-GPU)
+# thread was. With perf, records a profile of the CPU thread, with JIT blocks named by a perf map.
+# Usage: bench.sh <dolphin-emu-nogui> <game> <core number> <seconds> [perf.data]
+set -u
+dolphin=$1
+game=$2
+core=$3
+seconds=$4
+perf_data=${5:-}
+
+user=$(mktemp -d)
+map=$(mktemp -d)
+trap 'rm -rf "$user" "$map"' EXIT
+
+"$dolphin" -u "$user" -p headless -v Null -e "$game" \
+  -C Dolphin.Core.CPUCore="$core" \
+  -C Dolphin.Core.CPUThread=True \
+  -C Dolphin.DSP.Backend="No Audio Output" \
+  -C Dolphin.Core.PerfMapDir="$map" > /dev/null 2>&1 &
+pid=$!
+
+# Skip the boot.
+sleep 10
+cpu_thread=$(grep -l -E "^CPU(-GPU)? thread$" /proc/$pid/task/*/comm | head -1 | cut -d/ -f5)
+ticks() { awk '{ print $14 + $15 }' /proc/$pid/task/$cpu_thread/stat; }
+start=$(ticks)
+if [ -n "$perf_data" ]; then
+  perf record -q -t "$cpu_thread" -o "$perf_data" -- sleep "$seconds" 2> /dev/null
+else
+  sleep "$seconds"
+fi
+end=$(ticks)
+hz=$(getconf CLK_TCK)
+cp "$map"/perf-*.map /tmp/ 2> /dev/null
+kill $pid
+wait $pid 2> /dev/null
+echo "core $core: CPU thread busy $(( (end - start) * 100 / (hz * seconds) ))% of $seconds s"
diff --git a/Tools/ppc64-jit-tests/cputest.c b/Tools/ppc64-jit-tests/cputest.c
new file mode 100644
index 0000000000..68dd5ed623
--- /dev/null
+++ b/Tools/ppc64-jit-tests/cputest.c
@@ -0,0 +1,3112 @@
+// A test program for Dolphin's CPU cores. It runs many instructions on pseudo-random and edge
+// case inputs, and reports a hash of every result, XER, CR and FPSCR value for each group of
+// tests, so that running it on two CPU cores and comparing the reports finds any difference.
+//
+// Reports go through OSReport, which Dolphin replaces with a printf to its log in debug mode.
+
+typedef unsigned char u8;
+typedef unsigned short u16;
+typedef unsigned int u32;
+typedef int s32;
+typedef unsigned long long u64;
+
+// noipa: Dolphin reads the arguments, so the compiler must not assume that this function doesn't.
+void OSReport(const char* format, ...) __attribute__((noipa, used));
+void OSReport(const char* format, ...)
+{
+  asm volatile("" : : : "memory");
+}
+
+static u32 rng_state = 0x12345678;
+static u32 Random(void)
+{
+  u32 x = rng_state;
+  x ^= x << 13;
+  x ^= x >> 17;
+  x ^= x << 5;
+  return rng_state = x;
+}
+
+// Edge cases half of the time, random values otherwise.
+static u32 Value(void)
+{
+  static const u32 edge[] = {0,      1,      2,       0x7FFFFFFF, 0x80000000, 0xFFFFFFFF,
+                             0xFFFFFFFE, 0x8000, 0x7FFF, 0xFFFF,     0x10000,    31,
+                             32,     33,     0x80000001, 0x55555555};
+  const u32 r = Random();
+  return (r & 1) ? Random() : edge[(r >> 1) % (sizeof(edge) / sizeof(edge[0]))];
+}
+
+static u32 hash;
+// Each instruction of a group also has its own hash, so that a difference names the instruction.
+#define MAX_OPS 128
+static u32 op_hashes[MAX_OPS];
+static const char* op_names[MAX_OPS];
+static u32 op_index, op_count;
+
+static void Begin(void)
+{
+  hash = 0x811C9DC5;
+  for (int i = 0; i < MAX_OPS; i++)
+    op_hashes[i] = 0x811C9DC5;
+  op_count = 0;
+}
+static void Mix(u32 value)
+{
+  hash ^= value;
+  hash *= 0x01000193;
+  hash ^= hash >> 15;
+}
+static void Mix64(u64 value)
+{
+  Mix((u32)(value >> 32));
+  Mix((u32)value);
+}
+static void BeginIteration(void)
+{
+  op_index = 0;
+}
+static void Record(const char* name, u32 a, u32 b, u32 c)
+{
+  u32 h = op_hashes[op_index];
+  const u32 values[3] = {a, b, c};
+  for (int i = 0; i < 3; i++)
+  {
+    h ^= values[i];
+    h *= 0x01000193;
+    h ^= h >> 15;
+  }
+  op_hashes[op_index] = h;
+  op_names[op_index] = name;
+  op_index++;
+  if (op_index > op_count)
+    op_count = op_index;
+  Mix(a);
+  Mix(b);
+  Mix(c);
+}
+static void Record64(const char* name, u64 a, u64 b, u32 c)
+{
+  Record(name, (u32)(a >> 32) ^ (u32)a * 3, (u32)(b >> 32) ^ (u32)b * 5, c);
+  Mix64(a);
+  Mix64(b);
+}
+static void End(const char* name)
+{
+  OSReport("TEST %s %08x\n", name, hash);
+  for (u32 i = 0; i < op_count; i++)
+  {
+    // The mnemonic, up to the first space.
+    char mnemonic[16];
+    u32 length = 0;
+    while (length < sizeof(mnemonic) - 1 && op_names[i][length] && op_names[i][length] != ' ')
+    {
+      mnemonic[length] = op_names[i][length];
+      length++;
+    }
+    mnemonic[length] = 0;
+    OSReport("TEST %s/%02u/%s %08x\n", name, i, mnemonic, op_hashes[i]);
+  }
+}
+
+#define ITERATIONS 2000
+
+// Integer instructions, with XER and CR captured afterwards.
+#define OP2(insn)                                                                                  \
+  do                                                                                               \
+  {                                                                                                \
+    u32 r_, x_, c_;                                                                                \
