+      0x7FF800000FFFFFFF, 0x7FF4000008000000, 0xFFF000000FFFFFFF, 0x7FF0000000000001,
+  };
+  Begin();
+  const double fpscr = Double(0);
+  for (u32 i = 0; i < sizeof(ties) / sizeof(ties[0]); i++)
+  {
