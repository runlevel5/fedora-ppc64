+  Write32((OP_VSX << 26) | ((t & 0x1F) << 21) | ((a & 0x1F) << 16) | ((b & 0x1F) << 11) |
+          ((c & 0x1F) << 6) | (3 << 4) | ((c >> 5) << 3) | ((a >> 5) << 2) | ((b >> 5) << 1) |
