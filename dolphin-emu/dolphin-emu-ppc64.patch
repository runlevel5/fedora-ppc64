index 0000000000..5160c17ffd
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_LoadStoreFloating.cpp
@@ -0,0 +1,222 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Floating-point loads and stores. The memory access is done in a GPR, by the same code as integer
+// loads and stores, so it gets fastmem and its slow path.
+
+#include "Core/PowerPC/JitPPC64/Jit.h"
+
+#include "Common/Assert.h"
+#include "Common/CommonTypes.h"
+#include "Common/PPC64Emitter.h"
+#include "Core/PowerPC/Gekko.h"
+#include "Core/PowerPC/PowerPC.h"
+
+using namespace PPC64Gen;
+
+void JitPPC64::ConvertDoubleToSingle(GPR value)
+{
+  // As ConvertToSingle. POWER's own conversion (stfs, xscvdpspn) matches it except for values too
+  // small to be normal singles, which POWER flushes to zero, so do it in GPRs.
+  const auto exp = gpr.GetScopedReg();
+  const auto tmp = gpr.GetScopedReg();
+
+  RLDICL(exp, value, 12, 53);
+  CMPLWI(CRF::CR1, exp, 896);
+  const FixupBranch small = BCFar(CCFlags::LE, CRF::CR1);
+
+  // Normal singles, infinities, NaNs and zeroes:
+  // ((x >> 32) & 0xc0000000) | ((x >> 29) & 0x3fffffff)
+  const u8* bits = GetCodePtr();
+  SRDI(tmp, value, 32);
+  SRDI(value, value, 29);
+  RLWIMI(value, tmp, 0, 0, 1);
+  const u8* done = GetCodePtr();
+
+  SwitchToFarCode();
+  SetJumpTarget(small);
+  // Zeroes, and exponents below 874 (which are said to be undefined; this is from hardware tests),
+  // take the bits as above.
+  CLRLDI(tmp, value, 1);
+  CMPDI(CRF::CR1, tmp, 0);
+  const FixupBranch zero = BC(CCFlags::EQ, CRF::CR1);
+  CMPLWI(CRF::CR1, exp, 874);
+  const FixupBranch tiny = BC(CCFlags::LT, CRF::CR1);
+  // Denormal singles:
+  // ((0x80000000 | ((x & DOUBLE_FRAC) >> 21)) >> (905 - exp)) | ((x >> 32) & 0x80000000)
+  CLRLDI(tmp, value, 12);
+  SRDI(tmp, tmp, 21);
+  ORIS(tmp, tmp, 0x8000);
+  SUBFIC(exp, exp, 905);
+  SRW(tmp, tmp, exp);
+  SRDI(exp, value, 32);
+  RLWIMI(tmp, exp, 0, 0, 0);
+  MR(value, tmp);
+  B(done);
+  SetJumpTarget(zero);
+  SetJumpTarget(tiny);
+  B(bits);
+  SwitchToNearCode();
+}
+
+void JitPPC64::lfXX(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITLoadStoreFloatingOff);
+
+  bool single = false;
+  bool indexed = false;
+  bool update = false;
+  switch (inst.OPCD)
+  {
+  case 31:
+    indexed = true;
+    switch (inst.SUBOP10)
+    {
+    case 567:  // lfsux
+      update = true;
+      [[fallthrough]];
+    case 535:  // lfsx
+      single = true;
+      break;
+    case 631:  // lfdux
+      update = true;
+      [[fallthrough]];
+    case 599:  // lfdx
+      break;
+    default:
+      ASSERT_MSG(DYNA_REC, false, "Unexpected load {:#010x}", inst.hex);
+      break;
+    }
+    break;
+  case 49:  // lfsu
+    update = true;
+    [[fallthrough]];
+  case 48:  // lfs
+    single = true;
+    break;
+  case 51:  // lfdu
+    update = true;
+    [[fallthrough]];
+  case 50:  // lfd
+    break;
+  default:
+    ASSERT_MSG(DYNA_REC, false, "Unexpected load {:#010x}", inst.hex);
+    break;
+  }
+
+  // The invalid form is left to the interpreter.
+  FALLBACK_IF(update && inst.RA == 0);
+
+  const auto addr = gpr.GetScopedReg();
+  const auto value = gpr.GetScopedReg();
+  ComputeAddress(addr, inst, indexed);
+  const GPR a = update ? gpr.RW(inst.RA, true) : GPR::R0;
+
+  // Into VS0, which isn't allocated: FD is bound after the access, which memory checks require.
+  EmitLoadToVSR(single ? 32 : 64, VSR::VS0, value, addr);
+
+  // lfd only writes ps0.
+  const VSR d = fpr.RW(inst.FD, !single);
+  if (single)
+  {
+    // As ConvertToDouble, into both halves.
+    XSCVSPDPN(d, VSR::VS0);
+    XXPERMDI(d, d, d, 0);
+  }
+  else
+  {
+    XXPERMDI(d, VSR::VS0, d, 1);
+  }
+
+  if (update)
+    MR(a, addr);
+}
+
+void JitPPC64::stfXX(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITLoadStoreFloatingOff);
+
+  bool single = false;
+  bool integer = false;
+  bool indexed = false;
+  bool update = false;
+  switch (inst.OPCD)
+  {
+  case 31:
+    indexed = true;
+    switch (inst.SUBOP10)
+    {
+    case 695:  // stfsux
+      update = true;
+      [[fallthrough]];
+    case 663:  // stfsx
+      single = true;
+      break;
+    case 759:  // stfdux
+      update = true;
+      [[fallthrough]];
+    case 727:  // stfdx
+      break;
+    case 983:  // stfiwx
+      integer = true;
+      break;
+    default:
+      ASSERT_MSG(DYNA_REC, false, "Unexpected store {:#010x}", inst.hex);
+      break;
+    }
+    break;
+  case 53:  // stfsu
+    update = true;
+    [[fallthrough]];
+  case 52:  // stfs
+    single = true;
+    break;
+  case 55:  // stfdu
+    update = true;
+    [[fallthrough]];
+  case 54:  // stfd
+    break;
+  default:
+    ASSERT_MSG(DYNA_REC, false, "Unexpected store {:#010x}", inst.hex);
+    break;
+  }
+
+  // The invalid form is left to the interpreter.
+  FALLBACK_IF(update && inst.RA == 0);
+
+  const auto addr = gpr.GetScopedReg();
+  const auto value = gpr.GetScopedReg();
+  ComputeAddress(addr, inst, indexed);
+  const bool singles = fpr.HoldsSingles(inst.FS);
+  const VSR s = singles ? fpr.RSingle(inst.FS) : fpr.R(inst.FS);
+  const GPR a = update ? gpr.RW(inst.RA, true) : GPR::R0;
+
+  if (single && singles)
+  {
+    // ps0 as a single is in word 1 too, which stores of 32 bits store.
+    EmitStoreFromVSR(32, s, value, addr);
+  }
+  else if (single)
+  {
+    MFVSRD(value, s);
+    ConvertDoubleToSingle(value);
+    EmitMemoryAccess({.store = true, .size = 32}, value, addr);
+  }
+  else
+  {
+    // stfd, or stfiwx, which stores the low word, of ps0 as a double. A single is converted,
+    // exactly, in VS1, which isn't allocated: the store mustn't hold scratch registers.
+    VSR ps0 = s;
+    if (singles)
+    {
+      XSCVSPDPN(VSR::VS1, s);
+      ps0 = VSR::VS1;
+    }
+    EmitStoreFromVSR(integer ? 32 : 64, ps0, value, addr);
+  }
+
+  if (update)
+    MR(a, addr);
+}
diff --git a/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_LoadStorePaired.cpp b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_LoadStorePaired.cpp
new file mode 100644
index 0000000000..a97fadc12c
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_LoadStorePaired.cpp
@@ -0,0 +1,875 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Quantized loads and stores (psq_l and psq_st).
+//
+// The GQRs that a block uses but doesn't set are taken to be the values they had when it was
+// compiled, as Jit64 does, and checked at the start of the block (see DoJit). With them known,
+// each instruction is compiled for its type and scale, and its memory access gets fastmem.
+// Otherwise, the instruction falls back to the interpreter.
+//
+// A block whose GQRs did change under it is compiled again without that, and would then call a
+// routine for the GQR's type at each access, with an indirect call that costs more than the
+// access. Instead each access is still compiled for the GQR's value at the time, and checks the
+// value itself, calling the routine in far code only when it differs: games that transform
+// vertices of different formats with one function change the GQRs between calls, not within.
+
+#include "Core/PowerPC/JitPPC64/Jit.h"
+
+#include "Common/Assert.h"
+#include "Common/CommonTypes.h"
+#include "Common/PPC64Emitter.h"
+#include "Core/PowerPC/Gekko.h"
+#include "Core/PowerPC/PowerPC.h"
+
+using namespace PPC64Gen;
+
+namespace
+{
+struct QuantizedType
+{
+  bool valid = false;
+  bool is_float = false;
+  bool is_signed = false;
+  // The size of one half, in bits
+  u32 size = 0;
+};
+
+QuantizedType DecodeQuantizedType(EQuantizeType type)
+{
+  switch (type)
+  {
+  case QUANTIZE_FLOAT:
+    return {true, true, false, 32};
+  case QUANTIZE_U8:
+    return {true, false, false, 8};
+  case QUANTIZE_U16:
+    return {true, false, false, 16};
+  case QUANTIZE_S8:
+    return {true, false, true, 8};
+  case QUANTIZE_S16:
+    return {true, false, true, 16};
+  default:
+    return {};
+  }
+}
+
+// Quantizing multiplies by 2^exponent, and dequantizing by 2^-exponent, as m_quantizeTable and
+// m_dequantizeTable do: the 6-bit scale is signed.
+s32 ScaleExponent(u32 scale)
+{
+  return scale < 32 ? static_cast<s32>(scale) : static_cast<s32>(scale) - 64;
+}
+}  // namespace
+
+// The double 2^exponent, with Power10's xxspltidp, which converts the single it splats.
+void JitPPC64::LoadPowerOfTwo(VSR out, GPR tmp, s32 exponent, bool splat)
+{
+  if (m_isa_3_1)
+  {
+    XXSPLTIDP(out, static_cast<u32>(127 + exponent) << 23);
+    return;
+  }
+  LI(tmp, static_cast<s16>(1023 + exponent));
+  SLDI(tmp, tmp, 52);
+  MTVSRD(out, tmp);
+  if (splat)
+    XXPERMDI(out, out, out, 0);
+}
+
+void JitPPC64::DequantizePair(VSR out, GPR hi, GPR lo, u32 type_size, bool is_signed, VSR factor)
+{
+  if (is_signed)
+  {
+    type_size == 8 ? EXTSB(hi, hi) : EXTSH(hi, hi);
+    type_size == 8 ? EXTSB(lo, lo) : EXTSH(lo, lo);
+  }
+  MTVSRDD(out, hi, lo);
+  XVCVSXDDP(out, out);
+  if (factor != VSR::VS0)
+    XVMULDP(out, out, factor);
+}
+
+void JitPPC64::QuantizePair(GPR out, GPR tmp, VSR in, u32 type_size, bool is_signed, VSR factor,
+                            VSR scaled, VSR work)
+{
+  // As QuantizeHalf. The scaling is by a power of two, exact in double precision, where single
+  // precision would overflow or underflow only for values that saturate or truncate to 0 anyway.
+  XVCVDPSP(scaled, in);
+  XVCVSPDP(scaled, scaled);
+  if (factor != VSR::VS0)
+    XVMULDP(scaled, scaled, factor);
+  // NaNs convert to 0.
+  XVCMPEQDP(work, scaled, scaled);
+  XVCVDPSXWS(scaled, scaled);
+  XXLAND(scaled, scaled, work);
+
+  const s32 min = is_signed ? -(1 << (type_size - 1)) : 0;
+  const u32 max = is_signed ? (1u << (type_size - 1)) - 1 : (1u << type_size) - 1;
+  LI(tmp, static_cast<s16>(min));
+  MTVSRWS(work, tmp);
+  VMAXSW(scaled, scaled, work);
+  MOVI2R(tmp, max);
+  MTVSRWS(work, tmp);
+  VMINSW(scaled, scaled, work);
+
+  // Words 0 and 2, in the upper halves of the doublewords.
+  MFVSRD(out, scaled);
+  MFVSRLD(tmp, scaled);
+  RLDICL(out, out, 32, 64 - type_size);
+  RLDICL(tmp, tmp, 32, 64 - type_size);
+  SLDI(out, out, type_size);
+  OR(out, out, tmp);
+}
+
+void JitPPC64::psq_lXX(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITLoadStorePairedOff);
+
+  const bool indexed = inst.OPCD == 4;
+  const bool update = inst.OPCD == 57 || (indexed && (inst.SUBOP6 & 32));
+  const u32 i = indexed ? inst.Ix : inst.I;
+  const bool single = indexed ? inst.Wx : inst.W;
+  // The invalid form is left to the interpreter.
+  FALLBACK_IF(update && inst.RA == 0);
+
+  const bool speculate = !js.constantGqrValid[i];
+  if (speculate && !CanSpeculateGqr(i))
+  {
+    QuantizedLoadStoreWithRoutine(inst, false, indexed, update, i, single);
+    return;
+  }
+
+  const UGQR gqr(speculate ? GQR(m_ppc_state, i) : js.constantGqr[i]);
+  const QuantizedType type = DecodeQuantizedType(gqr.ld_type);
+  if (speculate && !type.valid)
+  {
+    QuantizedLoadStoreWithRoutine(inst, false, indexed, update, i, single);
+    return;
+  }
+  FALLBACK_IF(!type.valid);
+  const s32 exponent = ScaleExponent(gqr.ld_scale);
+  // With Power ISA 3.0, both halves of integers are converted at once.
+  const bool integer_pair = !single && !type.is_float && m_isa_3_0;
+
+  const auto addr = gpr.GetScopedReg();
+  const auto value = gpr.GetScopedReg();
+  if (indexed)
+  {
+    if (inst.RA == 0)
+      CLRLDI(addr, gpr.R(inst.RB), 32);
+    else
+      ADD(addr, gpr.R(inst.RA), gpr.R(inst.RB));
+  }
+  else
+  {
+    if (inst.RA == 0)
+      MOVI2R(addr, static_cast<u32>(static_cast<s32>(inst.SIMM_12)));
+    else
+      ADDI(addr, gpr.R(inst.RA), inst.SIMM_12);
+  }
+  CLRLDI(addr, addr, 32);
+  const GPR a = update ? gpr.RW(inst.RA, true) : GPR::R0;
+  FixupBranch gqr_differs;
+  if (speculate)
+    gqr_differs = EmitGqrCheck(i, gqr.Hex, false);
+
+  // Floats are loaded into VS0, which isn't allocated, half 0 in word 0 and half 1 in word 1.
+  if (type.is_float)
+    EmitLoadToVSR(single ? 32 : 64, VSR::VS0, value, addr);
+  else
+    EmitMemoryAccess({.size = single ? type.size : 2 * type.size}, value, addr);
+
+  // FD gets singles: a float's bits as they are, as ConvertToDouble keeps them, or an integer's
+  // value, converted to single precision exactly from double precision. Each half is in two words.
+  // They go to a scratch register first, which the far code below fills too, so that FD isn't
+  // bound, and so written on an exception, before both have it.
+  const auto result = fpr.GetScopedReg();
+  const auto tmp = gpr.GetScopedReg();
+  bool quiet = false;
+  if (type.is_float)
+  {
+    if (single)
+    {
+      // ps1 is 1.0.
+      const auto half0 = fpr.GetScopedReg();
+      const auto one = fpr.GetScopedReg();
+      XXSPLTW(half0, VSR::VS0, 0);
+      if (m_isa_3_1)
+      {
+        XXSPLTIW(one, 0x3F800000);
+      }
+      else
+      {
+        LIS(tmp, 0x3F80);
+        MTVSRWZ(one, tmp);
+        XXSPLTW(one, one, 1);
+      }
+      XXPERMDI(result, half0, one, 0);
+    }
+    else
+    {
+      XXMRGHW(result, VSR::VS0, VSR::VS0);
+    }
+  }
+  else
+  {
+    // Integers' halves are in big-endian order in value: half 0 in the upper bits.
+    // float(T(value)) * m_dequantizeTable[scale]: exact, as is doing it in double precision.
+    const auto convert = [&](VSR out, GPR integer) {
+      if (type.is_signed)
+        type.size == 8 ? EXTSB(integer, integer) : EXTSH(integer, integer);
+      MTVSRD(out, integer);
+      XSCVSXDDP(out, out);
+      if (exponent != 0)
+      {
+        const auto factor = fpr.GetScopedReg();
+        LoadPowerOfTwo(factor, integer, -exponent);
+        XSMULDP(out, out, factor);
+      }
+    };
+    const auto doubles = fpr.GetScopedReg();
+    const auto half0 = fpr.GetScopedReg();
+    const auto half1 = fpr.GetScopedReg();
+    if (integer_pair)
+    {
+      // With the factor in half1.
+      if (exponent != 0)
+        LoadPowerOfTwo(half1, tmp, -exponent, true);
+      CLRLDI(tmp, value, 64 - type.size);
+      SRDI(value, value, type.size);
+      DequantizePair(doubles, value, tmp, type.size, type.is_signed,
+                     exponent != 0 ? VSR(half1) : VSR::VS0);
+    }
+    else
+    {
+      if (single)
+      {
+        convert(half0, value);
+        // ps1 is 1.0.
+        LoadPowerOfTwo(half1, tmp, 0);
+      }
+      else
+      {
+        CLRLDI(tmp, value, 64 - type.size);
+        SRDI(value, value, type.size);
+        convert(half0, value);
+        convert(half1, tmp);
+      }
+      XXPERMDI(doubles, half0, half1, 0);
+    }
+    ConvertDoublesToSingles(result, doubles);
+    // The routine may load floats, which may be signaling NaNs.
+    quiet = !speculate;
+  }
+
+  FixupBranch loaded;
+  if (speculate)
+  {
+    SwitchToFarCode();
+    SetJumpTarget(gqr_differs);
+    // The routine clobbers VS32-VS35, which only result may be, and it's written after.
+    EmitQuantizedRoutineCall(false, i, single, addr);
+    if (jo.memcheck)
+      WriteConditionalExceptionExit(EXCEPTION_DSI, GPR::R12);
+    XXLOR(result, VSR::VS32, VSR::VS32);
+    loaded = B();
+    SwitchToNearCode();
+    SetJumpTarget(loaded);
+  }
+
+  const VSR d = fpr.BindForSingles(inst.FD);
+  XXLOR(d, result, result);
+  fpr.MarkSingles(inst.FD, quiet);
+
+  if (update)
+    MR(a, addr);
+}
+
+void JitPPC64::QuantizeHalf(GPR out, VSR in, u32 type_size, bool is_signed, s32 exponent)
+{
+  const auto scaled = fpr.GetScopedReg();
+  const auto bound = gpr.GetScopedReg();
+  if (exponent == 0)
+  {
+    QuantizeHalf(out, in, type_size, is_signed, VSR::VS0, scaled, bound);
+    return;
+  }
+  const auto factor = fpr.GetScopedReg();
+  LoadPowerOfTwo(factor, out, exponent);
+  QuantizeHalf(out, in, type_size, is_signed, factor, scaled, bound);
+}
+
+void JitPPC64::QuantizeHalf(GPR out, VSR in, u32 type_size, bool is_signed, VSR factor, VSR scaled,
+                            GPR bound)
+{
+  // As ScaleAndClamp: SType(std::clamp(float(ps) * m_quantizeTable[scale], min, max)), with the
+  // factor 2^scale, or no factor for 2^0 (VS0). Clamping and truncating toward zero can go either
+  // way round, as the bounds are integers; a NaN, which std::clamp passes through, converts to 0.
+  XSRSP(scaled, in);
+  if (factor != VSR::VS0)
+    XSMULSP(scaled, scaled, factor);
+  XSCMPUDP(CRF::CR1, scaled, scaled);
+  // Truncates, saturating to 32 bits.
+  XSCVDPSXWS(scaled, scaled);
+  MFVSRD(out, scaled);
+  EXTSW(out, out);
+  ISEL(out, GPR::R0, out, CRBit(CRF::CR1, CCFlags::SO));
+
+  const s32 min = is_signed ? -(1 << (type_size - 1)) : 0;
+  const u32 max = is_signed ? (1u << (type_size - 1)) - 1 : (1u << type_size) - 1;
+  LI(bound, static_cast<s16>(min));
+  CMPW(CRF::CR1, out, bound);
+  ISEL(out, bound, out, CRBit(CRF::CR1, CCFlags::LT));
+  MOVI2R(bound, max);
+  CMPW(CRF::CR1, out, bound);
+  ISEL(out, bound, out, CRBit(CRF::CR1, CCFlags::GT));
+}
+
+void JitPPC64::ConvertDoubleToSingleFTZ(GPR value)
+{
+  const auto exp = gpr.GetScopedReg();
+  const auto high = gpr.GetScopedReg();
+  ConvertDoubleToSingleFTZ(value, exp, high);
+}
+
+void JitPPC64::ConvertDoubleToSingleFTZ(GPR value, GPR exp, GPR high)
+{
+  // As ConvertToSingleFTZ: like ConvertToSingle, but values too small for normal singles become
+  // zeroes of the same sign.
+  RLDICL(exp, value, 12, 53);
+  CMPLWI(CRF::CR1, exp, 896);
+  SRDI(high, value, 32);
+  SRDI(value, value, 29);
+  RLWIMI(value, high, 0, 0, 1);
+  RLWINM(high, high, 0, 0, 0);
+  ISEL(value, value, high, CRBit(CRF::CR1, CCFlags::GT));
+  CLRLDI(value, value, 32);
+}
+
+void JitPPC64::FlushDenormalSingles(VSR out, VSR in)
+{
+  // Each word gets its sign alone if it's a denormal: with Power ISA 3.0, as the test of its data
+  // class says, or else if its magnitude is below that of the smallest normal single, which also
+  // keeps the sign of zeroes alone.
+  const auto magnitude = fpr.GetScopedReg();
+  const auto mask = fpr.GetScopedReg();
+  XVABSSP(magnitude, in);
+  if (m_isa_3_0)
+  {
+    XVTSTDCSP(mask, in, 0x03);
+  }
+  else
+  {
+    // 1 << 23, shifting by the low 5 bits of -9.
+    const auto shift = fpr.GetScopedReg();
+    VSPLTISW(mask, 1);
+    VSPLTISW(shift, -9);
+    VSLW(mask, mask, shift);
+    VCMPGTUW(mask, mask, magnitude);
+  }
+  XXLXOR(magnitude, magnitude, in);
+  XXSEL(out, in, magnitude, mask);
+}
+
+void JitPPC64::psq_stXX(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITLoadStorePairedOff);
+
+  const bool indexed = inst.OPCD == 4;
+  const bool update = inst.OPCD == 61 || (indexed && (inst.SUBOP6 & 32));
+  const u32 i = indexed ? inst.Ix : inst.I;
+  const bool single = indexed ? inst.Wx : inst.W;
+  // The invalid form is left to the interpreter.
+  FALLBACK_IF(update && inst.RA == 0);
+
+  const bool speculate = !js.constantGqrValid[i];
+  if (speculate && !CanSpeculateGqr(i))
+  {
+    QuantizedLoadStoreWithRoutine(inst, true, indexed, update, i, single);
+    return;
+  }
+
+  const UGQR gqr(speculate ? GQR(m_ppc_state, i) : js.constantGqr[i]);
+  const QuantizedType type = DecodeQuantizedType(gqr.st_type);
+  if (speculate && !type.valid)
+  {
+    QuantizedLoadStoreWithRoutine(inst, true, indexed, update, i, single);
+    return;
+  }
+  FALLBACK_IF(!type.valid);
+  const s32 exponent = ScaleExponent(gqr.st_scale);
+  // With Power ISA 3.0, both halves of integers are quantized at once.
+  const bool integer_pair = !single && !type.is_float && m_isa_3_0;
+
+  const auto addr = gpr.GetScopedReg();
+  const auto value = gpr.GetScopedReg();
+  if (indexed)
+  {
+    if (inst.RA == 0)
+      CLRLDI(addr, gpr.R(inst.RB), 32);
+    else
+      ADD(addr, gpr.R(inst.RA), gpr.R(inst.RB));
+  }
+  else
+  {
+    if (inst.RA == 0)
+      MOVI2R(addr, static_cast<u32>(static_cast<s32>(inst.SIMM_12)));
+    else
+      ADDI(addr, gpr.R(inst.RA), inst.SIMM_12);
+  }
+  CLRLDI(addr, addr, 32);
+  const bool singles = fpr.HoldsSingles(inst.FS);
+  const VSR held = singles ? fpr.RSingle(inst.FS) : fpr.R(inst.FS);
+  const GPR a = update ? gpr.RW(inst.RA, true) : GPR::R0;
+  FixupBranch gqr_differs;
+  if (speculate)
+    gqr_differs = EmitGqrCheck(i, gqr.Hex, true);
+
+  if (singles && type.is_float)
+  {
+    // As ConvertToSingleFTZ: the singles as they are, but denormals become zeroes.
+    const auto flushed = fpr.GetScopedReg();
+    FlushDenormalSingles(flushed, held);
+    if (single)
+    {
+      // ps0 is in word 1 too.
+      MFVSRWZ(value, flushed);
+    }
+    else
+    {
+      // Words 1 and 2, ps0 and ps1, into doubleword 0.
+      XXSLDWI(flushed, flushed, flushed, 1);
+      MFVSRD(value, flushed);
+    }
+  }
+  else
+  {
+    // Singles are quantized from doubles, which quantizing rounds to single precision anyway.
+    PPC64FPRCache::ScopedReg doubles;
+    VSR s = held;
+    if (singles)
+    {
+      doubles = fpr.GetScopedReg();
+      XVCVSPDP(doubles, held);
+      s = doubles;
+    }
+
+    const auto value1 = gpr.GetScopedReg();
+    // ps1 swapped into doubleword 0. With Power ISA 3.0, ps1 of floats goes to a GPR with mfvsrld
+    // instead, and integers are quantized both at once.
+    PPC64FPRCache::ScopedReg half1;
+    if (!single && !m_isa_3_0)
+    {
+      half1 = fpr.GetScopedReg();
+      XXSWAPD(half1, s);
+    }
+
+    if (type.is_float)
+    {
+      MFVSRD(value, s);
+      ConvertDoubleToSingleFTZ(value);
+      if (!single)
+      {
+        if (m_isa_3_0)
+          MFVSRLD(value1, s);
+        else
+          MFVSRD(value1, half1);
+        ConvertDoubleToSingleFTZ(value1);
+      }
+    }
+    else
+    {
+      if (integer_pair)
+      {
+        const auto factor = fpr.GetScopedReg();
+        const auto scaled = fpr.GetScopedReg();
+        const auto work = fpr.GetScopedReg();
+        if (exponent != 0)
+          LoadPowerOfTwo(factor, value1, exponent, true);
+        QuantizePair(value, value1, s, type.size, type.is_signed,
+                     exponent != 0 ? VSR(factor) : VSR::VS0, scaled, work);
+      }
+      else
+      {
+        QuantizeHalf(value, s, type.size, type.is_signed, exponent);
+        if (!single)
+          QuantizeHalf(value1, half1, type.size, type.is_signed, exponent);
+      }
+    }
+
+    // Half 0 goes in the upper bits, which are stored first; QuantizePair put it there.
+    if (!single && !integer_pair)
+    {
+      CLRLDI(value1, value1, 64 - type.size);
+      SLDI(value, value, type.size);
+      OR(value, value, value1);
+    }
+  }
+
+  EmitMemoryAccess({.store = true, .size = single ? type.size : 2 * type.size}, value, addr);
+
+  const u8* const stored = GetCodePtr();
+  if (update)
+    MR(a, addr);
+
+  if (speculate)
+  {
+    SwitchToFarCode();
+    SetJumpTarget(gqr_differs);
+    // The routine takes doubles, in VS32. The host register holds them, or singles as it did.
+    if (fpr.HoldsSingles(inst.FS))
+      ConvertSinglesToDoubles(VSR::VS32, held, fpr.IsQuiet(inst.FS));
+    else
+      XXLOR(VSR::VS32, held, held);
+    EmitQuantizedRoutineCall(true, i, single, addr);
+    if (jo.memcheck)
+      WriteConditionalExceptionExit(EXCEPTION_DSI, GPR::R12);
+    B(stored);
+    SwitchToNearCode();
+  }
+}
+
+bool JitPPC64::CanSpeculateGqr(u32 gqr_index) const
+{
+  // A GQR the block sets isn't what it was at compile time when the access runs.
+  return !code_block.m_gqr_modified[gqr_index];
+}
+
+FixupBranch JitPPC64::EmitGqrCheck(u32 gqr_index, u32 value, bool store)
+{
+  // UGQR: st_type in bits 0-2, st_scale in 8-13, ld_type in 16-18, ld_scale in 24-29. The
+  // halfword with the type and scale of the access is compared. Uses R12.
+  LWZ(GPR::R12, PPC_REG, PPCSTATE_OFF_SPR(SPR_GQR0 + gqr_index));
+  if (store)
+    CLRLWI(GPR::R12, GPR::R12, 16);
+  else
+    SRWI(GPR::R12, GPR::R12, 16);
+  CMPLWI(CRF::CR1, GPR::R12, static_cast<u16>(store ? value : value >> 16));
+  return BCFar(CCFlags::NE, CRF::CR1);
+}
+
+void JitPPC64::EmitQuantizedRoutineCall(bool store, u32 gqr_index, bool single, GPR addr)
+{
+  // The routines take the address in R3, the scale in R4 and the value in VS32, as doubles for
+  // stores and singles for loads, preserve the scratch GPRs, and may clobber R0, R3, R4, R12,
+  // CTR, VS32-VS35. The callers' scratch FPRs hold nothing live by the call.
+
+  // The PC is used by memory checks, by GPFifo to find stores to the gather pipe, and in logs.
+  MOVI2R(GPR::R12, js.compilerPC);
+  STW(GPR::R12, PPC_REG, PPCSTATE_OFF(pc));
+
+  // UGQR: st_type in bits 0-2, st_scale in 8-13, ld_type in 16-18, ld_scale in 24-29. The
+  // routines' index is W << 3 | type, in bytes << 3.
+  LWZ(GPR::R12, PPC_REG, PPCSTATE_OFF_SPR(SPR_GQR0 + gqr_index));
+  if (store)
+  {
+    RLWINM(GPR::R4, GPR::R12, 24, 26, 31);
+    RLWINM(GPR::R12, GPR::R12, 3, 26, 28);
+  }
+  else
+  {
+    RLWINM(GPR::R4, GPR::R12, 8, 26, 31);
+    RLWINM(GPR::R12, GPR::R12, 32 - 13, 26, 28);
+  }
+  const auto& routines = store ? m_quantized_store_routines : m_quantized_load_routines;
+  MOVP2R(GPR::R3, routines.data() + (single ? 8 : 0));
+  LDX(GPR::R12, GPR::R3, GPR::R12);
+  MTCTR(GPR::R12);
+  MR(GPR::R3, addr);
+  BCTRL();
+}
+
+void JitPPC64::QuantizedLoadStoreWithRoutine(UGeckoInstruction inst, bool store, bool indexed,
+                                             bool update, u32 gqr_index, bool single)
+{
+  // The GQR may change while the block runs, so call the routine for its type, with its scale.
+  ASSERT(!fpr.AnyScratchRegsInUse());
+  const auto addr = gpr.GetScopedReg();
+  if (indexed)
+  {
+    if (inst.RA == 0)
+      CLRLDI(addr, gpr.R(inst.RB), 32);
+    else
+      ADD(addr, gpr.R(inst.RA), gpr.R(inst.RB));
+  }
+  else
+  {
+    if (inst.RA == 0)
+      MOVI2R(addr, static_cast<u32>(static_cast<s32>(inst.SIMM_12)));
+    else
+      ADDI(addr, gpr.R(inst.RA), inst.SIMM_12);
+  }
+  CLRLDI(addr, addr, 32);
+  const GPR a = update ? gpr.RW(inst.RA, true) : GPR::R0;
+  if (store)
+  {
+    const VSR s = fpr.R(inst.FS);
+    XXLOR(VSR::VS32, s, s);
+  }
+  EmitQuantizedRoutineCall(store, gqr_index, single, addr);
+
+  if (jo.memcheck)
+    WriteConditionalExceptionExit(EXCEPTION_DSI, GPR::R12);
+
+  if (!store)
+  {
+    // Floats may be signaling NaNs.
+    XXLOR(fpr.BindForSingles(inst.FD), VSR::VS32, VSR::VS32);
+    fpr.MarkSingles(inst.FD, false);
+  }
+  if (update)
+    MR(a, addr);
+}
+
+std::array<FixupBranch, 3> JitPPC64::EmitQuantizedRAMAddress(u32 size)
+{
+  // From the address in R3, leaves the host address of RAM in R12, or branches away if the access
+  // isn't to cached RAM by a DBAT: page table translations, MMIO, real mode and accesses that cross
+  // 8-byte boundaries take the slow path. Uses R0.
+  LWZ(GPR::R12, PPC_REG, PPCSTATE_OFF(msr));
+  ANDI_(GPR::R12, GPR::R12, 1 << UReg_MSR{}.DR.StartBit());
+  const FixupBranch real_mode = BC(CCFlags::EQ, CRF::CR0);
+
+  MOVP2R(GPR::R12, m_mmu.GetDBATTable().data());
+  RLWINM(GPR::R0, GPR::R3, 32 - PowerPC::BAT_INDEX_SHIFT + 2, PowerPC::BAT_INDEX_SHIFT - 2, 29);
+  LWZX(GPR::R12, GPR::R12, GPR::R0);
+  ANDI_(GPR::R0, GPR::R12, PowerPC::BAT_PHYSICAL_BIT);
+  const FixupBranch not_physical = BC(CCFlags::EQ, CRF::CR0);
+  RLWIMI(GPR::R12, GPR::R3, 0, 32 - PowerPC::BAT_INDEX_SHIFT, 31);
+
+  RLWINM(GPR::R0, GPR::R3, 0, 29, 31);
+  CMPLWI(CRF::CR1, GPR::R0, 8 - size);
+  auto& memory = m_system.GetMemory();
+  MOVI2R(GPR::R0, memory.GetRamSizeReal());
+  CMPLW(CRF::CR0, GPR::R12, GPR::R0);
+  // Misaligned, or at or beyond the end of RAM.
+  CRORC(CRBit(CRF::CR1, CCFlags::GT), CRBit(CRF::CR1, CCFlags::GT), CRBit(CRF::CR0, CCFlags::LT));
+  const FixupBranch not_ram = BC(CCFlags::GT, CRF::CR1);
+
+  ASSERT(memory.GetRAM() != nullptr);
+  MOVP2R(GPR::R0, memory.GetRAM());
+  ADD(GPR::R12, GPR::R12, GPR::R0);
+  return {real_mode, not_physical, not_ram};
+}
+
+void JitPPC64::GenerateQuantizedRoutines()
+{
+  for (const bool single : {false, true})
+  {
+    for (u32 type = 0; type < 8; type++)
+    {
+      m_quantized_load_routines[(single ? 8 : 0) | type] = GetCodePtr();
+      GenerateQuantizedLoadRoutine(type, single);
+      m_quantized_store_routines[(single ? 8 : 0) | type] = GetCodePtr();
+      GenerateQuantizedStoreRoutine(type, single);
+    }
+  }
+}
+
+void JitPPC64::GenerateQuantizedLoadRoutine(u32 type, bool single)
+{
+  const QuantizedType decoded = DecodeQuantizedType(static_cast<EQuantizeType>(type));
+  const bool integer_pair = !single && !decoded.is_float && m_isa_3_0;
+  if (!decoded.valid)
+  {
+    // As Helper_Dequantize: zeroes, without an access.
+    XXLXOR(VSR::VS32, VSR::VS32, VSR::VS32);
+    BLR();
+    return;
+  }
+
+  const u32 size = (single ? 1 : 2) * decoded.size / 8;
+  MFLR(GPR::R0);
+  STD(GPR::R0, GPR::SP, QUANTIZED_LR_SAVE);
+  STD(GPR::R4, GPR::SP, QUANTIZED_VALUE_SAVE);
+
+  const auto slow = EmitQuantizedRAMAddress(size);
+  switch (size)
+  {
+  case 8:
+    LDBRX(GPR::R3, GPR::R0, GPR::R12);
+    break;
+  case 4:
+    LWBRX(GPR::R3, GPR::R0, GPR::R12);
+    break;
+  case 2:
+    LHBRX(GPR::R3, GPR::R0, GPR::R12);
+    break;
+  default:
+    LBZX(GPR::R3, GPR::R0, GPR::R12);
+    break;
+  }
+  const FixupBranch loaded = B();
+  for (const FixupBranch& branch : slow)
+    SetJumpTarget(branch);
+  BL(Routine(m_slow_access_routines[SlowAccessRoutineIndex({.size = size * 8})]));
+  SetJumpTarget(loaded);
+
+  // The halves are in big-endian order in R3: half 0 in the upper bits. They're returned as singles,
+  // each in two words, as psq_lXX leaves them.
+  if (decoded.is_float)
+  {
+    // The bits as they are, in words 0 and 1, with 1.0 for ps1 of the single form.
+    if (single)
+    {
+      SLDI(GPR::R3, GPR::R3, 32);
+      ORIS(GPR::R3, GPR::R3, 0x3F80);
+    }
+    MTVSRD(VSR::VS34, GPR::R3);
+    XXMRGHW(VSR::VS32, VSR::VS34, VSR::VS34);
+  }
+  else
+  {
+    // float(T(value)) * m_dequantizeTable[scale], with the factor 2^-scale, from the sign-extended
+    // 6-bit scale.
+    LD(GPR::R4, GPR::SP, QUANTIZED_VALUE_SAVE);
+    SLDI(GPR::R4, GPR::R4, 58);
+    SRADI(GPR::R4, GPR::R4, 58);
+    SUBFIC(GPR::R4, GPR::R4, 1023);
+    SLDI(GPR::R4, GPR::R4, 52);
+    MTVSRD(VSR::VS35, GPR::R4);
+    const auto convert = [&](VSR out, GPR integer) {
+      if (decoded.is_signed)
+        decoded.size == 8 ? EXTSB(integer, integer) : EXTSH(integer, integer);
+      MTVSRD(out, integer);
+      XSCVSXDDP(out, out);
+      XSMULDP(out, out, VSR::VS35);
+    };
+    if (single)
+    {
+      convert(VSR::VS33, GPR::R3);
+    }
+    else
+    {
+      CLRLDI(GPR::R12, GPR::R3, 64 - decoded.size);
+      SRDI(GPR::R3, GPR::R3, decoded.size);
+      if (integer_pair)
+      {
+        // Both at once, into VS32.
+        XXPERMDI(VSR::VS35, VSR::VS35, VSR::VS35, 0);
+        DequantizePair(VSR::VS32, GPR::R3, GPR::R12, decoded.size, decoded.is_signed, VSR::VS35);
+      }
+      else
+      {
+        convert(VSR::VS33, GPR::R3);
+        convert(VSR::VS34, GPR::R12);
+      }
+    }
+  }
+
+  if (!decoded.is_float)
+  {
+    if (single)
+    {
+      // ps1 is 1.0.
+      LoadPowerOfTwo(VSR::VS34, GPR::R12, 0);
+    }
+    if (!integer_pair)
+      XXPERMDI(VSR::VS32, VSR::VS33, VSR::VS34, 0);
+    // Exactly.
+    ConvertDoublesToSingles(VSR::VS32, VSR::VS32);
+  }
+
+  LD(GPR::R0, GPR::SP, QUANTIZED_LR_SAVE);
+  MTLR(GPR::R0);
+  BLR();
+}
+
+void JitPPC64::GenerateQuantizedStoreRoutine(u32 type, bool single)
+{
+  const QuantizedType decoded = DecodeQuantizedType(static_cast<EQuantizeType>(type));
+  const bool integer_pair = !single && !decoded.is_float && m_isa_3_0;
+  if (!decoded.valid)
+  {
+    // As Helper_Quantize: nothing.
+    BLR();
+    return;
+  }
+
+  const u32 size = (single ? 1 : 2) * decoded.size / 8;
+  MFLR(GPR::R0);
+  STD(GPR::R0, GPR::SP, QUANTIZED_LR_SAVE);
+  STD(GPR::R3, GPR::SP, QUANTIZED_VALUE_SAVE);
+
+  // The value, in R4, with half 0 in the upper bits. With Power ISA 3.0, ps1 of floats goes to a
+  // GPR with mfvsrld, and integers are quantized both at once.
+  if (!single && !m_isa_3_0)
+    XXSWAPD(VSR::VS33, VSR::VS32);
+  if (decoded.is_float)
+  {
+    MFVSRD(GPR::R4, VSR::VS32);
+    ConvertDoubleToSingleFTZ(GPR::R4, GPR::R0, GPR::R12);
+    if (!single)
+    {
+      if (m_isa_3_0)
+        MFVSRLD(GPR::R3, VSR::VS32);
+      else
+        MFVSRD(GPR::R3, VSR::VS33);
+      ConvertDoubleToSingleFTZ(GPR::R3, GPR::R0, GPR::R12);
+    }
+  }
+  else
+  {
+    // The factor 2^scale, from the sign-extended 6-bit scale.
+    SLDI(GPR::R4, GPR::R4, 58);
+    SRADI(GPR::R4, GPR::R4, 58);
+    ADDI(GPR::R4, GPR::R4, 1023);
+    SLDI(GPR::R4, GPR::R4, 52);
+    MTVSRD(VSR::VS35, GPR::R4);
+    if (integer_pair)
+    {
+      XXPERMDI(VSR::VS35, VSR::VS35, VSR::VS35, 0);
+      QuantizePair(GPR::R4, GPR::R3, VSR::VS32, decoded.size, decoded.is_signed, VSR::VS35,
+                   VSR::VS34, VSR::VS33);
+    }
+    else
+    {
+      QuantizeHalf(GPR::R4, VSR::VS32, decoded.size, decoded.is_signed, VSR::VS35, VSR::VS34,
+                   GPR::R12);
+      if (!single)
+      {
+        QuantizeHalf(GPR::R3, VSR::VS33, decoded.size, decoded.is_signed, VSR::VS35, VSR::VS34,
+                     GPR::R12);
+      }
+    }
+  }
+  if (!single && !integer_pair)
+  {
+    CLRLDI(GPR::R3, GPR::R3, 64 - decoded.size);
+    SLDI(GPR::R4, GPR::R4, decoded.size);
+    OR(GPR::R4, GPR::R4, GPR::R3);
+  }
+  // The slow path takes the value zero-extended.
+  if (size < 8)
+    CLRLDI(GPR::R4, GPR::R4, 64 - size * 8);
+
+  LD(GPR::R3, GPR::SP, QUANTIZED_VALUE_SAVE);
+  const auto slow = EmitQuantizedRAMAddress(size);
+  switch (size)
+  {
+  case 8:
+    STDBRX(GPR::R4, GPR::R0, GPR::R12);
+    break;
+  case 4:
+    STWBRX(GPR::R4, GPR::R0, GPR::R12);
+    break;
+  case 2:
+    STHBRX(GPR::R4, GPR::R0, GPR::R12);
+    break;
+  default:
+    STBX(GPR::R4, GPR::R0, GPR::R12);
+    break;
+  }
+  const FixupBranch stored = B();
+  for (const FixupBranch& branch : slow)
+    SetJumpTarget(branch);
+  BL(Routine(m_slow_access_routines[SlowAccessRoutineIndex({.store = true, .size = size * 8})]));
+  SetJumpTarget(stored);
+
+  LD(GPR::R0, GPR::SP, QUANTIZED_LR_SAVE);
+  MTLR(GPR::R0);
+  BLR();
+}
diff --git a/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_Paired.cpp b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_Paired.cpp
new file mode 100644
index 0000000000..b01495f010
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_Paired.cpp
@@ -0,0 +1,444 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Paired-single instructions. The arithmetic works on both halves at once, held as singles (see
+// PPC64FPRCache), with the vector single precision instructions. With single operands, these
+// round as the interpreter's operations in double precision and rounding to single precision do:
+// double precision is wide enough for the result of one operation on singles to round to single
+// precision the same either way, a single frC needs no rounding to 25 bits, and the interpreter
+// corrects the ties of fused multiply-adds, which leaves the result that a single rounding gives.
+//
+// Operands held as doubles are converted, and checked to be singles; those that later paired single
+// instructions read too are then held as singles. The interpreter computes the rest, from far
+// code: operands that aren't singles, and results that it may compute differently, which are tiny:
+// FPSCR[NI] flushes a result that rounds up to the smallest normal single from below it, as well as
+// denormals, and a fused multiply-add rounded twice can come out differently for a denormal.
+
+#include "Core/PowerPC/JitPPC64/Jit.h"
+
+#include <algorithm>
+#include <array>
+#include <span>
+#include <vector>
+
+#include "Common/Assert.h"
+#include "Common/CommonTypes.h"
+#include "Common/PPC64Emitter.h"
+#include "Core/PowerPC/Gekko.h"
+#include "Core/PowerPC/Interpreter/Interpreter.h"
+#include "Core/PowerPC/PowerPC.h"
+
+using namespace PPC64Gen;
+
+void JitPPC64::BindPairedOperand(PairedOperand& operand, u32 preg)
+{
+  operand.preg = preg;
+  operand.single = fpr.HoldsSingles(preg);
+  operand.host = operand.single ? fpr.RSingle(preg) : fpr.R(preg);
+}
+
+bool JitPPC64::IsReadAgainAsSingles(u32 preg) const
+{
+  // By a later paired single instruction of the block, before another writes it.
+  for (int i = 1; i <= js.instructionsLeft; i++)
+  {
+    const PPCAnalyst::CodeOp& op = js.op[i];
+    if (op.skip)
+      continue;
+    if (op.fregsIn[preg] &&
+        (op.opinfo->type == OpType::PS || op.opinfo->type == OpType::StorePS))
+    {
+      return true;
+    }
+    if (op.fregOut == static_cast<s8>(preg))
+      return false;
+  }
+  return false;
+}
+
+void JitPPC64::GetPairedSingles(UGeckoInstruction inst, std::span<PairedOperand> operands,
+                                std::vector<FixupBranch>& not_singles)
+{
+  // Converted and back, the doubles are the same if they're singles; a signaling NaN is quieted,
+  // and left to the interpreter. Holding them as singles in the cache after needs the code after
+  // to run only if they are: then the branch for each goes to far code that interprets the
+  // instruction and leaves the block, with the cache as it is before any of them are.
+  bool keep = false;
+  for (const PairedOperand& operand : operands)
+    keep |= !operand.single && IsReadAgainAsSingles(operand.preg);
+
+  for (auto it = operands.begin(); it != operands.end(); ++it)
+  {
+    PairedOperand& operand = *it;
+    const auto same = std::find_if(operands.begin(), it, [&](const PairedOperand& other) {
+      return other.preg == operand.preg;
+    });
+    if (operand.single || same != it)
+    {
+      operand.reg = operand.single ? operand.host : same->reg;
+      continue;
+    }
+
+    operand.singles = fpr.GetScopedReg();
+    const auto check = fpr.GetScopedReg();
+    ConvertDoublesToSingles(operand.singles, operand.host);
+    XVCVSPDP(check, operand.singles);
+    VCMPEQUD(check, check, operand.host, true);
+    // CR6's LT is set if both doublewords are equal.
+    const FixupBranch not_single = BCFar(CCFlags::GE, CRF::CR6);
+    if (keep)
+    {
+      SwitchToFarCode();
+      SetJumpTarget(not_single);
+      InterpretAndExit(inst);
+      SwitchToNearCode();
+    }
+    else
+    {
+      not_singles.push_back(not_single);
+    }
+    operand.reg = operand.singles;
+  }
+
+  if (!keep)
+    return;
+  for (PairedOperand& operand : operands)
+  {
+    if (operand.single || fpr.HoldsSingles(operand.preg))
+      continue;
+    XXLMR(operand.host, operand.reg);
+    fpr.KeepAsSingles(operand.preg);
+  }
+}
+
+void JitPPC64::InterpretAndExit(UGeckoInstruction inst)
+{
+  // The guest registers are written back for the interpreter, and the block continues at the next
+  // instruction.
+  FlushRegisters(FlushMode::MaintainState);
+  MOVI2R(GPR::R12, js.compilerPC);
+  STW(GPR::R12, PPC_REG, PPCSTATE_OFF(pc));
+  ABI_CallFunction(Interpreter::GetInterpreterOp(inst), &m_system.GetInterpreter(), inst.hex);
+  WriteExit(js.compilerPC + 4);
+}
+
+FixupBranch JitPPC64::BranchIfTinySingles(VSR singles)
+{
+  // Whether a word's magnitude is a denormal or the smallest normal single, 0x00800000, but not 0:
+  // added to bias, 0 gives bias itself, and those give more, wrapping around from the magnitudes
+  // above them. Power ISA 3.0's xxspltib makes a bias of 0xFEFEFEFE, which also takes magnitudes up
+  // to 0x01010101, a little above 2^-125, to far code: rare, and computed there the same.
+  const auto magnitude = fpr.GetScopedReg();
+  const auto bias = fpr.GetScopedReg();
+  XVABSSP(magnitude, singles);
+  if (m_isa_3_1)
+  {
+    XXSPLTIW(bias, 0xFF7FFFFF);
+  }
+  else if (m_isa_3_0)
+  {
+    XXSPLTIB(bias, 0xFE);
+  }
+  else
+  {
+    // ~(1 << 23), shifting by the low 5 bits of -9.
+    const auto shift = fpr.GetScopedReg();
+    VSPLTISW(bias, 1);
+    VSPLTISW(shift, -9);
+    VSLW(bias, bias, shift);
+    XXLNOR(bias, bias, bias);
+  }
+  VADDUWM(magnitude, magnitude, bias);
+  VCMPGTUW(magnitude, magnitude, bias, true);
+  // CR6's EQ is set if no word is.
+  return BCFar(CCFlags::NE, CRF::CR6);
+}
+
+FixupBranch JitPPC64::EmitTinySinglesFallback(FixupBranch tiny, bool fma, const u8* resume)
+{
+  // Without NI, which is in CR4, the interpreter only computes a fused multiply-add differently.
+  SetJumpTarget(tiny);
+  if (!fma)
+  {
+    const FixupBranch ni = BC(CCFlags::NE, CRF::CR4);
+    B(resume);
+    SetJumpTarget(ni);
+  }
+  return B();
+}
+
+void JitPPC64::SetFPRFFromSingles(VSR singles)
+{
+  const auto ps0 = fpr.GetScopedReg();
+  XSCVSPDPN(ps0, singles);
+  SetFPRF(ps0, true);
+}
+
+void JitPPC64::ps_arith(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITPairedOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions || (jo.div_by_zero_exceptions && inst.SUBOP5 == 18));
+
+  // ps_muls0, ps_muls1, ps_madds0 and ps_madds1 are ps_mul and ps_madd, with one half of C for
+  // both halves.
+  u32 op5 = inst.SUBOP5;
+  int c_half = -1;
+  switch (op5)
+  {
+  case 12:  // ps_muls0
+  case 13:  // ps_muls1
+    c_half = op5 - 12;
+    op5 = 25;
+    break;
+  case 14:  // ps_madds0
+  case 15:  // ps_madds1
+    c_half = op5 - 14;
+    op5 = 29;
+    break;
+  default:
+    break;
+  }
+
+  const bool use_c = op5 >= 25;  // ps_mul and the fused multiply-adds
+  const bool use_b = op5 != 25;  // ps_mul doesn't use B
+  const bool fma = use_b && use_c;
+
+  // All guest registers are bound before the branches to far code, so that the cache is the same
+  // on every path.
+  std::array<PairedOperand, 3> operands;
+  size_t count = 0;
+  BindPairedOperand(operands[count++], inst.FA);
+  if (use_b)
+    BindPairedOperand(operands[count++], inst.FB);
+  if (use_c)
+    BindPairedOperand(operands[count++], inst.FC);
+  const VSR d = fpr.BindForSingles(inst.FD);
+  EnsureNILoaded();
+
+  std::vector<FixupBranch> interpret;
+  GetPairedSingles(inst, std::span(operands.data(), count), interpret);
+  const bool d_was_single = fpr.HoldsSingles(inst.FD);
+  FixupBranch tiny;
+  const u8* resume;
+  {
+    const VSR a_operand = operands[0].reg;
+    const VSR b_operand = use_b ? operands[1].reg : VSR::VS0;
+    VSR c_operand = use_c ? operands[count - 1].reg : VSR::VS0;
+
+    // C's half for both halves, for ps_muls0, ps_muls1, ps_madds0 and ps_madds1.
+    PPC64FPRCache::ScopedReg c_halves;
+    if (c_half >= 0)
+    {
+      c_halves = fpr.GetScopedReg();
+      XXSPLTW(c_halves, c_operand, 2 * c_half);
+      c_operand = c_halves;
+    }
+
+    const auto result = fpr.GetScopedReg();
+    switch (op5)
+    {
+    case 18:
+      XVDIVSP(result, a_operand, b_operand);
+      break;
+    case 20:
+      XVSUBSP(result, a_operand, b_operand);
+      break;
+    case 21:
+      XVADDSP(result, a_operand, b_operand);
+      break;
+    case 25:
+      XVMULSP(result, a_operand, c_operand);
+      break;
+    default:
+      // These compute result = a * c + result; the negated forms negate after rounding, except
+      // NaNs, as the guest's do.
+      XXLMR(result, b_operand);
+      switch (op5)
+      {
+      case 28:
+        XVMSUBASP(result, a_operand, c_operand);
+        break;
+      case 29:
+        XVMADDASP(result, a_operand, c_operand);
+        break;
+      case 30:
+        XVNMSUBASP(result, a_operand, c_operand);
+        break;
+      default:
+        XVNMADDASP(result, a_operand, c_operand);
+        break;
+      }
+      break;
+    }
+
+    tiny = BranchIfTinySingles(result);
+    resume = GetCodePtr();
+    XXLMR(d, result);
+    if (m_fprf && js.op->wantsFPRF)
+      SetFPRFFromSingles(result);
+  }
+  const u8* done = GetCodePtr();
+  fpr.MarkSingles(inst.FD, true);
+  // The far code calls the interpreter, which needs the scratch registers free.
+  for (PairedOperand& operand : operands)
+    operand.singles.Unlock();
+
+  SwitchToFarCode();
+  interpret.push_back(EmitTinySinglesFallback(tiny, fma, resume));
+  for (const FixupBranch& branch : interpret)
+    SetJumpTarget(branch);
+  InterpretFromFarCode(inst, done, d_was_single);
+  SwitchToNearCode();
+}
+
+void JitPPC64::ps_sumX(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITPairedOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions);
+
+  // ps_sum0: a.ps0 + b.ps1, c.ps1; ps_sum1: c.ps0, a.ps0 + b.ps1. Both halves are rounded to single
+  // precision, which leaves a single half of C as it is, unless NI flushes it, or it's a signaling
+  // NaN, which is quieted.
+  const bool sum1 = inst.SUBOP5 == 11;
+  std::array<PairedOperand, 3> operands;
+  BindPairedOperand(operands[0], inst.FA);
+  BindPairedOperand(operands[1], inst.FB);
+  BindPairedOperand(operands[2], inst.FC);
+  const VSR d = fpr.BindForSingles(inst.FD);
+  EnsureNILoaded();
+
+  std::vector<FixupBranch> interpret;
+  GetPairedSingles(inst, operands, interpret);
+  const bool d_was_single = fpr.HoldsSingles(inst.FD);
+  FixupBranch tiny;
+  const u8* resume;
+  {
+    const VSR a_operand = operands[0].reg;
+    const VSR b_operand = operands[1].reg;
+    VSR c_operand = operands[2].reg;
+    PPC64FPRCache::ScopedReg c_quiet;
+    if (operands[2].single && !fpr.IsQuiet(inst.FC))
+    {
+      // Converting to doubles and back quiets signaling NaNs, which converted doubles aren't.
+      c_quiet = fpr.GetScopedReg();
+      XVCVSPDP(c_quiet, c_operand);
+      ConvertDoublesToSingles(c_quiet, c_quiet);
+      c_operand = c_quiet;
+    }
+
+    // The sum in words 0 and 1, from b.ps1 rotated there.
+    const auto sum = fpr.GetScopedReg();
+    XXSLDWI(sum, b_operand, b_operand, 2);
+    XVADDSP(sum, a_operand, sum);
+    const auto result = fpr.GetScopedReg();
+    if (sum1)
+      XXPERMDI(result, c_operand, sum, 0);
+    else
+      XXPERMDI(result, sum, c_operand, 1);
+
+    tiny = BranchIfTinySingles(result);
+    resume = GetCodePtr();
+    XXLMR(d, result);
+    // Of the sum, as ps_sum0 sets it for ps0 and ps_sum1 for ps1.
+    if (m_fprf && js.op->wantsFPRF)
+      SetFPRFFromSingles(sum);
+  }
+  const u8* done = GetCodePtr();
+  fpr.MarkSingles(inst.FD, true);
+  // The far code calls the interpreter, which needs the scratch registers free.
+  for (PairedOperand& operand : operands)
+    operand.singles.Unlock();
+
+  SwitchToFarCode();
+  interpret.push_back(EmitTinySinglesFallback(tiny, false, resume));
+  for (const FixupBranch& branch : interpret)
+    SetJumpTarget(branch);
+  InterpretFromFarCode(inst, done, d_was_single);
+  SwitchToNearCode();
+}
+
+void JitPPC64::ps_sel(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITPairedOff);
+  INTERPRET_IF(inst.Rc);
+
+  // Each half is a >= -0.0 ? c : b, which is b if a is a NaN, as singles if all three are.
+  if (fpr.HoldsSingles(inst.FA) && fpr.HoldsSingles(inst.FB) && fpr.HoldsSingles(inst.FC))
+  {
+    const VSR a = fpr.RSingle(inst.FA);
+    const VSR b = fpr.RSingle(inst.FB);
+    const VSR c = fpr.RSingle(inst.FC);
+    const bool quiet = fpr.IsQuiet(inst.FB) && fpr.IsQuiet(inst.FC);
+    const VSR d = fpr.BindForSingles(inst.FD);
+
+    const auto mask = fpr.GetScopedReg();
+    XXLXOR(mask, mask, mask);
+    XVCMPGESP(mask, a, mask);
+    XXSEL(d, b, c, mask);
+    fpr.MarkSingles(inst.FD, quiet);
+    return;
+  }
+
+  const VSR a = fpr.R(inst.FA);
+  const VSR b = fpr.R(inst.FB);
+  const VSR c = fpr.R(inst.FC);
+  const VSR d = fpr.RW(inst.FD);
+
+  const auto mask = fpr.GetScopedReg();
+  XXLXOR(mask, mask, mask);
+  XVCMPGEDP(mask, a, mask);
+  XXSEL(d, b, c, mask);
+}
+
+void JitPPC64::ps_cmpXX(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITPairedOff);
+  FALLBACK_IF(jo.fp_exceptions);
+
+  // ps_cmpu0 and ps_cmpo0 compare ps0, ps_cmpu1 and ps_cmpo1 ps1.
+  const bool half1 = inst.SUBOP10 == 64 || inst.SUBOP10 == 96;
+  PPC64FPRCache::ScopedReg a_doubles, b_doubles;
+  const VSR a = fpr.RForArith(inst.FA, a_doubles);
+  const VSR b = fpr.RForArith(inst.FB, b_doubles);
+
+  if (half1)
+  {
+    const auto a1 = fpr.GetScopedReg();
+    const auto b1 = fpr.GetScopedReg();
+    XXSWAPD(a1, a);
+    XXSWAPD(b1, b);
+    XSCMPUDP(CRF::CR1, a1, b1);
+  }
+  else
+  {
+    XSCMPUDP(CRF::CR1, a, b);
+  }
+  // With FPRF, these set FPSCR[FPCC].
+  if (m_fprf)
+    SetFPCCFromHostFloatCompare(CRF::CR1);
+  SetCRFieldFromHostFloatCompare(inst.CRFD, CRF::CR1);
+}
+
+void JitPPC64::ps_res(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITPairedOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions);
+  EmitEstimate(inst, false, true);
+}
+
+void JitPPC64::ps_rsqrte(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITPairedOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions);
+  EmitEstimate(inst, true, true);
+}
diff --git a/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_RegCache.cpp b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_RegCache.cpp
new file mode 100644
index 0000000000..6a383369b2
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_RegCache.cpp
@@ -0,0 +1,415 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/PowerPC/JitPPC64/JitPPC64_RegCache.h"
+
+#include "Common/Assert.h"
+#include "Core/PowerPC/JitPPC64/Jit.h"
+
+using namespace PPC64Gen;
+
+namespace
+{
+constexpr u32 FIRST_GUEST_HOST_REG = 14;
+constexpr u32 LAST_GUEST_HOST_REG = 27;
+constexpr u32 FIRST_SCRATCH_REG = 5;
+constexpr u32 LAST_SCRATCH_REG = 11;
+
+constexpr u32 FIRST_GUEST_HOST_VSR = 52;
+constexpr u32 LAST_GUEST_HOST_VSR = 63;
+constexpr u32 FIRST_SCRATCH_VSR = 32;
+constexpr u32 LAST_SCRATCH_VSR = 47;
+}  // namespace
+
+void PPC64GPRCache::Init(JitPPC64* jit)
+{
+  m_jit = jit;
+  Start();
+}
+
+void PPC64GPRCache::Start()
+{
+  m_guest = {};
+  m_host_in_use = {};
+  m_instruction = 0;
+}
+
+void PPC64GPRCache::Load(GPR host, u32 preg)
+{
+  if (preg < CR_INDEX)
+    m_jit->LWZ(host, PPC_REG, PPCSTATE_OFF_GPR(preg));
+  else
+    m_jit->LD(host, PPC_REG, PPCSTATE_OFF_CR(preg - CR_INDEX));
+}
+
+void PPC64GPRCache::Store(GPR host, u32 preg)
+{
+  if (preg < CR_INDEX)
+    m_jit->STW(host, PPC_REG, PPCSTATE_OFF_GPR(preg));
+  else
+    m_jit->STD(host, PPC_REG, PPCSTATE_OFF_CR(preg - CR_INDEX));
+}
+
+GPR PPC64GPRCache::AllocateGuestHostReg()
+{
+  for (u32 i = FIRST_GUEST_HOST_REG; i <= LAST_GUEST_HOST_REG; i++)
+  {
+    if (!m_host_in_use[i])
+      return static_cast<GPR>(i);
+  }
+
+  // Evict the guest register that was used least recently, but not one that the current
+  // instruction uses.
+  u32 victim = static_cast<u32>(m_guest.size());
+  for (u32 preg = 0; preg < m_guest.size(); preg++)
+  {
+    const GuestReg& guest = m_guest[preg];
+    if (!guest.bound || guest.last_used == m_instruction)
+      continue;
+    if (victim == m_guest.size() || guest.last_used < m_guest[victim].last_used)
+      victim = preg;
+  }
+
+  ASSERT_MSG(DYNA_REC, victim != m_guest.size(), "Out of host registers for guest registers");
+  if (victim == m_guest.size())
+    return GPR::R0;
+
+  const GPR host = m_guest[victim].host;
+  Release(victim);
+  return host;
+}
+
+GPR PPC64GPRCache::Bind(u32 preg, bool load)
+{
+  GuestReg& guest = m_guest[preg];
+  guest.last_used = m_instruction;
+  if (guest.bound)
+    return guest.host;
+
+  const GPR host = AllocateGuestHostReg();
+  m_host_in_use[DecodeReg(host)] = true;
+  guest.bound = true;
+  guest.dirty = false;
+  guest.host = host;
+  if (load)
+    Load(host, preg);
+  return host;
+}
+
+GPR PPC64GPRCache::R(u32 preg)
+{
+  return Bind(preg, true);
+}
+
+GPR PPC64GPRCache::RW(u32 preg, bool load)
+{
+  const GPR host = Bind(preg, load);
+  m_guest[preg].dirty = true;
+  return host;
+}
+
+void PPC64GPRCache::Release(u32 preg)
+{
+  GuestReg& guest = m_guest[preg];
+  if (guest.dirty)
+    Store(guest.host, preg);
+  m_host_in_use[DecodeReg(guest.host)] = false;
+  guest = {};
+}
+
+void PPC64GPRCache::StoreIfDirty(u32 preg)
+{
+  GuestReg& guest = m_guest[preg];
+  if (!guest.bound || !guest.dirty)
+    return;
+  Store(guest.host, preg);
+  guest.dirty = false;
+}
+
+void PPC64GPRCache::Discard(u32 preg)
+{
+  GuestReg& guest = m_guest[preg];
+  if (!guest.bound)
+    return;
+  m_host_in_use[DecodeReg(guest.host)] = false;
+  guest = {};
+}
+
+void PPC64GPRCache::Flush(FlushMode mode)
+{
+  for (u32 preg = 0; preg < m_guest.size(); preg++)
+  {
+    const GuestReg& guest = m_guest[preg];
+    if (!guest.bound)
+      continue;
+
+    if (mode == FlushMode::All)
+      Release(preg);
+    else if (guest.dirty)
+      Store(guest.host, preg);
+  }
+}
+
+PPC64GPRCache::ScopedReg PPC64GPRCache::GetScopedReg()
+{
+  for (u32 i = FIRST_SCRATCH_REG; i <= LAST_SCRATCH_REG; i++)
+  {
+    if (m_host_in_use[i])
+      continue;
+
+    m_host_in_use[i] = true;
+    return ScopedReg(this, static_cast<GPR>(i));
+  }
+
+  ASSERT_MSG(DYNA_REC, false, "Out of scratch registers");
+  return {};
+}
+
+BitSet32 PPC64GPRCache::GetScratchRegsInUse() const
+{
+  BitSet32 scratch{};
+  for (u32 i = FIRST_SCRATCH_REG; i <= LAST_SCRATCH_REG; i++)
+    scratch[i] = true;
+  return m_host_in_use & scratch;
+}
+
+void PPC64GPRCache::UnlockReg(GPR reg)
+{
+  ASSERT(m_host_in_use[DecodeReg(reg)]);
+  m_host_in_use[DecodeReg(reg)] = false;
+}
+
+void PPC64FPRCache::Init(JitPPC64* jit)
+{
+  m_jit = jit;
+  Start();
+}
+
+void PPC64FPRCache::Start()
+{
+  m_guest = {};
+  m_host_in_use = 0;
+  m_scratch_in_use = 0;
+  m_instruction = 0;
+}
+
+void PPC64FPRCache::Load(VSR host, u32 preg)
+{
+  // R0 isn't allocated, so it's free here.
+  m_jit->LI(GPR::R0, PPCSTATE_OFF_PS(preg));
+  m_jit->LXVD2X(host, PPC_REG, GPR::R0);
+}
+
+void PPC64FPRCache::Store(VSR host, u32 preg, bool single, bool quiet)
+{
+  if (single)
+  {
+    // Converted in VS1, which isn't allocated: loads leave their value in VS0 while they bind FD.
+    m_jit->ConvertSinglesToDoubles(VSR::VS1, host, quiet);
+    host = VSR::VS1;
+  }
+  m_jit->LI(GPR::R0, PPCSTATE_OFF_PS(preg));
+  m_jit->STXVD2X(host, PPC_REG, GPR::R0);
+}
+
+VSR PPC64FPRCache::AllocateGuestHostReg()
+{
+  for (u32 i = FIRST_GUEST_HOST_VSR; i <= LAST_GUEST_HOST_VSR; i++)
+  {
+    if (!(m_host_in_use & (u64{1} << i)))
+      return static_cast<VSR>(i);
+  }
+
+  // Evict the guest register that was used least recently, but not one that the current
+  // instruction uses.
+  u32 victim = static_cast<u32>(m_guest.size());
+  for (u32 preg = 0; preg < m_guest.size(); preg++)
+  {
+    const GuestReg& guest = m_guest[preg];
+    if (!guest.bound || guest.last_used == m_instruction)
+      continue;
+    if (victim == m_guest.size() || guest.last_used < m_guest[victim].last_used)
+      victim = preg;
+  }
+
+  ASSERT_MSG(DYNA_REC, victim != m_guest.size(), "Out of host registers for guest FPRs");
+  if (victim == m_guest.size())
+    return VSR::VS0;
+
+  const VSR host = m_guest[victim].host;
+  Release(victim);
+  return host;
+}
+
+VSR PPC64FPRCache::Bind(u32 preg, bool load)
+{
+  GuestReg& guest = m_guest[preg];
+  guest.last_used = m_instruction;
+  if (guest.bound)
+    return guest.host;
+
+  const VSR host = AllocateGuestHostReg();
+  m_host_in_use |= u64{1} << DecodeReg(host);
+  guest.bound = true;
+  guest.dirty = false;
+  guest.single = false;
+  guest.quiet = false;
+  guest.host = host;
+  if (load)
+    Load(host, preg);
+  return host;
+}
+
+VSR PPC64FPRCache::R(u32 preg)
+{
+  const VSR host = Bind(preg, true);
+  GuestReg& guest = m_guest[preg];
+  if (guest.single)
+  {
+    m_jit->ConvertSinglesToDoubles(host, host, guest.quiet);
+    guest.single = false;
+  }
+  return host;
+}
+
+VSR PPC64FPRCache::RForArith(u32 preg, ScopedReg& tmp)
+{
+  const VSR host = Bind(preg, true);
+  if (!m_guest[preg].single)
+    return host;
+  tmp = GetScopedReg();
+  m_jit->XVCVSPDP(tmp, host);
+  return tmp;
+}
+
+VSR PPC64FPRCache::RW(u32 preg, bool load)
+{
+  const VSR host = load ? R(preg) : Bind(preg, false);
+  GuestReg& guest = m_guest[preg];
+  guest.dirty = true;
+  guest.single = false;
+  return host;
+}
+
+VSR PPC64FPRCache::RSingle(u32 preg)
+{
+  ASSERT(HoldsSingles(preg));
+  m_guest[preg].last_used = m_instruction;
+  return m_guest[preg].host;
+}
+
+VSR PPC64FPRCache::BindForSingles(u32 preg)
+{
+  // Not loaded: an instruction that reads preg has done so already.
+  return Bind(preg, false);
+}
+
+void PPC64FPRCache::MarkSingles(u32 preg, bool quiet)
+{
+  GuestReg& guest = m_guest[preg];
+  ASSERT(guest.bound);
+  guest.dirty = true;
+  guest.single = true;
+  guest.quiet = quiet;
+}
+
+void PPC64FPRCache::KeepAsSingles(u32 preg)
+{
+  GuestReg& guest = m_guest[preg];
+  ASSERT(guest.bound && !guest.single);
+  guest.single = true;
+  guest.quiet = true;
+}
+
+void PPC64FPRCache::Release(u32 preg)
+{
+  GuestReg& guest = m_guest[preg];
+  if (guest.dirty)
+    Store(guest.host, preg, guest.single, guest.quiet);
+  m_host_in_use &= ~(u64{1} << DecodeReg(guest.host));
+  guest = {};
+}
+
+void PPC64FPRCache::StoreIfDirty(u32 preg)
+{
+  GuestReg& guest = m_guest[preg];
+  if (!guest.bound || !guest.dirty)
+    return;
+  Store(guest.host, preg, guest.single, guest.quiet);
+  guest.dirty = false;
+}
+
+void PPC64FPRCache::EmitStoreValue(u32 preg)
+{
+  const GuestReg& guest = m_guest[preg];
+  if (guest.bound)
+    Store(guest.host, preg, guest.single, guest.quiet);
+}
+
+void PPC64FPRCache::EmitStoreValue(u32 preg, bool single)
+{
+  // Whether singles from before the instruction were quiet isn't known.
+  const GuestReg& guest = m_guest[preg];
+  if (guest.bound)
+    Store(guest.host, preg, single, false);
+}
+
+void PPC64FPRCache::EmitLoadValue(u32 preg)
+{
+  const GuestReg& guest = m_guest[preg];
+  if (!guest.bound)
+    return;
+  Load(guest.host, preg);
+  if (guest.single)
+  {
+    ASSERT(guest.quiet);
+    m_jit->ConvertDoublesToSingles(guest.host, guest.host);
+  }
+}
+
+void PPC64FPRCache::Discard(u32 preg)
+{
+  GuestReg& guest = m_guest[preg];
+  if (!guest.bound)
+    return;
+  m_host_in_use &= ~(u64{1} << DecodeReg(guest.host));
+  guest = {};
+}
+
+void PPC64FPRCache::Flush(FlushMode mode)
+{
+  for (u32 preg = 0; preg < m_guest.size(); preg++)
+  {
+    const GuestReg& guest = m_guest[preg];
+    if (!guest.bound)
+      continue;
+
+    if (mode == FlushMode::All)
+      Release(preg);
+    else if (guest.dirty)
+      Store(guest.host, preg, guest.single, guest.quiet);
+  }
+}
+
+PPC64FPRCache::ScopedReg PPC64FPRCache::GetScopedReg()
+{
+  for (u32 i = FIRST_SCRATCH_VSR; i <= LAST_SCRATCH_VSR; i++)
+  {
+    const u32 bit = 1u << (i - FIRST_SCRATCH_VSR);
+    if (m_scratch_in_use & bit)
+      continue;
+
+    m_scratch_in_use |= bit;
+    return ScopedReg(this, static_cast<VSR>(i));
+  }
+
+  ASSERT_MSG(DYNA_REC, false, "Out of scratch VSX registers");
+  return {};
+}
+
+void PPC64FPRCache::UnlockReg(VSR reg)
+{
+  const u32 bit = 1u << (DecodeReg(reg) - FIRST_SCRATCH_VSR);
+  ASSERT(m_scratch_in_use & bit);
+  m_scratch_in_use &= ~bit;
+}
diff --git a/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_RegCache.h b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_RegCache.h
new file mode 100644
index 0000000000..12448501e4
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_RegCache.h
@@ -0,0 +1,233 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <utility>
+
+#include "Common/BitSet.h"
+#include "Common/CommonTypes.h"
+#include "Common/PPC64Emitter.h"
+
+class JitPPC64;
+
+enum class FlushMode
+{
+  // Writes back the guest registers that were written, and releases all of them.
+  All,
+  // Writes back the guest registers that were written, but leaves the cache as it was, for a
+  // conditional exit: the code that doesn't exit continues with the same cache.
+  MaintainState,
+};
+
+// Gives instructions host registers for guest GPRs and CR fields, and scratch registers.
+//
+// Guest registers live in the non-volatile registers R14-R27, so that they survive calls. A host
+// register holds a guest GPR's value in its low 32 bits; the upper 32 bits are undefined. It holds
+// a CR field as a PowerPCState::cr.fields entry does, in all 64 bits.
+//
+// A guest register is loaded when an instruction first uses it, and stays in its host register
+// until it is flushed, or evicted to make room. Instructions must get all their guest registers
+// before they branch, so that the cache is in the same state on every path through them. Code
+// that leaves the block or calls into C++ code which uses PowerPCState must flush first.
+class PPC64GPRCache
+{
+public:
+  class ScopedReg
+  {
+  public:
+    ScopedReg() = default;
+    ScopedReg(PPC64GPRCache* cache, PPC64Gen::GPR reg) : m_cache(cache), m_reg(reg) {}
+    ScopedReg(const ScopedReg&) = delete;
+    ScopedReg& operator=(const ScopedReg&) = delete;
+    ScopedReg(ScopedReg&& other) noexcept { *this = std::move(other); }
+    ScopedReg& operator=(ScopedReg&& other) noexcept
+    {
+      Unlock();
+      m_cache = std::exchange(other.m_cache, nullptr);
+      m_reg = other.m_reg;
+      return *this;
+    }
+    ~ScopedReg() { Unlock(); }
+
+    operator PPC64Gen::GPR() const { return m_reg; }
+    void Unlock()
+    {
+      if (m_cache)
+        std::exchange(m_cache, nullptr)->UnlockReg(m_reg);
+    }
+
+  private:
+    PPC64GPRCache* m_cache = nullptr;
+    PPC64Gen::GPR m_reg = PPC64Gen::GPR::R0;
+  };
+
+  void Init(JitPPC64* jit);
+  // Starts a block, with no guest registers in host registers.
+  void Start();
+  // Starts an instruction: the guest registers that it gets can't be evicted until the next one.
+  void NextInstruction() { m_instruction++; }
+
+  // Returns a host register holding guest register preg.
+  PPC64Gen::GPR R(u32 preg);
+  // Returns a host register for writing guest register preg. If load, it holds the current value
+  // first, for instructions that also read it.
+  PPC64Gen::GPR RW(u32 preg, bool load = false);
+
+  // The same for CR field field.
+  PPC64Gen::GPR CR(u32 field) { return R(CR_INDEX + field); }
+  PPC64Gen::GPR CRW(u32 field, bool load = false) { return RW(CR_INDEX + field, load); }
+
+  void Flush(FlushMode mode);
+  // Writes guest register preg back if it was written, keeping it in its host register.
+  void StoreIfDirty(u32 preg);
+  // Forgets guest register preg without writing it back, after C++ code wrote it in
+  // PowerPCState.
+  void Discard(u32 preg);
+  void StoreCRIfDirty(u32 field) { StoreIfDirty(CR_INDEX + field); }
+  void DiscardCR(u32 field) { Discard(CR_INDEX + field); }
+
+  // Scratch registers, from the volatile registers R5-R11.
+  ScopedReg GetScopedReg();
+  BitSet32 GetScratchRegsInUse() const;
+
+private:
+  // The guest registers are GPRs 0-31, then CR fields 0-7 from CR_INDEX.
+  static constexpr u32 CR_INDEX = 32;
+
+  struct GuestReg
+  {
+    bool bound = false;
+    bool dirty = false;
+    PPC64Gen::GPR host = PPC64Gen::GPR::R0;
+    u32 last_used = 0;
+  };
+
+  PPC64Gen::GPR Bind(u32 preg, bool load);
+  PPC64Gen::GPR AllocateGuestHostReg();
+  void Release(u32 preg);
+  void Load(PPC64Gen::GPR host, u32 preg);
+  void Store(PPC64Gen::GPR host, u32 preg);
+  void UnlockReg(PPC64Gen::GPR reg);
+
+  JitPPC64* m_jit = nullptr;
+  std::array<GuestReg, CR_INDEX + 8> m_guest{};
+  BitSet32 m_host_in_use{};
+  u32 m_instruction = 0;
+};
+
+// Gives instructions host registers for guest FPRs, and scratch registers, as PPC64GPRCache does
+// for GPRs.
+//
+// A host register holds both halves of a guest register, as a PowerPCState::ps entry does:
+// doubleword 0, which scalar VSX instructions work on, holds ps0, and doubleword 1 holds ps1.
+// Paired single instructions and quantized loads can also hold guest registers as singles, which
+// the vector single precision instructions work on: ps0 in words 0 and 1, and ps1 in words 2 and 3,
+// as xvcvdpsp leaves them. Each half is a single then, which stands for the double that it
+// converts to exactly, and is converted to doubles for PowerPCState and for the instructions that
+// want doubles.
+// Guest registers live in V20-V31 (VS52-VS63), whose 128 bits are all non-volatile.
+class PPC64FPRCache
+{
+public:
+  class ScopedReg
+  {
+  public:
+    ScopedReg() = default;
+    ScopedReg(PPC64FPRCache* cache, PPC64Gen::VSR reg) : m_cache(cache), m_reg(reg) {}
+    ScopedReg(const ScopedReg&) = delete;
+    ScopedReg& operator=(const ScopedReg&) = delete;
+    ScopedReg(ScopedReg&& other) noexcept { *this = std::move(other); }
+    ScopedReg& operator=(ScopedReg&& other) noexcept
+    {
+      Unlock();
+      m_cache = std::exchange(other.m_cache, nullptr);
+      m_reg = other.m_reg;
+      return *this;
+    }
+    ~ScopedReg() { Unlock(); }
+
+    operator PPC64Gen::VSR() const { return m_reg; }
+    void Unlock()
+    {
+      if (m_cache)
+        std::exchange(m_cache, nullptr)->UnlockReg(m_reg);
+    }
+
+  private:
+    PPC64FPRCache* m_cache = nullptr;
+    PPC64Gen::VSR m_reg = PPC64Gen::VSR::VS0;
+  };
+
+  void Init(JitPPC64* jit);
+  void Start();
+  void NextInstruction() { m_instruction++; }
+
+  // Returns a host register holding guest register preg as doubles. Singles are converted, in
+  // the host register.
+  PPC64Gen::VSR R(u32 preg);
+  // As R, for instructions that only compute with the value: singles are converted into tmp
+  // instead, which quiets signaling NaNs, as computing with them does anyway.
+  PPC64Gen::VSR RForArith(u32 preg, ScopedReg& tmp);
+  // Returns a host register for writing guest register preg as doubles. If load, it holds the
+  // current value first, for instructions that write only one half, or also read it.
+  PPC64Gen::VSR RW(u32 preg, bool load = false);
+
+  // Whether guest register preg is in a host register as singles; RSingle returns it then.
+  bool HoldsSingles(u32 preg) const { return m_guest[preg].bound && m_guest[preg].single; }
+  PPC64Gen::VSR RSingle(u32 preg);
+  // Whether the singles of guest register preg can't be signaling NaNs, as for the results of
+  // arithmetic: xvcvspdp converts those exactly.
+  bool IsQuiet(u32 preg) const { return m_guest[preg].quiet; }
+  // Returns a host register for writing guest register preg, which the instruction then writes as
+  // singles with MarkSingles. Until then, the host register holds what it held before, as it did,
+  // so that far code can still store guest register preg if the instruction reads it.
+  PPC64Gen::VSR BindForSingles(u32 preg);
+  void MarkSingles(u32 preg, bool quiet);
+  // Guest register preg, which was held as doubles, has been converted to singles in its host
+  // register, having been checked to be singles, which aren't signaling NaNs.
+  void KeepAsSingles(u32 preg);
+
+  void Flush(FlushMode mode);
+  // Writes guest register preg back if it was written, keeping it in its host register.
+  void StoreIfDirty(u32 preg);
+  // Forgets guest register preg without writing it back, after C++ code wrote it in
+  // PowerPCState.
+  void Discard(u32 preg);
+  // For far code, which mustn't change the cache's state: write guest register preg to
+  // PowerPCState, or load it again from there, if it's in a host register. single says whether
+  // the host register holds it as singles, for an instruction that changed that.
+  void EmitStoreValue(u32 preg);
+  void EmitStoreValue(u32 preg, bool single);
+  void EmitLoadValue(u32 preg);
+
+  // Scratch registers, from the volatile registers V0-V15 (VS32-VS47).
+  ScopedReg GetScopedReg();
+  bool AnyScratchRegsInUse() const { return m_scratch_in_use != 0; }
+
+private:
+  struct GuestReg
+  {
+    bool bound = false;
+    bool dirty = false;
+    // Held as singles, and if so, whether they can't be signaling NaNs.
+    bool single = false;
+    bool quiet = false;
+    PPC64Gen::VSR host = PPC64Gen::VSR::VS0;
+    u32 last_used = 0;
+  };
+
+  PPC64Gen::VSR Bind(u32 preg, bool load);
+  PPC64Gen::VSR AllocateGuestHostReg();
+  void Release(u32 preg);
+  void Load(PPC64Gen::VSR host, u32 preg);
+  void Store(PPC64Gen::VSR host, u32 preg, bool single, bool quiet);
+  void UnlockReg(PPC64Gen::VSR reg);
+
+  JitPPC64* m_jit = nullptr;
+  std::array<GuestReg, 32> m_guest{};
+  u64 m_host_in_use = 0;
+  u32 m_scratch_in_use = 0;
+  u32 m_instruction = 0;
+};
