diff --git a/Source/UnitTests/Common/FPURoundModeTest.cpp b/Source/UnitTests/Common/FPURoundModeTest.cpp
new file mode 100644
index 0000000000..c989d5bf88
--- /dev/null
+++ b/Source/UnitTests/Common/FPURoundModeTest.cpp
@@ -0,0 +1,71 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <bit>
+
+#include <gtest/gtest.h>
+
+#include "Common/CPUDetect.h"
+#include "Common/CommonTypes.h"
+#include "Common/FPURoundMode.h"
+
+namespace
+{
+// Volatile, so the compiler can neither fold the arithmetic nor move it across SetSIMDMode.
+volatile double one = 1.0;
+volatile double tiny = 0x1p-60;
+volatile double smallest_normal = 0x1p-1022;
+volatile double half = 0.5;
+
+class FPURoundModeTest : public testing::Test
+{
+protected:
+  void SetUp() override
+  {
+#ifdef _M_GENERIC
+    GTEST_SKIP() << "Generic builds don't control the host FPU.";
+#endif
+  }
+
+  void TearDown() override { Common::FPU::LoadDefaultSIMDState(); }
+};
+}  // namespace
+
+TEST_F(FPURoundModeTest, RoundingMode)
+{
+  struct Case
+  {
+    Common::FPU::RoundMode mode;
+    double plus;   // 1 + 2^-60
+    double minus;  // -1 - 2^-60
+  };
+  constexpr Case cases[] = {
+      {Common::FPU::ROUND_NEAR, 1.0, -1.0},
+      {Common::FPU::ROUND_CHOP, 1.0, -1.0},
+      {Common::FPU::ROUND_UP, 1.0 + 0x1p-52, -1.0},
+      {Common::FPU::ROUND_DOWN, 1.0, -1.0 - 0x1p-52},
+  };
+
+  for (const Case& c : cases)
+  {
+    Common::FPU::SetSIMDMode(c.mode, false);
+    EXPECT_EQ(c.plus, one + tiny) << "mode " << c.mode;
+    EXPECT_EQ(c.minus, -one - tiny) << "mode " << c.mode;
+  }
+}
+
+TEST_F(FPURoundModeTest, NonIEEEMode)
+{
+  // The GC/Wii CPU's non-IEEE mode flushes denormal outputs to zero. Only hosts that report
+  // bFlushToZero do that in hardware; on other hosts the interpreter flushes in software, so the
+  // host FPU must keep producing denormals.
+  Common::FPU::SetSIMDMode(Common::FPU::ROUND_NEAR, true);
+  const u64 result = std::bit_cast<u64>(smallest_normal * half);
+  if (cpu_info.bFlushToZero)
+    EXPECT_EQ(0u, result);
+  else
+    EXPECT_EQ(0x0008000000000000u, result);
+
+  Common::FPU::SetSIMDMode(Common::FPU::ROUND_NEAR, false);
+  EXPECT_EQ(0x0008000000000000u, std::bit_cast<u64>(smallest_normal * half));
+}
diff --git a/Source/UnitTests/Common/HashTest.cpp b/Source/UnitTests/Common/HashTest.cpp
new file mode 100644
index 0000000000..c809177340
--- /dev/null
+++ b/Source/UnitTests/Common/HashTest.cpp
@@ -0,0 +1,150 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+#include "Common/CommonTypes.h"
+#include "Common/Hash.h"
+
+namespace
+{
+std::vector<u8> RandomBytes(size_t size)
+{
+  std::mt19937 rng(1);
+  std::vector<u8> bytes(size);
+  for (u8& byte : bytes)
+    byte = static_cast<u8>(rng());
+  return bytes;
+}
+}  // namespace
+
+TEST(Hash, GetHash64DetectsEachBitFlip)
+{
+  // Hashing all of the data, any change to it changes the hash.
+  for (const u32 len : {1u, 7u, 8u, 15u, 16u, 31u, 64u, 255u, 256u})
+  {
+    std::vector<u8> data = RandomBytes(len);
+    const u64 hash = Common::GetHash64(data.data(), len, 0);
+    EXPECT_EQ(hash, Common::GetHash64(data.data(), len, 0));
+    for (u32 bit = 0; bit < len * 8; bit++)
+    {
+      data[bit / 8] ^= 1 << (bit % 8);
+      EXPECT_NE(hash, Common::GetHash64(data.data(), len, 0)) << "len " << len << " bit " << bit;
+      data[bit / 8] ^= 1 << (bit % 8);
+    }
+  }
+}
+
+#if defined(_M_PPC_64) && defined(__CRYPTO__)
+
+namespace
+{
+// A portable version of GetHash64_PPC64_VPMSUM.
+struct U128
+{
+  u64 lo;
+  u64 hi;
+};
+
+U128 CarrylessMultiply(u64 a, u64 b)
+{
+  U128 result{};
+  for (int i = 0; i < 64; i++)
+  {
+    if ((b >> i) & 1)
+    {
+      result.lo ^= a << i;
+      result.hi ^= i == 0 ? 0 : a >> (64 - i);
+    }
+  }
+  return result;
+}
+
+U128 Fold(U128 a, U128 b)
+{
+  const U128 low = CarrylessMultiply(a.lo, 0x05f5c3c7eb52fab6);
+  const U128 high = CarrylessMultiply(a.hi, 0x4eb938a7d257740e);
+  return {low.lo ^ high.lo ^ b.lo, low.hi ^ high.hi ^ b.hi};
+}
+
+U128 Block(const u8* data)
+{
+  U128 block;
+  std::memcpy(&block.lo, data, 8);
+  std::memcpy(&block.hi, data + 8, 8);
+  return block;
+}
+
+u64 Mix(u64 k)
+{
+  k ^= k >> 33;
+  k *= 0xff51afd7ed558ccd;
+  k ^= k >> 33;
+  k *= 0xc4ceb9fe1a85ec53;
+  k ^= k >> 33;
+  return k;
+}
+
+u64 ReferenceHash64(const u8* src, u32 len, u32 samples)
+{
+  const u32 nblocks = len / 16;
+  u32 step = len / 8;
+  if (samples == 0)
+    samples = std::max(step, 1u);
+  step = std::max(step / samples, 1u);
+
+  std::array<U128, 4> h{{{len, 0}, {0, 0}, {0, 0}, {0, 0}}};
+  u32 i = 0;
+  if (nblocks > step * 3)
+  {
+    for (; i < nblocks - step * 3; i += step * 4)
+    {
+      for (u32 j = 0; j < 4; j++)
+        h[j] = Fold(h[j], Block(src + 16 * (i + step * j)));
+    }
+  }
+  for (; i < nblocks; i += step)
+    h[0] = Fold(h[0], Block(src + 16 * i));
+
+  if (len & 15)
+  {
+    std::array<u8, 16> tail{};
+    std::memcpy(tail.data(), src + nblocks * 16, len & 15);
+    h[1] = Fold(h[1], Block(tail.data()));
+  }
+
+  const U128 result = Fold(Fold(Fold(h[0], h[1]), h[2]), h[3]);
+  return Mix(result.lo ^ Mix(result.hi));
+}
+}  // namespace
+
+TEST(Hash, GetHash64PPC64MatchesReference)
+{
+  const std::vector<u8> data = RandomBytes(65536 + 16);
+  for (const u32 samples : {0u, 1u, 3u, 128u, 512u})
+  {
+    for (u32 len = 0; len < 600; len++)
+    {
+      for (u32 offset = 0; offset < 3; offset++)
+      {
+        EXPECT_EQ(ReferenceHash64(data.data() + offset, len, samples),
+                  Common::GetHash64(data.data() + offset, len, samples))
+            << "len " << len << " samples " << samples << " offset " << offset;
+      }
+    }
+    for (const u32 len : {4096u, 4100u, 65536u})
+    {
+      EXPECT_EQ(ReferenceHash64(data.data() + 1, len, samples),
+                Common::GetHash64(data.data() + 1, len, samples))
+          << "len " << len << " samples " << samples;
+    }
+  }
+}
+
+#endif
