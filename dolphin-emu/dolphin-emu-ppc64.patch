+      out[0] = X(63, Reg(), 0, Reg(), xo[R() % 7], 0);
+      return 1;
+    }
+    case 2:
+    case 3:
+    {
+      const u32 crf = R() % 8;
+      out[0] = X(63, crf << 2, Reg(), Reg(), (R() & 1) ? 32 : 0, 0);
