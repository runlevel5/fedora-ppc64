+  void SRWI(GPR ra, GPR rs, u32 n) { RLWINM(ra, rs, (32 - n) & 31, n, 31); }
+  void ROTLWI(GPR ra, GPR rs, u32 n) { RLWINM(ra, rs, n, 0, 31); }
+  void CLRLWI(GPR ra, GPR rs, u32 n) { RLWINM(ra, rs, 0, n, 31); }
