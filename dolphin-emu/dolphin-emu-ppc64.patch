+TEST(PPC64Emitter, BDNZLoop)
+{
+  TestCode code;
+  code.Emit([&] {
+    code.MTCTR(R3);
+    code.LI(R4, 0);
+    const u8* loop = code.GetCodePtr();
+    code.ADDI(R4, R4, 3);
+    const FixupBranch back = code.BDNZ();
+    code.SetJumpTarget(back, loop);
+    code.MR(R3, R4);
+    code.BLR();
+  });
+  EXPECT_EQ(30u, code.Call<u64>(u64(10)));
+  EXPECT_EQ(3u, code.Call<u64>(u64(1)));
