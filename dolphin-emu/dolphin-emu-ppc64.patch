+    for (int i = 0; i < ITERATIONS; i++)
+    {
+      BeginIteration();
+      const double a = FloatValue(), b = FloatValue(), c = FloatValue();
+      FOP("fadd %0,%4,%5");
+      FOP("fadd. %0,%4,%5");
+      FOP("fsub %0,%4,%5");
+      FOP("fmul %0,%4,%6");
+      FOP("fmul. %0,%4,%6");
+      FOP("fdiv %0,%4,%5");
+      FOP("fdiv. %0,%4,%5");
+      FOP("fadds %0,%4,%5");
+      FOP("fsubs %0,%4,%5");
+      FOP("fmuls %0,%4,%6");
+      FOP("fdivs %0,%4,%5");
+      FOP("fmadd %0,%4,%6,%5");
+      FOP("fmsub %0,%4,%6,%5");
