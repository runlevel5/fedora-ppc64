+      }
+      return 1;
+    }
+    case 4:
+      out[0] = (63u << 26) | (7 << 23) | ((R() % 8) << 12) | (134 << 1);  // mtfsfi 7
+      return 1;
+    default:
+      out[0] = X(63, 29 + R() % 3, 0, 0, (R() & 1) ? 38 : 70, 0);  // mtfsb1, mtfsb0
+      return 1;
+    }
+  }
