+    u32 xer;
+    asm volatile("mtxer %2\n\tmcrxr 3\n\tmfcr %0\n\tmfxer %1"
+                 : "=&r"(cr), "=r"(xer)
+                 : "r"(Random() & 0xE000007F)
+                 : "cr3", "xer");
+    Record("mcrxr", cr & 0x000F0000, xer, 0);
