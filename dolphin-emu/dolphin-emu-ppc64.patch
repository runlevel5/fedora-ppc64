+void PPC64XEmitter::ADDPCIS(GPR rt, s16 d)
+{
+  // DX-form: d0, d1 and d2 are the upper 10 bits, the next 5 and the lowest of d.
+  const u32 bits = static_cast<u16>(d);
+  Write32((19u << 26) | (DecodeReg(rt) << 21) | (((bits >> 1) & 0x1F) << 16) | ((bits >> 6) << 6) |
+          (2u << 1) | (bits & 1));
+}
