+#define CMP(insn)                                                                                  \
+  do                                                                                               \
+  {                                                                                                \
+    u32 c_;                                                                                        \
+    asm volatile("mtcrf 0xff,%3\n\tmtxer %4\n\t" insn "\n\tmfcr %0"                                \
