+  const GPR a = gpr.R(inst.RA);
+  const GPR b = gpr.R(inst.RB);
+  const GPR d = gpr.RW(inst.RD);
+  MULHW(d, a, b);
+  if (inst.Rc)
+    ComputeRC0(d);
+}
+
+void JitPPC64::mulhwux(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
