+{
+// The stack frame of the JIT, below the minimal ELFv2 frame header. The parameter save area isn't
+// needed by the functions the JIT calls, but costs nothing.
+constexpr s32 PARAMETER_SAVE_AREA = STACK_FRAME_MIN_SIZE;
+static_assert(JitPPC64::SCRATCH_SAVE == PARAMETER_SAVE_AREA + 8 * 8);
+constexpr s32 TOC_SAVE = JitPPC64::QUANTIZED_VALUE_SAVE + 8;
+// The non-volatile registers of the ELFv2 ABI: r14-r31, f14-f31 and v20-v31.
+constexpr u32 FIRST_SAVED_GPR = 14;
+constexpr u32 FIRST_SAVED_FPR = 14;
+constexpr u32 FIRST_SAVED_VR = 20;
+constexpr s32 GPR_SAVE = TOC_SAVE + 8;
+constexpr s32 FPR_SAVE = GPR_SAVE + 8 * (32 - FIRST_SAVED_GPR);
+constexpr s32 VR_SAVE = (FPR_SAVE + 8 * (32 - FIRST_SAVED_FPR) + 15) & ~15;
+constexpr s32 FRAME_SIZE = VR_SAVE + 16 * (32 - FIRST_SAVED_VR);
+static_assert(FRAME_SIZE % 16 == 0, "The stack pointer must stay 16-byte aligned");
+
+// CR2-CR4 are non-volatile.
+constexpr u32 SAVED_CR_FIELDS = 0x38;
+// The CR save word, in the caller's frame.
+constexpr s32 CR_SAVE = 8;
+}  // namespace
+
+void JitPPC64::GenerateAsm()
+{
+  const Common::ScopedJITPageWriteAndNoExecute enable_jit_page_writes;
+
+  const bool enable_debugging = Config::IsDebuggingEnabled();
+  auto& cpu = m_system.GetCPU();
+
+  enter_code = GetCodePtr();
+
+  // Prologue: save LR, CR and all non-volatile registers, and the TOC pointer for our caller.
+  MFLR(GPR::R0);
+  STD(GPR::R0, GPR::SP, STACK_FRAME_LR_SAVE);
+  MFCR(GPR::R0);
+  STW(GPR::R0, GPR::SP, CR_SAVE);
+  STDU(GPR::SP, GPR::SP, -FRAME_SIZE);
+  STD(GPR::TOC, GPR::SP, TOC_SAVE);
+  for (u32 i = FIRST_SAVED_GPR; i < 32; i++)
+    STD(static_cast<GPR>(i), GPR::SP, GPR_SAVE + 8 * (i - FIRST_SAVED_GPR));
+  for (u32 i = FIRST_SAVED_FPR; i < 32; i++)
+    STFD(static_cast<FPR>(i), GPR::SP, FPR_SAVE + 8 * (i - FIRST_SAVED_FPR));
+  for (u32 i = FIRST_SAVED_VR; i < 32; i++)
+  {
+    ADDI(GPR::R12, GPR::SP, VR_SAVE + 16 * (i - FIRST_SAVED_VR));
+    STXVD2X(ToVSR(static_cast<VR>(i)), GPR::R0, GPR::R12);
+  }
+
+  MOVP2R(PPC_REG, &m_ppc_state);
+
+  // The BLR optimization's frames go below one whose return address never matches, and the stack
+  // pointer there is kept, to drop them.
+  LI(GPR::R0, -1);
+  STDU(GPR::SP, GPR::SP, -BLR_FRAME_SIZE);
+  STD(GPR::R0, GPR::SP, BLR_GUEST_RETURN);
+  STD(GPR::SP, PPC_REG, PPCSTATE_OFF(stored_stack_pointer));
+
+  // The PC will be loaded into DISPATCHER_PC after the call to CoreTiming::Advance().
+  // Advance() does an exception check so we don't know what PC to use until afterwards.
+  const FixupBranch to_start_of_timing_slice = B();
+
+  // do
+  // {
+  //   CoreTiming::Advance();  // <-- Checks for exceptions (changes PC)
+  //   DISPATCHER_PC = PC;
+  //   do
+  //   {
+  // dispatcher_no_check:
+  //     ExecuteBlock(JitBase::Dispatch());
+  // dispatcher:
+  //   } while (m_ppc_state.downcount > 0);
+  // do_timing:
+  //   NPC = PC = DISPATCHER_PC;
+  // } while (CPU::GetState() == CPU::State::Running);
+  AlignCodePage();
+  dispatcher = GetCodePtr();
+
+  // Blocks exit to here with CR0 set from the downcount.
+  const FixupBranch bail = BC(CCFlags::LE, CRF::CR0);
+
+  dispatcher_no_timing_check = GetCodePtr();
+
+  FixupBranch debug_exit;
+  if (enable_debugging)
+  {
+    MOVP2R(GPR::R3, cpu.GetStatePtr());
+    LWZ(GPR::R3, GPR::R3, 0);
+    static_assert(std::to_underlying(CPU::State::Running) == 0);
+    CMPWI(CRF::CR1, GPR::R3, 0);
+    debug_exit = BC(CCFlags::NE, CRF::CR1);
+  }
+
+  dispatcher_no_check = GetCodePtr();
+
+  // C++ code may have changed MSR[DR], and with it the arena.
+  LD(MEM_REG, PPC_REG, PPCSTATE_OFF(mem_ptr));
+
+  if (u8** const entry_points = GetBlockCache()->GetEntryPoints())
+  {
+    // The entry points map is indexed by ((feature_flags << 30) | (pc >> 2)), and holds 8-byte
+    // pointers, so the byte offset is (feature_flags << 33) | (pc << 1).
+    LWZ(GPR::R3, PPC_REG, PPCSTATE_OFF(feature_flags));
+    MOVP2R(GPR::R4, entry_points);
+    SLDI(GPR::R5, DISPATCHER_PC, 1);
+    SLDI(GPR::R3, GPR::R3, 33);
+    OR(GPR::R5, GPR::R5, GPR::R3);
+    LDX(GPR::R6, GPR::R4, GPR::R5);
+    CMPDI(CRF::CR1, GPR::R6, 0);
+    const FixupBranch not_found = BC(CCFlags::EQ, CRF::CR1);
+    MTCTR(GPR::R6);
+    BCTR();
+    SetJumpTarget(not_found);
+  }
+  else
+  {
+    // block = fast_block_map_fallback[(pc >> 2) & FAST_BLOCK_MAP_FALLBACK_MASK];
+    static_assert(JitBaseBlockCache::FAST_BLOCK_MAP_FALLBACK_MASK == 0xFFFF);
+    MOVP2R(GPR::R4, GetBlockCache()->GetFastBlockMapFallback());
+    // ((pc >> 2) & 0xFFFF) * 8 == (pc << 1) & 0x7FFF8
+    RLWINM(GPR::R5, DISPATCHER_PC, 1, 13, 28);
+    LDX(GPR::R6, GPR::R4, GPR::R5);
+    CMPDI(CRF::CR1, GPR::R6, 0);
+    const FixupBranch not_found = BC(CCFlags::EQ, CRF::CR1);
+
+    // if (block->effectiveAddress == pc && block->feature_flags == feature_flags)
+    LWZ(GPR::R7, GPR::R6, offsetof(JitBlockData, effectiveAddress));
+    CMPLW(CRF::CR1, GPR::R7, DISPATCHER_PC);
+    const FixupBranch pc_mismatch = BC(CCFlags::NE, CRF::CR1);
+    LWZ(GPR::R7, GPR::R6, offsetof(JitBlockData, feature_flags));
+    LWZ(GPR::R8, PPC_REG, PPCSTATE_OFF(feature_flags));
+    CMPLW(CRF::CR1, GPR::R7, GPR::R8);
+    const FixupBranch feature_flags_mismatch = BC(CCFlags::NE, CRF::CR1);
+
+    // return block->normalEntry;
+    LD(GPR::R7, GPR::R6, offsetof(JitBlockData, normalEntry));
+    MTCTR(GPR::R7);
+    BCTR();
+
+    SetJumpTarget(not_found);
+    SetJumpTarget(pc_mismatch);
+    SetJumpTarget(feature_flags_mismatch);
+  }
+
+  STW(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF(pc));
+
+  // There is no point in calling the dispatcher in the fast lookup table case, since the assembly
+  // dispatcher would already have found a block.
+  if (!GetBlockCache()->GetEntryPoints())
+  {
+    // Call C version of Dispatch().
+    ABI_CallFunction(&JitBase::Dispatch, static_cast<JitBase*>(this));
+    CMPDI(CRF::CR1, GPR::R3, 0);
+    const FixupBranch no_block_available = BC(CCFlags::EQ, CRF::CR1);
+    MTCTR(GPR::R3);
+    BCTR();
+    SetJumpTarget(no_block_available);
+  }
+
+  // Call JIT, which may reuse the code that frames return to.
+  ResetStack();
+  ABI_CallFunction(&JitTrampoline, static_cast<JitBase*>(this), DISPATCHER_PC);
+  LWZ(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF(pc));
+  B(dispatcher_no_check);
+
+  SetJumpTarget(bail);
+  do_timing = GetCodePtr();
+  // Write the current PC and the downcount out to PPCSTATE
+  STW(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF(pc));
+  STW(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF(npc));
+  STW(DOWNCOUNT_REG, PPC_REG, PPCSTATE_OFF(downcount));
+
+  // Check the state pointer to see if we are exiting
+  // Gets checked on at the end of every slice
+  MOVP2R(GPR::R3, cpu.GetStatePtr());
+  LWZ(GPR::R3, GPR::R3, 0);
+  CMPWI(CRF::CR1, GPR::R3, 0);
+  const FixupBranch exit = BC(CCFlags::NE, CRF::CR1);
+
+  // The downcount is in PPCSTATE here, from above or from the caller of the dispatcher, and is
+  // loaded after.
+  SetJumpTarget(to_start_of_timing_slice);
+  PPC64CodeBlock::ABI_CallFunction(&CoreTiming::GlobalAdvance);
+  LWA(DOWNCOUNT_REG, PPC_REG, PPCSTATE_OFF(downcount));
+  // Advance may clear the code cache, for a change of settings.
+  ResetStack();
+
+  // Load the PC back into DISPATCHER_PC (the exception handler might have changed it)
+  LWZ(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF(pc));
+
+  // We can safely assume that downcount >= 1
+  B(dispatcher_no_check);
+
+  if (enable_debugging)
+  {
+    SetJumpTarget(debug_exit);
+    STW(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF(pc));
+    STW(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF(npc));
+    STW(DOWNCOUNT_REG, PPC_REG, PPCSTATE_OFF(downcount));
+  }
+
+  dispatcher_exit = GetCodePtr();
+  SetJumpTarget(exit);
+
+  // Epilogue, without the frames of the BLR optimization.
+  LD(GPR::SP, PPC_REG, PPCSTATE_OFF(stored_stack_pointer));
+  ADDI(GPR::SP, GPR::SP, BLR_FRAME_SIZE);
+  for (u32 i = FIRST_SAVED_VR; i < 32; i++)
+  {
+    ADDI(GPR::R12, GPR::SP, VR_SAVE + 16 * (i - FIRST_SAVED_VR));
+    LXVD2X(ToVSR(static_cast<VR>(i)), GPR::R0, GPR::R12);
+  }
+  for (u32 i = FIRST_SAVED_FPR; i < 32; i++)
+    LFD(static_cast<FPR>(i), GPR::SP, FPR_SAVE + 8 * (i - FIRST_SAVED_FPR));
+  for (u32 i = FIRST_SAVED_GPR; i < 32; i++)
+    LD(static_cast<GPR>(i), GPR::SP, GPR_SAVE + 8 * (i - FIRST_SAVED_GPR));
+  LD(GPR::TOC, GPR::SP, TOC_SAVE);
+  ADDI(GPR::SP, GPR::SP, FRAME_SIZE);
+  LWZ(GPR::R0, GPR::SP, CR_SAVE);
+  MTCRF(SAVED_CR_FIELDS, GPR::R0);
+  LD(GPR::R0, GPR::SP, STACK_FRAME_LR_SAVE);
+  MTLR(GPR::R0);
+  BLR();
+
+  Common::JitRegister::Register(enter_code, GetCodePtr(), "JIT_Dispatcher");
+
+  const u8* routines_start = GetCodePtr();
+  GenerateSlowAccessRoutines();
+  GenerateExceptionExitRoutine();
+  GenerateQuantizedRoutines();
+  m_fprf_double_routine = GetCodePtr();
+  GenerateFPRFRoutine(false);
+  m_fprf_single_routine = GetCodePtr();
+  GenerateFPRFRoutine(true);
+  m_fres_routine = GetCodePtr();
+  GenerateReciprocalEstimateRoutine();
+  m_frsqrte_routine = GetCodePtr();
+  GenerateReciprocalSquareRootEstimateRoutine();
+  Common::JitRegister::Register(routines_start, GetCodePtr(), "JIT_SlowAccess");
+
+  FlushIcache();
+}
+
+void JitPPC64::GenerateExceptionExitRoutine()
+{
+  // The end of WriteExceptionExit(pc, false, true), shared by the conditional exception exits,
+  // which are many in far code: memory checks give every load and store one.
+  m_exception_exit_routine = GetCodePtr();
+  STW(GPR::R3, PPC_REG, PPCSTATE_OFF(pc));
+  STW(GPR::R3, PPC_REG, PPCSTATE_OFF(npc));
+  // DISPATCHER_PC is non-volatile, so it keeps the cycles across the call.
+  MR(DISPATCHER_PC, GPR::R4);
+  ABI_CallFunction(&PowerPC::CheckExceptionsFromJIT, &m_system.GetPowerPC());
+  // As DoDownCount, which sets CR0 for the dispatcher.
+  SUBF(DOWNCOUNT_REG, DISPATCHER_PC, DOWNCOUNT_REG, true);
+  LWZ(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF(npc));
+  B(dispatcher);
+}
+
+void JitPPC64::GenerateFPRFRoutine(bool single)
+{
+  if (m_isa_3_0)
+  {
+    GenerateFPRFRoutineISA3_0(single);
+    return;
+  }
+
+  // Sets FPSCR[FPRF] for the double in R3 as Common::ClassifyDouble does, or, for a value rounded
+  // to single precision, as Common::ClassifyFloat does for it: such a value is a single denormal
+  // when its exponent is below the single minimum, 2^-126. Uses R0, R3, R4, CR0 and CR1.
+  RLDICL(GPR::R4, GPR::R3, 12, 53);  // Exponent
+  SLDI(GPR::R0, GPR::R3, 12);        // Fraction, nonzero or not
+  SRDI(GPR::R3, GPR::R3, 63);        // Sign
+  CMPDI(CRF::CR1, GPR::R0, 0);
+
+  CMPLWI(CRF::CR0, GPR::R4, 0x7FF);
+  const FixupBranch special = BC(CCFlags::EQ, CRF::CR0);
+  CMPLWI(CRF::CR0, GPR::R4, single ? 1023 - 126 : 1);
+  const FixupBranch tiny = BC(CCFlags::LT, CRF::CR0);
+
+  // Normal: PPC_FPCLASS_PN or PPC_FPCLASS_NN.
+  static_assert(Common::PPC_FPCLASS_NN == Common::PPC_FPCLASS_PN + 4);
+  SLWI(GPR::R4, GPR::R3, 2);
+  ADDI(GPR::R4, GPR::R4, Common::PPC_FPCLASS_PN);
+  const FixupBranch normal_done = B();
+
+  // Zero or denormal: for a single, any nonzero value here is a denormal.
+  SetJumpTarget(tiny);
+  if (single)
+  {
+    OR(GPR::R0, GPR::R0, GPR::R4);
+    CMPDI(CRF::CR1, GPR::R0, 0);
+  }
+  const FixupBranch denormal = BC(CCFlags::NE, CRF::CR1);
+  static_assert(Common::PPC_FPCLASS_NZ == Common::PPC_FPCLASS_PZ + 16);
+  SLWI(GPR::R4, GPR::R3, 4);
+  ADDI(GPR::R4, GPR::R4, Common::PPC_FPCLASS_PZ);
+  const FixupBranch zero_done = B();
+  SetJumpTarget(denormal);
+  static_assert(Common::PPC_FPCLASS_ND == Common::PPC_FPCLASS_PD + 4);
+  SLWI(GPR::R4, GPR::R3, 2);
+  ADDI(GPR::R4, GPR::R4, Common::PPC_FPCLASS_PD);
+  const FixupBranch denormal_done = B();
+
+  // Infinity or NaN.
+  SetJumpTarget(special);
+  const FixupBranch nan = BC(CCFlags::NE, CRF::CR1);
+  static_assert(Common::PPC_FPCLASS_NINF == Common::PPC_FPCLASS_PINF + 4);
+  SLWI(GPR::R4, GPR::R3, 2);
+  ADDI(GPR::R4, GPR::R4, Common::PPC_FPCLASS_PINF);
+  const FixupBranch infinity_done = B();
+  SetJumpTarget(nan);
+  LI(GPR::R4, Common::PPC_FPCLASS_QNAN);
+
+  SetJumpTarget(normal_done);
+  SetJumpTarget(zero_done);
+  SetJumpTarget(denormal_done);
+  SetJumpTarget(infinity_done);
+  // FPRF is FPSCR's bits 12-16.
+  LWZ(GPR::R0, PPC_REG, PPCSTATE_OFF(fpscr));
+  RLWIMI(GPR::R0, GPR::R4, 12, 15, 19);
+  STW(GPR::R0, PPC_REG, PPCSTATE_OFF(fpscr));
+  BLR();
+}
+
+void JitPPC64::GenerateFPRFRoutineISA3_0(bool single)
+{
+  // As GenerateFPRFRoutine, for the double in VS0, whose class xststdcdp tests, with its sign in
+  // LT, which setb turns into -1 (negative) or 0. Uses R0, R4, CR0 and CR1.
+  const auto sign_times = [this](u32 shift) {
+    SETB(GPR::R4, CRF::CR1);
+    RLWINM(GPR::R4, GPR::R4, 0, 31 - shift, 31 - shift);
+  };
+  // NaNs, infinities, zeroes and denormals.
+  XSTSTDCDP(CRF::CR1, VSR::VS0, 0x7F);
+  const FixupBranch special = BC(CCFlags::EQ, CRF::CR1);
+  FixupBranch tiny;
+  if (single)
+  {
+    // A single denormal: below the single minimum, 2^-126.
+    XSXEXPDP(GPR::R4, VSR::VS0);
+    CMPLWI(CRF::CR0, GPR::R4, 1023 - 126);
+    tiny = BC(CCFlags::LT, CRF::CR0);
+  }
+  static_assert(Common::PPC_FPCLASS_NN == Common::PPC_FPCLASS_PN + 4);
+  sign_times(2);
+  ADDI(GPR::R4, GPR::R4, Common::PPC_FPCLASS_PN);
+  const FixupBranch normal_done = B();
+
+  SetJumpTarget(special);
+  XSTSTDCDP(CRF::CR1, VSR::VS0, 0x40);
+  const FixupBranch nan = BC(CCFlags::EQ, CRF::CR1);
+  XSTSTDCDP(CRF::CR1, VSR::VS0, 0x30);
+  const FixupBranch infinity = BC(CCFlags::EQ, CRF::CR1);
+  XSTSTDCDP(CRF::CR1, VSR::VS0, 0x0C);
+  const FixupBranch zero = BC(CCFlags::EQ, CRF::CR1);
+  // Denormal.
+  if (single)
+    SetJumpTarget(tiny);
+  static_assert(Common::PPC_FPCLASS_ND == Common::PPC_FPCLASS_PD + 4);
+  // The single path reaches here from a normal double, whose CR1 also has its sign.
+  sign_times(2);
+  ADDI(GPR::R4, GPR::R4, Common::PPC_FPCLASS_PD);
+  const FixupBranch denormal_done = B();
+  SetJumpTarget(zero);
+  static_assert(Common::PPC_FPCLASS_NZ == Common::PPC_FPCLASS_PZ + 16);
+  sign_times(4);
+  ADDI(GPR::R4, GPR::R4, Common::PPC_FPCLASS_PZ);
+  const FixupBranch zero_done = B();
+  SetJumpTarget(infinity);
+  static_assert(Common::PPC_FPCLASS_NINF == Common::PPC_FPCLASS_PINF + 4);
+  sign_times(2);
+  ADDI(GPR::R4, GPR::R4, Common::PPC_FPCLASS_PINF);
+  const FixupBranch infinity_done = B();
+  SetJumpTarget(nan);
+  LI(GPR::R4, Common::PPC_FPCLASS_QNAN);
+
+  SetJumpTarget(normal_done);
+  SetJumpTarget(denormal_done);
+  SetJumpTarget(zero_done);
+  SetJumpTarget(infinity_done);
+  LWZ(GPR::R0, PPC_REG, PPCSTATE_OFF(fpscr));
+  RLWIMI(GPR::R0, GPR::R4, 12, 15, 19);
+  STW(GPR::R0, PPC_REG, PPCSTATE_OFF(fpscr));
+  BLR();
+}
+
+void JitPPC64::GenerateReciprocalEstimateRoutine()
+{
+  // As Common::ApproximateReciprocal, for nonzero finite inputs; zeroes, infinities and NaNs raise
+  // exceptions or set FPSCR flags, which the interpreter does. Uses R0, R3, R4, R12, CR0 and CR1.
+  FixupBranch special, zero;
+  if (m_isa_3_0)
+  {
+    // With the input in VS0 too: NaNs, infinities and zeroes.
+    XSTSTDCDP(CRF::CR1, VSR::VS0, 0x7C);
+    special = BC(CCFlags::EQ, CRF::CR1);
+    RLDICL(GPR::R4, GPR::R3, 12, 53);  // Exponent
+  }
+  else
+  {
+    RLDICL(GPR::R4, GPR::R3, 12, 53);  // Exponent
+    CMPLWI(CRF::CR1, GPR::R4, 0x7FF);
+    special = BC(CCFlags::EQ, CRF::CR1);
+    SLDI(GPR::R0, GPR::R3, 1);
+    CMPDI(CRF::CR0, GPR::R0, 0);
+    zero = BC(CCFlags::EQ, CRF::CR0);
+  }
+  RLDICR(GPR::R12, GPR::R3, 0, 0);  // Sign
+  CMPLWI(CRF::CR1, GPR::R4, 895);
+  const FixupBranch small = BC(CCFlags::LT, CRF::CR1);
+  CMPLWI(CRF::CR1, GPR::R4, 1149);
+  const FixupBranch large = BC(CCFlags::GE, CRF::CR1);
+
+  // (0x7FD << 52) - exponent, and base - (dec * (i % 1024) + 1) / 2 from fres_expected[i / 1024],
+  // i being the top 15 bits of the mantissa.
+  SUBFIC(GPR::R0, GPR::R4, 0x7FD);
+  SLDI(GPR::R0, GPR::R0, 52);
+  OR(GPR::R12, GPR::R12, GPR::R0);
+  RLDICL(GPR::R4, GPR::R3, 64 - 37, 49);
+  MOVP2R(GPR::R3, Common::fres_expected.data());
+  static_assert(sizeof(Common::BaseAndDec) == 8);
+  RLWINM(GPR::R0, GPR::R4, 32 - 10 + 3, 24, 28);
+  ADD(GPR::R3, GPR::R3, GPR::R0);
+  LWZ(GPR::R0, GPR::R3, offsetof(Common::BaseAndDec, m_dec));
+  LWZ(GPR::R3, GPR::R3, offsetof(Common::BaseAndDec, m_base));
+  CLRLDI(GPR::R4, GPR::R4, 64 - 10);
+  MULLW(GPR::R4, GPR::R4, GPR::R0);
+  ADDI(GPR::R4, GPR::R4, 1);
+  SRWI(GPR::R4, GPR::R4, 1);
+  SUBF(GPR::R3, GPR::R4, GPR::R3);
+  SLDI(GPR::R3, GPR::R3, 29);
+  OR(GPR::R3, GPR::R3, GPR::R12);
+  LI(GPR::R4, 0);
+  BLR();
+
+  // Small inputs give the largest single, and large ones zero, of the input's sign.
+  SetJumpTarget(small);
+  MOVI2R(GPR::R3, std::bit_cast<u64>(static_cast<double>(std::numeric_limits<float>::max())));
+  OR(GPR::R3, GPR::R3, GPR::R12);
+  LI(GPR::R4, 0);
+  BLR();
+  SetJumpTarget(large);
+  MR(GPR::R3, GPR::R12);
+  LI(GPR::R4, 0);
+  BLR();
+
+  SetJumpTarget(special);
+  if (!m_isa_3_0)
+    SetJumpTarget(zero);
+  LI(GPR::R4, 1);
+  BLR();
+}
+
+void JitPPC64::GenerateReciprocalSquareRootEstimateRoutine()
+{
+  // As Common::ApproximateReciprocalSquareRoot, for positive normal inputs; the others raise
+  // exceptions, set FPSCR flags or are rare, and the interpreter runs them. Uses R0, R3, R4, R12,
+  // CR0 and CR1.
+  FixupBranch negative, zero_or_denormal, special;
+  if (m_isa_3_0)
+  {
+    // With the input in VS0 too: anything but a normal, or a negative, in one test.
+    XSTSTDCDP(CRF::CR1, VSR::VS0, 0x7F);
+    CROR(CRBit(CRF::CR1, CCFlags::EQ), CRBit(CRF::CR1, CCFlags::EQ), CRBit(CRF::CR1, CCFlags::LT));
+    special = BC(CCFlags::EQ, CRF::CR1);
+    RLDICL(GPR::R4, GPR::R3, 12, 53);  // Exponent
+  }
+  else
+  {
+    CMPDI(CRF::CR0, GPR::R3, 0);
+    negative = BC(CCFlags::LT, CRF::CR0);
+    RLDICL(GPR::R4, GPR::R3, 12, 53);  // Exponent
+    CMPLWI(CRF::CR1, GPR::R4, 0);
+    zero_or_denormal = BC(CCFlags::EQ, CRF::CR1);
+    CMPLWI(CRF::CR1, GPR::R4, 0x7FF);
+    special = BC(CCFlags::EQ, CRF::CR1);
+  }
+
+  // ((0x3FF << 52) - ((exponent - (0x3FE << 52)) / 2)) & (0x7FF << 52), the division being exact.
+  ADDI(GPR::R12, GPR::R4, -0x3FE);
+  SLDI(GPR::R12, GPR::R12, 52);
+  SRADI(GPR::R12, GPR::R12, 1);
+  LIS(GPR::R0, 0x3FF0);
+  SLDI(GPR::R0, GPR::R0, 32);
+  SUBF(GPR::R12, GPR::R12, GPR::R0);
+  RLDICL(GPR::R12, GPR::R12, 0, 1);
+  RLDICR(GPR::R12, GPR::R12, 0, 11);
+
+  // base + dec * (i % 2048) from frsqrte_expected[i / 2048], i being the exponent's lowest bit and
+  // the top 15 bits of the mantissa.
+  RLDICL(GPR::R4, GPR::R3, 64 - 37, 48);
+  MOVP2R(GPR::R0, Common::frsqrte_expected.data());
+  RLWINM(GPR::R3, GPR::R4, 32 - 11 + 3, 24, 28);
+  ADD(GPR::R3, GPR::R3, GPR::R0);
+  LWZ(GPR::R0, GPR::R3, offsetof(Common::BaseAndDec, m_dec));
+  LWZ(GPR::R3, GPR::R3, offsetof(Common::BaseAndDec, m_base));
+  CLRLDI(GPR::R4, GPR::R4, 64 - 11);
+  MULLW(GPR::R4, GPR::R4, GPR::R0);
+  ADD(GPR::R3, GPR::R3, GPR::R4);
+  SLDI(GPR::R3, GPR::R3, 26);
+  OR(GPR::R3, GPR::R3, GPR::R12);
+  LI(GPR::R4, 0);
+  BLR();
+
+  if (!m_isa_3_0)
+  {
+    SetJumpTarget(negative);
+    SetJumpTarget(zero_or_denormal);
+  }
+  SetJumpTarget(special);
+  LI(GPR::R4, 1);
+  BLR();
+}
diff --git a/Source/Core/Core/PowerPC/JitPPC64/JitPPC64Cache.cpp b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64Cache.cpp
new file mode 100644
index 0000000000..bb465affde
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64Cache.cpp
@@ -0,0 +1,108 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/PowerPC/JitPPC64/JitPPC64Cache.h"
+
+#include "Common/CommonTypes.h"
+#include "Common/MemoryUtil.h"
+#include "Core/PowerPC/JitCommon/JitBase.h"
+#include "Core/PowerPC/JitPPC64/Jit.h"
+
+using namespace PPC64Gen;
+
+JitPPC64BlockCache::JitPPC64BlockCache(JitBase& jit) : JitBaseBlockCache{jit}
+{
+}
+
+bool JitPPC64BlockCache::Init()
+{
+  ClearRangesToFree();
+  return JitBaseBlockCache::Init();
+}
+
+bool JitPPC64BlockCache::CanBranchToBlock(const u8* link, const u8* target)
+{
+  const s64 offset = target - (link + sizeof(u32));
+  return offset >= -(s64{1} << 25) && offset < (s64{1} << 25);
+}
+
+void JitPPC64BlockCache::WriteLinkBlock(PPC64XEmitter& emit, const JitBlock::LinkData& source,
+                                        const JitBlock* dest)
+{
+  const u8* start = emit.GetCodePtr();
+
+  if (source.call)
+  {
+    const u8* slow = start + 3 * sizeof(u32);
+    if (dest && CanBranchToBlock(start, dest->normalEntry))
+    {
+      emit.BC(CCFlags::LE, CRF::CR0, slow);
+      emit.BL(dest->normalEntry);
+    }
+    else
+    {
+      emit.B(slow);
+      emit.NOP();
+    }
+    emit.B(start + CALL_LINK_SIZE);
+  }
+  else if (dest && CanBranchToBlock(start, dest->normalEntry))
+  {
+    const FixupBranch out_of_cycles = emit.BC(CCFlags::LE, CRF::CR0);
+    emit.B(dest->normalEntry);
+    emit.SetJumpTarget(out_of_cycles);
+  }
+  else
+  {
+    emit.NOP();
+    emit.NOP();
+  }
+
+  const u8* move_start = emit.GetCodePtr();
+  emit.MOVI2R(DISPATCHER_PC, source.exitAddress);
+  while (emit.GetCodePtr() < move_start + 3 * sizeof(u32) && !emit.HasWriteFailed())
+    emit.NOP();
+  emit.B(static_cast<const JitPPC64&>(m_jit).Routine(m_jit.GetAsmRoutines()->dispatcher, start));
+
+  ASSERT(emit.GetCodePtr() == start + (source.call ? CALL_LINK_SIZE : BLOCK_LINK_SIZE) ||
+         emit.HasWriteFailed());
+}
+
+void JitPPC64BlockCache::WriteLinkBlock(const JitBlock::LinkData& source, const JitBlock* dest)
+{
+  const Common::ScopedJITPageWriteAndNoExecute enable_jit_page_writes;
+  u8* location = source.exitPtrs;
+  PPC64XEmitter emit(location, location + (source.call ? CALL_LINK_SIZE : BLOCK_LINK_SIZE));
+
+  WriteLinkBlock(emit, source, dest);
+  emit.FlushIcache();
+}
+
+void JitPPC64BlockCache::WriteDestroyBlock(const JitBlock& block)
+{
+  // Only clear the entry point as we might still be within this block.
+  PPC64XEmitter emit(block.normalEntry, block.normalEntry + sizeof(u32));
+  const Common::ScopedJITPageWriteAndNoExecute enable_jit_page_writes;
+  emit.TRAP();
+  emit.FlushIcache();
+}
+
+void JitPPC64BlockCache::DestroyBlock(JitBlock& block)
+{
+  JitBaseBlockCache::DestroyBlock(block);
+
+  if (block.near_begin != block.near_end)
+    m_ranges_to_free_on_next_codegen.emplace_back(block.near_begin, block.near_end);
+  if (block.far_begin != block.far_end)
+    m_ranges_to_free_on_next_codegen.emplace_back(block.far_begin, block.far_end);
+}
+
+const std::vector<std::pair<u8*, u8*>>& JitPPC64BlockCache::GetRangesToFree() const
+{
+  return m_ranges_to_free_on_next_codegen;
+}
+
+void JitPPC64BlockCache::ClearRangesToFree()
+{
+  m_ranges_to_free_on_next_codegen.clear();
+}
diff --git a/Source/Core/Core/PowerPC/JitPPC64/JitPPC64Cache.h b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64Cache.h
new file mode 100644
index 0000000000..de82819322
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64Cache.h
@@ -0,0 +1,64 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <utility>
+#include <vector>
+
+#include "Common/PPC64Emitter.h"
+#include "Core/PowerPC/JitCommon/JitCache.h"
+
+class JitBase;
+
+class JitPPC64BlockCache : public JitBaseBlockCache
+{
+public:
+  explicit JitPPC64BlockCache(JitBase& jit);
+
+  [[nodiscard]] bool Init() override;
+
+  void DestroyBlock(JitBlock& block) override;
+
+  const std::vector<std::pair<u8*, u8*>>& GetRangesToFree() const;
+
+  void ClearRangesToFree();
+
+  void WriteLinkBlock(PPC64Gen::PPC64XEmitter& emit, const JitBlock::LinkData& source,
+                      const JitBlock* dest = nullptr);
+  // Whether the branch of a link at link can reach a block at target. It follows the check for
+  // cycles, so its range is from there.
+  static bool CanBranchToBlock(const u8* link, const u8* target);
+
+  // An exit is a fixed number of instructions, so that it can be rewritten when blocks are linked
+  // and unlinked:
+  //
+  //   Unlinked:                     Linked:
+  //   nop                           ble cr0, 1f        # Out of cycles: go through the dispatcher
+  //   nop                           b dest
+  //   MOVI2R DISPATCHER_PC, exit    1: MOVI2R DISPATCHER_PC, exit
+  //   b dispatcher                  b dispatcher
+  //
+  // MOVI2R of a 32-bit address takes up to three instructions, padded with nops. The dispatcher
+  // goes to do_timing when CR0 says that the block ran out of cycles.
+  static constexpr size_t BLOCK_LINK_SIZE = 6 * sizeof(u32);
+
+  // A guest call, with the BLR optimization, is a host call, so that the host predicts the guest's
+  // return, which comes back to the instruction after the bl, and the exit after this:
+  //
+  //   Unlinked:                     Linked:
+  //   b 1f                          ble cr0, 1f
+  //   nop                           bl dest
+  //   b 2f                          b 2f
+  //   1: MOVI2R DISPATCHER_PC, exit 1: MOVI2R DISPATCHER_PC, exit
+  //   b dispatcher                  b dispatcher
+  //   2:                            2:
+  static constexpr size_t CALL_LINK_SIZE = 7 * sizeof(u32);
+  static constexpr s32 CALL_LINK_RETURN = 2 * sizeof(u32);
+
+private:
+  void WriteLinkBlock(const JitBlock::LinkData& source, const JitBlock* dest) override;
+  void WriteDestroyBlock(const JitBlock& block) override;
+
+  std::vector<std::pair<u8*, u8*>> m_ranges_to_free_on_next_codegen;
+};
diff --git a/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_Branch.cpp b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_Branch.cpp
new file mode 100644
index 0000000000..e8b664b498
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_Branch.cpp
@@ -0,0 +1,269 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/PowerPC/JitPPC64/Jit.h"
+
+#include "Common/CommonTypes.h"
+#include "Common/PPC64Emitter.h"
+#include "Core/CoreTiming.h"
+#include "Core/PowerPC/Gekko.h"
+#include "Core/PowerPC/PPCAnalyst.h"
+#include "Core/PowerPC/PowerPC.h"
+
+using namespace PPC64Gen;
+
+// Branch Watch records branches in the interpreter, so branches fall back to it while it is on.
+
+void JitPPC64::sc(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITBranchOff);
+
+  FlushRegisters(FlushMode::All);
+  {
+    const auto tmp = gpr.GetScopedReg();
+    LWZ(tmp, PPC_REG, PPCSTATE_OFF(Exceptions));
+    ORI(tmp, tmp, EXCEPTION_SYSCALL);
+    STW(tmp, PPC_REG, PPCSTATE_OFF(Exceptions));
+  }
+  WriteExceptionExit(js.compilerPC + 4, false, true);
+}
+
+void JitPPC64::bx(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITBranchOff);
+  FALLBACK_IF(IsBranchWatchEnabled());
+
+  if (inst.LK)
+  {
+    const auto tmp = gpr.GetScopedReg();
+    MOVI2R(tmp, js.compilerPC + 4);
+    STW(tmp, PPC_REG, PPCSTATE_OFF_SPR(SPR_LR));
+  }
+
+  // PPCAnalyzer::Analyze() followed the branch, thus the next instruction of the block is the
+  // destination of the branch, no need to do anything, except for a call whose return the block
+  // doesn't follow too.
+  if (js.op->branchAction == PPCAnalyst::BranchAction::Follow)
+  {
+    if (inst.LK && !js.op->skipLRStack)
+      FakeLKExit(js.compilerPC + 4);
+    return;
+  }
+
+  FlushRegisters(FlushMode::All);
+
+  if (js.op->branchAction == PPCAnalyst::BranchAction::IdleLoop)
+  {
+    // make idle loops go faster
+    ABI_CallFunction(&CoreTiming::GlobalIdle);
+    WriteExceptionExit(js.op->branchTo);
+    return;
+  }
+
+  WriteExit(js.op->branchTo, inst.LK, js.compilerPC + 4);
+}
+
+void JitPPC64::bcx(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITBranchOff);
+  FALLBACK_IF(IsBranchWatchEnabled());
+
+  // The CR field is bound before the CTR test branches, so that the cache is the same on both
+  // paths.
+  if ((inst.BO & BO_DONT_CHECK_CONDITION) == 0)
+    gpr.CR(inst.BI >> 2);
+
+  FixupBranch ctr_dont_branch;
+  if ((inst.BO & BO_DONT_DECREMENT_FLAG) == 0)  // Decrement and test CTR
+  {
+    const auto tmp = gpr.GetScopedReg();
+    LWZ(tmp, PPC_REG, PPCSTATE_OFF_SPR(SPR_CTR));
+    ADDI(tmp, tmp, -1);
+    STW(tmp, PPC_REG, PPCSTATE_OFF_SPR(SPR_CTR));
+    CMPLWI(CRF::CR0, tmp, 0);
+    ctr_dont_branch = BC((inst.BO & BO_BRANCH_IF_CTR_0) ? CCFlags::NE : CCFlags::EQ, CRF::CR0);
+  }
+
+  FixupBranch condition_dont_branch;
+  if ((inst.BO & BO_DONT_CHECK_CONDITION) == 0)  // Test a CR bit
+  {
+    condition_dont_branch =
+        JumpIfCRFieldBit(inst.BI >> 2, 3 - (inst.BI & 3), !(inst.BO_2 & BO_BRANCH_IF_TRUE));
+  }
+
+  if (inst.LK)
+  {
+    const auto tmp = gpr.GetScopedReg();
+    MOVI2R(tmp, js.compilerPC + 4);
+    STW(tmp, PPC_REG, PPCSTATE_OFF_SPR(SPR_LR));
+  }
+
+  // PPCAnalyzer::Analyze() followed this unconditional branch, thus the next instruction of the
+  // block is the destination of the branch, no need to do anything, except for a call whose
+  // return the block doesn't follow too.
+  if (js.op->branchAction == PPCAnalyst::BranchAction::Follow)
+  {
+    if (inst.LK && !js.op->skipLRStack)
+      FakeLKExit(js.compilerPC + 4);
+    return;
+  }
+
+  // The code after the branch continues with the guest registers in host registers.
+  FlushRegisters(FlushMode::MaintainState);
+
+  if (js.op->branchAction == PPCAnalyst::BranchAction::IdleLoop)
+  {
+    // make idle loops go faster
+    ABI_CallFunction(&CoreTiming::GlobalIdle);
+    WriteExceptionExit(js.op->branchTo);
+  }
+  else
+  {
+    WriteExit(js.op->branchTo, inst.LK, js.compilerPC + 4);
+  }
+
+  if ((inst.BO & BO_DONT_CHECK_CONDITION) == 0)
+    SetJumpTarget(condition_dont_branch);
+  if ((inst.BO & BO_DONT_DECREMENT_FLAG) == 0)
+    SetJumpTarget(ctr_dont_branch);
+
+  if (!analyzer.HasOption(PPCAnalyst::PPCAnalyzer::OPTION_CONDITIONAL_CONTINUE))
+  {
+    FlushRegisters(FlushMode::All);
+    WriteExit(js.compilerPC + 4);
+  }
+}
+
+void JitPPC64::bcctrx(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITBranchOff);
+  FALLBACK_IF(IsBranchWatchEnabled());
+
+  // Rare condition seen in (just some versions of?) Nintendo's NES Emulator
+  // BO_2 == 001zy -> b if false
+  // BO_2 == 011zy -> b if true
+  FALLBACK_IF(!(inst.BO_2 & BO_DONT_CHECK_CONDITION));
+
+  // bcctrx doesn't decrement and/or test CTR
+  ASSERT_MSG(DYNA_REC, inst.BO_2 & BO_DONT_DECREMENT_FLAG,
+             "bcctrx with decrement and test CTR option is invalid!");
+
+  // BO_2 == 1z1zz -> b always
+
+  // NPC = CTR & 0xfffffffc;
+  FlushRegisters(FlushMode::All);
+
+  LWZ(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF_SPR(SPR_CTR));
+  RLWINM(DISPATCHER_PC, DISPATCHER_PC, 0, 0, 29);
+  if (inst.LK_3)
+  {
+    const auto tmp = gpr.GetScopedReg();
+    MOVI2R(tmp, js.compilerPC + 4);
+    STW(tmp, PPC_REG, PPCSTATE_OFF_SPR(SPR_LR));
+  }
+
+  WriteExit(DISPATCHER_PC, inst.LK_3, js.compilerPC + 4);
+}
+
+void JitPPC64::bclrx(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITBranchOff);
+  FALLBACK_IF(IsBranchWatchEnabled());
+
+  // The CR field is bound before the CTR test branches, so that the cache is the same on both
+  // paths.
+  if ((inst.BO & BO_DONT_CHECK_CONDITION) == 0)
+    gpr.CR(inst.BI >> 2);
+
+  FixupBranch ctr_dont_branch;
+  if ((inst.BO & BO_DONT_DECREMENT_FLAG) == 0)  // Decrement and test CTR
+  {
+    const auto tmp = gpr.GetScopedReg();
+    LWZ(tmp, PPC_REG, PPCSTATE_OFF_SPR(SPR_CTR));
+    ADDI(tmp, tmp, -1);
+    STW(tmp, PPC_REG, PPCSTATE_OFF_SPR(SPR_CTR));
+    CMPLWI(CRF::CR0, tmp, 0);
+    ctr_dont_branch = BC((inst.BO & BO_BRANCH_IF_CTR_0) ? CCFlags::NE : CCFlags::EQ, CRF::CR0);
+  }
+
+  FixupBranch condition_dont_branch;
+  if ((inst.BO & BO_DONT_CHECK_CONDITION) == 0)  // Test a CR bit
+  {
+    condition_dont_branch =
+        JumpIfCRFieldBit(inst.BI >> 2, 3 - (inst.BI & 3), !(inst.BO_2 & BO_BRANCH_IF_TRUE));
+  }
+
+  // The code after the branch continues with the guest registers in host registers.
+  FlushRegisters(FlushMode::MaintainState);
+
+  // NPC = LR & 0xfffffffc, read before LK writes LR.
+  LWZ(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF_SPR(SPR_LR));
+  RLWINM(DISPATCHER_PC, DISPATCHER_PC, 0, 0, 29);
+  if (inst.LK)
+  {
+    const auto tmp = gpr.GetScopedReg();
+    MOVI2R(tmp, js.compilerPC + 4);
+    STW(tmp, PPC_REG, PPCSTATE_OFF_SPR(SPR_LR));
+  }
+
+  if (js.op->branchAction == PPCAnalyst::BranchAction::IdleLoop)
+  {
+    // make idle loops go faster
+    ABI_CallFunction(&CoreTiming::GlobalIdle);
+    WriteExceptionExit(js.op->branchTo);
+  }
+  else if (inst.LK)
+  {
+    WriteExit(DISPATCHER_PC, true, js.compilerPC + 4);
+  }
+  else
+  {
+    WriteBLRExit(DISPATCHER_PC);
+  }
+
+  if ((inst.BO & BO_DONT_CHECK_CONDITION) == 0)
+    SetJumpTarget(condition_dont_branch);
+  if ((inst.BO & BO_DONT_DECREMENT_FLAG) == 0)
+    SetJumpTarget(ctr_dont_branch);
+
+  if (!analyzer.HasOption(PPCAnalyst::PPCAnalyzer::OPTION_CONDITIONAL_CONTINUE))
+  {
+    FlushRegisters(FlushMode::All);
+    WriteExit(js.compilerPC + 4);
+  }
+}
+
+void JitPPC64::rfi(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITBranchOff);
+
+  // As the interpreter, without the privilege check, as the other JITs: restore the bits of MSR
+  // that SRR1 saves, clear MSR[13], and return to SRR0, taking a pending exception.
+  FlushRegisters(FlushMode::All);
+  constexpr u32 mask = 0x87C0FFFF;
+  constexpr u32 clear_msr13 = 0xFFFBFFFF;
+  {
+    const auto msr = gpr.GetScopedReg();
+    const auto tmp = gpr.GetScopedReg();
+    const auto srr1 = gpr.GetScopedReg();
+    LWZ(msr, PPC_REG, PPCSTATE_OFF(msr));
+    MOVI2R(tmp, ~mask & clear_msr13);
+    AND(msr, msr, tmp);
+    LWZ(srr1, PPC_REG, PPCSTATE_OFF_SPR(SPR_SRR1));
+    MOVI2R(tmp, mask & clear_msr13);
+    AND(srr1, srr1, tmp);
+    OR(msr, msr, srr1);
+    STW(msr, PPC_REG, PPCSTATE_OFF(msr));
+    EmitMSRUpdated(msr);
+  }
+  EmitPendingPageTableUpdate();
+
+  LWZ(DISPATCHER_PC, PPC_REG, PPCSTATE_OFF_SPR(SPR_SRR0));
+  WriteExceptionExit(DISPATCHER_PC);
+}
diff --git a/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_FloatingPoint.cpp b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_FloatingPoint.cpp
new file mode 100644
index 0000000000..608936bd46
--- /dev/null
+++ b/Source/Core/Core/PowerPC/JitPPC64/JitPPC64_FloatingPoint.cpp
@@ -0,0 +1,780 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Floating-point instructions.
+//
+// The host is a PowerPC too, and its floating-point instructions give the results that the
+// interpreter computes, bit for bit, in every rounding mode: the interpreter's arithmetic compiles
+// to the same instructions, and the host picks and quiets NaN operands as the interpreter does.
+// What's left to do here is what the interpreter does on top: rounding frC to 25 bits for single
+// precision multiplies, the correction of ties in single precision fused multiply-adds, flushing
+// denormals when FPSCR[NI] is set, and not negating NaNs.
+//
+// As in the other JITs, FPSCR is not updated, except by instructions that fall back to the
+// interpreter: these are the record forms, and every instruction when FPRF or floating-point
+// exceptions are enabled.
+
+#include "Core/PowerPC/JitPPC64/Jit.h"
+
+#include "Common/Assert.h"
+#include "Common/CommonTypes.h"
+#include "Common/PPC64Emitter.h"
+#include "Core/PowerPC/Gekko.h"
+#include "Core/PowerPC/Interpreter/Interpreter.h"
+#include "Core/PowerPC/PowerPC.h"
+
+using namespace PPC64Gen;
+
+void JitPPC64::EnsureNILoaded()
+{
+  if (m_ni_loaded)
+    return;
+
+  const auto tmp = gpr.GetScopedReg();
+  LWZ(tmp, PPC_REG, PPCSTATE_OFF(fpscr));
+  ANDI_(tmp, tmp, 0x4);  // NI
+  MCRF(CRF::CR4, CRF::CR0);
+  m_ni_loaded = true;
+}
+
+// The flushes test the value where it is, by Power ISA 3.0's data class test and exponent
+// extraction, and branch to far code only to flush: games that set NI keep it set, and a test in
+// far code would take two branches and a round trip through a GPR for every result. Without those
+// instructions, far code tests the bits in a GPR when NI is set.
+
+void JitPPC64::FlushToSignedZero(VSR reg)
+{
+  const auto zero = fpr.GetScopedReg();
+  XXLXOR(zero, zero, zero);
+  XSCPSGNDP(reg, reg, zero);
+}
+
+void JitPPC64::ForceDouble(VSR reg)
+{
+  EnsureNILoaded();
+  if (m_isa_3_0)
+  {
+    // As Common::FlushToZero: a denormal becomes a zero of the same sign, when NI is set.
+    XSTSTDCDP(CRF::CR1, reg, 0x03);
+    CRANDC(CRBit(CRF::CR1, CCFlags::EQ), CRBit(CRF::CR1, CCFlags::EQ),
+           CRBit(CRF::CR4, CCFlags::EQ));
+    const FixupBranch flush = BCFar(CCFlags::EQ, CRF::CR1);
+    const u8* done = GetCodePtr();
+
+    SwitchToFarCode();
+    SetJumpTarget(flush);
+    FlushToSignedZero(reg);
+    B(done);
+    SwitchToNearCode();
+    return;
+  }
+
+  const FixupBranch ni = BCFar(CCFlags::NE, CRF::CR4);
+  const u8* done = GetCodePtr();
+
+  // As Common::FlushToZero: denormals become zeroes of the same sign.
+  SwitchToFarCode();
+  SetJumpTarget(ni);
+  {
+    const auto bits = gpr.GetScopedReg();
+    const auto exp = gpr.GetScopedReg();
+    MFVSRD(bits, reg);
+    RLDICL(exp, bits, 12, 53, true);
+    const FixupBranch not_denormal = BC(CCFlags::NE, CRF::CR0);
+    RLDICR(bits, bits, 0, 0);
+    MTVSRD(reg, bits);
+    SetJumpTarget(not_denormal);
+  }
+  B(done);
+  SwitchToNearCode();
+}
+
+void JitPPC64::ForceSingle(VSR reg)
+{
+  EnsureNILoaded();
+  // With NI, a value below the smallest normal single is flushed to a zero of the same sign before
+  // it's rounded. Rounding can't make any other value denormal.
+  if (m_isa_3_0)
+  {
+    // Below it is an exponent below the smallest normal single's: zeroes and denormals too, which
+    // the flush leaves as they are, and never NaNs or infinities.
+    {
+      const auto exp = gpr.GetScopedReg();
+      XSXEXPDP(exp, reg);
+      CMPLDI(CRF::CR1, exp, 0x381);
+    }
+    CRANDC(CRBit(CRF::CR1, CCFlags::LT), CRBit(CRF::CR1, CCFlags::LT),
+           CRBit(CRF::CR4, CCFlags::EQ));
+    const FixupBranch flush = BCFar(CCFlags::LT, CRF::CR1);
+    const u8* round = GetCodePtr();
+    XSRSP(reg, reg);
+
+    SwitchToFarCode();
+    SetJumpTarget(flush);
+    FlushToSignedZero(reg);
+    // Rounding leaves a zero as it is.
+    B(round);
+    SwitchToNearCode();
+    return;
+  }
+
+  const FixupBranch ni = BCFar(CCFlags::NE, CRF::CR4);
+  const u8* round = GetCodePtr();
+  XSRSP(reg, reg);
+  const u8* done = GetCodePtr();
+
+  SwitchToFarCode();
+  SetJumpTarget(ni);
+  {
+    const auto bits = gpr.GetScopedReg();
+    const auto tmp = gpr.GetScopedReg();
+    const auto smallest_normal = gpr.GetScopedReg();
+    MFVSRD(bits, reg);
+    CLRLDI(tmp, bits, 1);
+    LIS(smallest_normal, 0x3810);
+    SLDI(smallest_normal, smallest_normal, 32);
+    CMPLD(CRF::CR1, tmp, smallest_normal);
+    const FixupBranch normal = BC(CCFlags::GE, CRF::CR1);
+    RLDICR(bits, bits, 0, 0);
+    MTVSRD(reg, bits);
+    B(done);
+    SetJumpTarget(normal);
+  }
+  B(round);
+  SwitchToNearCode();
+}
+
+void JitPPC64::ConvertSinglesToDoubles(VSR out, VSR in, bool quiet)
+{
+  if (quiet)
+  {
+    XVCVSPDP(out, in);
+    return;
+  }
+  // xscvspdpn converts word 0 without quieting.
+  XSCVSPDPN(VSR::VS2, in);
+  XXSLDWI(VSR::VS3, in, in, 2);
+  XSCVSPDPN(VSR::VS3, VSR::VS3);
+  XXPERMDI(out, VSR::VS2, VSR::VS3, 0);
+}
+
+void JitPPC64::ConvertDoublesToSingles(VSR out, VSR in)
+{
+  // POWER9 and Power10 copy words 0 and 2 into words 1 and 3, which Power ISA 2.07 leaves
+  // undefined.
+  XVCVDPSP(out, in);
+  if (!m_isa_3_0)
+    VMRGEW(out, out, out);
+}
+
+void JitPPC64::InterpretFromFarCode(UGeckoInstruction inst, const u8* done)
+{
+  InterpretFromFarCode(inst, done, fpr.HoldsSingles(inst.FD));
+}
+
+void JitPPC64::InterpretFromFarCode(UGeckoInstruction inst, const u8* done, bool fd_was_single)
+{
+  // The interpreter may set FPSCR's flags, and leave FD as it was. Storing all of FA, FB, FC and
+  // FD stores whatever registers those fields name, which is harmless for fields an instruction
+  // doesn't use, and for an FD that it only writes, which may hold anything if it was just bound.
+  for (const u32 reg : {u32(inst.FA), u32(inst.FB), u32(inst.FC)})
+  {
+    if (reg != inst.FD)
+      fpr.EmitStoreValue(reg);
+  }
+  fpr.EmitStoreValue(inst.FD, fd_was_single);
+  {
+    const BitSet32 saved = SaveScratchRegs();
+    ABI_CallFunction(Interpreter::GetInterpreterOp(inst), &m_system.GetInterpreter(), inst.hex);
+    RestoreScratchRegs(saved);
+  }
+  fpr.EmitLoadValue(inst.FD);
+  if (ShouldHandleFPExceptionForInstruction(js.op))
+    WriteConditionalExceptionExit(EXCEPTION_PROGRAM);
+  B(done);
+}
+
+void JitPPC64::Force25Bit(VSR out, VSR in)
+{
+  // Force25Bit computes (x & 0xfffffffff8000000) + (x & 0x8000000): the mask keeps bit 27, which
+  // is also the rounding bit, so this is (x + 0x8000000) & 0xfffffffff0000000, which rounds to
+  // nearest, ties away from zero, at bit 28.
+  const auto bits = gpr.GetScopedReg();
+  const auto exp = gpr.GetScopedReg();
+  MFVSRD(bits, in);
+  RLDICL(exp, bits, 12, 53, true);
+  const FixupBranch denormal_or_zero = BCFar(CCFlags::EQ, CRF::CR0);
+  ADDIS(bits, bits, 0x800);
+  RLDICR(bits, bits, 0, 35);
+  const u8* done = GetCodePtr();
+  MTVSRD(out, bits);
+
+  // Denormals are normalized first, which moves the mask and the rounding bit down by the number of
+  // leading zeroes of the fraction. For zeroes, this leaves the value as it is.
+  SwitchToFarCode();
+  SetJumpTarget(denormal_or_zero);
+  {
+    const auto keep_mask = gpr.GetScopedReg();
+    const auto round = gpr.GetScopedReg();
+    CLRLDI(exp, bits, 12);
+    CNTLZD(exp, exp);
+    ADDI(exp, exp, -11);
+    LI(keep_mask, -1);
+    SLDI(keep_mask, keep_mask, 28);
+    SRAD(keep_mask, keep_mask, exp);
+    LIS(round, 0x800);
+    SRD(round, round, exp);
+    ADD(bits, bits, round);
+    AND(bits, bits, keep_mask);
+  }
+  B(done);
+  SwitchToNearCode();
+}
+
+void JitPPC64::SetFPRF(VSR value, bool single)
+{
+  // As PowerPCState::UpdateFPRFDouble or UpdateFPRFSingle. The JITs don't set FPSCR's other status
+  // bits.
+  // With Power ISA 3.0, the routine tests the value in VS0, which isn't allocated.
+  if (m_isa_3_0)
+    XXLMR(VSR::VS0, value);
+  else
+    MFVSRD(GPR::R3, value);
+  BL(Routine(single ? m_fprf_single_routine : m_fprf_double_routine));
+}
+
+void JitPPC64::SetFPCCFromHostFloatCompare(CRF host_field)
+{
+  // FPCC, bits 12-15 of FPSCR, gets the compare's FL, FG, FE and FU, as the guest's CR field does.
+  const auto field = gpr.GetScopedReg();
+  const auto fpscr = gpr.GetScopedReg();
+  MFOCRF(field, host_field);
+  RLWINM(field, field, (4 * DecodeReg(host_field) + 4) % 32, 28, 31);
+  LWZ(fpscr, PPC_REG, PPCSTATE_OFF(fpscr));
+  RLWIMI(fpscr, field, 12, 16, 19);
+  STW(fpscr, PPC_REG, PPCSTATE_OFF(fpscr));
+}
+
+void JitPPC64::SetCRFieldFromHostFloatCompare(u32 field, CRF host_field)
+{
+  // The host field holds FL, FG, FE and FU, as the guest's does.
+  const auto tmp = gpr.GetScopedReg();
+  MFOCRF(tmp, host_field);
+  RLWINM(tmp, tmp, (4 * DecodeReg(host_field) + 4) % 32, 28, 31);
+  SetCRField(field, tmp);
+}
+
+void JitPPC64::EmitFloatArith(u32 op5, bool single, bool round_c, VSR result, VSR a, VSR b, VSR c)
+{
+  const bool use_c = op5 >= 25;  // fmul and the fused multiply-adds
+  const bool use_b = op5 != 25;  // fmul doesn't use B
+  const bool fma = use_b && use_c;
+  const bool negate = op5 == 30 || op5 == 31;
+  const bool subtract_b = op5 == 28 || op5 == 30;
+
+  PPC64FPRCache::ScopedReg rounded_c;
+  VSR c_operand = c;
+  if (round_c)
+  {
+    rounded_c = fpr.GetScopedReg();
+    Force25Bit(rounded_c, c);
+    c_operand = rounded_c;
+  }
+
+  switch (op5)
+  {
+  case 18:
+    XSDIVDP(result, a, b);
+    break;
+  case 20:
+    XSSUBDP(result, a, b);
+    break;
+  case 21:
+    XSADDDP(result, a, b);
+    break;
+  case 25:
+    XSMULDP(result, a, c_operand);
+    break;
+  default:
+    // xsmaddadp and friends compute result = a * c + result. For double precision, the host's
+    // negated forms round before negating, and don't negate NaNs, as the guest's do; for single
+    // precision, the negation has to come after rounding to single precision.
+    XXLMR(result, b);
+    if (single || !negate)
+      subtract_b ? XSMSUBADP(result, a, c_operand) : XSMADDADP(result, a, c_operand);
+    else
+      subtract_b ? XSNMSUBADP(result, a, c_operand) : XSNMADDADP(result, a, c_operand);
+    break;
+  }
+
+  if (single && fma)
+  {
+    // With a rounded C, a NaN C gives a NaN result made from C before it was rounded.
+    if (round_c)
+    {
+      XSCMPUDP(CRF::CR1, result, result);
+      const FixupBranch nan = BCFar(CCFlags::SO, CRF::CR1);
+      const u8* done = GetCodePtr();
+
+      SwitchToFarCode();
+      SetJumpTarget(nan);
+      XSCMPUDP(CRF::CR1, a, b);
+      const FixupBranch a_or_b_nan = BC(CCFlags::SO, CRF::CR1);
+      XSCMPUDP(CRF::CR1, c, c);
+      const FixupBranch c_not_nan = BC(CCFlags::NS, CRF::CR1);
+      // Quiet C.
+      XSADDDP(result, c, c);
+      SetJumpTarget(a_or_b_nan);
+      SetJumpTarget(c_not_nan);
+      B(done);
+      SwitchToNearCode();
+    }
+
+    if (m_accurate_fmadds)
+    {
+      // Correct ties, as NI_madd_msub: when the low 29 bits of the double precision result are a
+      // tie for rounding to single precision, nudge it by one in the direction of the error that
+      // rounding the fused multiply-add to double precision made.
+      const auto bits = gpr.GetScopedReg();
+      MFVSRD(bits, result);
+      CLRLDI(bits, bits, 35);
+      XORIS(bits, bits, 0x1000);
+      CMPLDI(CRF::CR1, bits, 0);
+      const FixupBranch tie = BCFar(CCFlags::EQ, CRF::CR1);
+      const u8* done = GetCodePtr();
+
+      SwitchToFarCode();
+      SetJumpTarget(tie);
+      {
+        const auto b_sign = fpr.GetScopedReg();
+        const auto a_prime = fpr.GetScopedReg();
+        const auto b_prime = fpr.GetScopedReg();
+        const auto delta_a = fpr.GetScopedReg();
+        if (subtract_b)
+          XSNEGDP(b_sign, b);
+        else
+          XXLMR(b_sign, b);
+        XSSUBDP(a_prime, b_sign, result);
+        XSADDDP(b_prime, result, a_prime);
+        XXLMR(delta_a, a_prime);
+        XSMADDADP(delta_a, a, c_operand);
+        XSSUBDP(b_prime, b_sign, b_prime);   // delta_b
+        XSADDDP(a_prime, delta_a, b_prime);  // error
+
+        // if (error != 0) bits += (error > 0) == (result > 0) ? 1 : -1;
+        XXLXOR(b_sign, b_sign, b_sign);
+        XSCMPUDP(CRF::CR1, a_prime, b_sign);
+        const FixupBranch no_error = BC(CCFlags::EQ, CRF::CR1);
+        XSCMPUDP(CRF::CR0, result, b_sign);
+        CREQV(CRBit(CRF::CR1, CCFlags::LT), CRBit(CRF::CR1, CCFlags::GT),
+              CRBit(CRF::CR0, CCFlags::GT));
+        MFVSRD(bits, result);
+        ADDI(bits, bits, 1);
+        const FixupBranch up = BC(CCFlags::LT, CRF::CR1);
+        ADDI(bits, bits, -2);
+        SetJumpTarget(up);
+        MTVSRD(result, bits);
+        SetJumpTarget(no_error);
+      }
+      B(done);
+      SwitchToNearCode();
+    }
+  }
+
+  if (single)
+  {
+    ForceSingle(result);
+    if (negate)
+    {
+      XSCMPUDP(CRF::CR1, result, result);
+      const FixupBranch nan = BC(CCFlags::SO, CRF::CR1);
+      XSNEGDP(result, result);
+      SetJumpTarget(nan);
+    }
+  }
+  else
+  {
+    ForceDouble(result);
+  }
+}
+
+bool JitPPC64::IsSingle(u32 reg) const
+{
+  // As the analyzer says, but for the result of fres or ps_res, which keeps a NaN input as it is,
+  // as a double, which the interpreter then rounds as a multiplicand. Jit64 doesn't.
+  if (!js.op->fprIsSingle[reg])
+    return false;
+  for (const PPCAnalyst::CodeOp* op = js.op; op != m_code_buffer.data();)
+  {
+    --op;
+    if (op->fregOut == static_cast<s8>(reg))
+      return !((op->inst.OPCD == 59 || op->inst.OPCD == 4) && op->inst.SUBOP5 == 24);
+  }
+  return true;
+}
+
+void JitPPC64::fp_arith(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITFloatingPointOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions || (jo.div_by_zero_exceptions && inst.SUBOP5 == 18));
+
+  const u32 op5 = inst.SUBOP5;
+  const bool single = inst.OPCD == 59;
+  const bool use_c = op5 >= 25;  // fmul and the fused multiply-adds
+  const bool use_b = op5 != 25;  // fmul doesn't use B
+  const bool round_c = single && use_c && !fpr.HoldsSingles(inst.FC) && !IsSingle(inst.FC);
+
+  PPC64FPRCache::ScopedReg a_doubles, b_doubles, c_doubles;
+  const VSR a = fpr.RForArith(inst.FA, a_doubles);
+  const VSR b = use_b ? fpr.RForArith(inst.FB, b_doubles) : VSR::VS0;
+  const VSR c = use_c ? fpr.RForArith(inst.FC, c_doubles) : VSR::VS0;
+  // Double precision instructions only write ps0.
+  const VSR d = fpr.RW(inst.FD, !single);
+
+  const auto result = fpr.GetScopedReg();
+  EmitFloatArith(op5, single, round_c, result, a, b, c);
+  if (single)
+    XXPERMDI(d, result, result, 0);
+  else
+    XXPERMDI(d, result, d, 1);
+  if (m_fprf && js.op->wantsFPRF)
+    SetFPRF(result, single);
+}
+
+void JitPPC64::fp_logic(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITFloatingPointOff);
+  INTERPRET_IF(inst.Rc);
+
+  // These only change the sign bit, of ps0, or of both halves for the paired single forms, which
+  // keep singles as singles. The others do too, if FD holds singles.
+  const bool paired = inst.OPCD == 4;
+  if (fpr.HoldsSingles(inst.FB) && (paired || fpr.HoldsSingles(inst.FD)))
+  {
+    const VSR b = fpr.RSingle(inst.FB);
+    const bool quiet = fpr.IsQuiet(inst.FB) && (paired || fpr.IsQuiet(inst.FD));
+    const VSR d = fpr.BindForSingles(inst.FD);
+    // The scalar forms merge ps0 into FD.
+    PPC64FPRCache::ScopedReg half0;
+    if (!paired)
+      half0 = fpr.GetScopedReg();
+    const VSR result = paired ? d : VSR(half0);
+    switch (inst.SUBOP10)
+    {
+    case 40:  // fneg, ps_neg
+      XVNEGSP(result, b);
+      break;
+    case 72:  // fmr, ps_mr
+      if (result != b)
+        XXLMR(result, b);
+      break;
+    case 136:  // fnabs, ps_nabs
+      XVNABSSP(result, b);
+      break;
+    case 264:  // fabs, ps_abs
+      XVABSSP(result, b);
+      break;
+    default:
+      ASSERT_MSG(DYNA_REC, false, "Unexpected instruction {:#010x}", inst.hex);
+      break;
+    }
+    if (!paired)
+      XXPERMDI(d, result, d, 1);
+    fpr.MarkSingles(inst.FD, quiet);
+    return;
+  }
+
+  // Otherwise, as doubles: ps0 of a single is converted, exactly, into a scratch register.
+  PPC64FPRCache::ScopedReg b_ps0;
+  VSR b;
+  if (!paired && fpr.HoldsSingles(inst.FB))
+  {
+    b_ps0 = fpr.GetScopedReg();
+    XSCVSPDPN(b_ps0, fpr.RSingle(inst.FB));
+    b = b_ps0;
+  }
+  else
+  {
+    b = fpr.R(inst.FB);
+  }
+  const VSR d = fpr.RW(inst.FD, !paired);
+
+  if (paired)
+  {
+    switch (inst.SUBOP10)
+    {
+    case 40:  // ps_neg
+      XVNEGDP(d, b);
+      break;
+    case 72:  // ps_mr
+      if (d != b)
+        XXLMR(d, b);
+      break;
+    case 136:  // ps_nabs
+      XVNABSDP(d, b);
+      break;
+    case 264:  // ps_abs
+      XVABSDP(d, b);
+      break;
+    default:
+      ASSERT_MSG(DYNA_REC, false, "Unexpected instruction {:#010x}", inst.hex);
+      break;
+    }
+    return;
+  }
+
+  const auto result = fpr.GetScopedReg();
+  switch (inst.SUBOP10)
+  {
+  case 40:  // fneg
+    XSNEGDP(result, b);
+    break;
+  case 72:  // fmr
+    XXLMR(result, b);
+    break;
+  case 136:  // fnabs
+    XSNABSDP(result, b);
+    break;
+  case 264:  // fabs
+    XSABSDP(result, b);
+    break;
+  default:
+    ASSERT_MSG(DYNA_REC, false, "Unexpected instruction {:#010x}", inst.hex);
+    break;
+  }
+  XXPERMDI(d, result, d, 1);
+}
+
+void JitPPC64::fselx(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITFloatingPointOff);
+  INTERPRET_IF(inst.Rc);
+
+  const VSR a = fpr.R(inst.FA);
+  const VSR b = fpr.R(inst.FB);
+  const VSR c = fpr.R(inst.FC);
+  const VSR d = fpr.RW(inst.FD, true);
+
+  // d.ps0 = a >= -0.0 ? c : b, which is b if a is a NaN.
+  const auto mask = fpr.GetScopedReg();
+  const auto result = fpr.GetScopedReg();
+  XXLXOR(mask, mask, mask);
+  XVCMPGEDP(mask, a, mask);
+  XXSEL(result, b, c, mask);
+  XXPERMDI(d, result, d, 1);
+}
+
+void JitPPC64::frspx(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITFloatingPointOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions);
+
+  PPC64FPRCache::ScopedReg b_doubles;
+  const VSR b = fpr.RForArith(inst.FB, b_doubles);
+  const VSR d = fpr.RW(inst.FD);
+
+  const auto result = fpr.GetScopedReg();
+  XXLMR(result, b);
+  ForceSingle(result);
+  XXPERMDI(d, result, result, 0);
+  if (m_fprf && js.op->wantsFPRF)
+    SetFPRF(result, true);
+}
+
+void JitPPC64::fctiwx(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITFloatingPointOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions);
+
+  const bool round_toward_zero = inst.SUBOP10 == 15;
+  PPC64FPRCache::ScopedReg b_doubles;
+  const VSR b = fpr.RForArith(inst.FB, b_doubles);
+  const VSR d = fpr.RW(inst.FD, true);
+
+  // The host's fctiw and fctiwz round and saturate as the guest's do, with 0x80000000 for NaNs,
+  // but they only work on F0-F31, so use F0, which isn't allocated, and leave the upper half of
+  // the result undefined.
+  XXLMR(VSR::VS0, b);
+  if (round_toward_zero)
+    FCTIWZ(FPR::F0, FPR::F0);
+  else
+    FCTIW(FPR::F0, FPR::F0);
+
+  // As ConvertToInteger: 0xfff8000000000000 | value, with bit 32 set for a zero from a negative
+  // operand.
+  const auto value = gpr.GetScopedReg();
+  const auto tmp = gpr.GetScopedReg();
+  MFVSRD(value, VSR::VS0);
+  CLRLDI(value, value, 32);
+  MFVSRD(tmp, b);
+  SRDI(tmp, tmp, 63);
+  {
+    const auto is_zero = gpr.GetScopedReg();
+    CNTLZW(is_zero, value);
+    SRWI(is_zero, is_zero, 5);
+    AND(tmp, tmp, is_zero);
+  }
+  SLDI(tmp, tmp, 32);
+  OR(value, value, tmp);
+  MOVI2R(tmp, 0xFFF8000000000000);
+  OR(value, value, tmp);
+  MTVSRD(VSR::VS0, value);
+  XXPERMDI(d, VSR::VS0, d, 1);
+}
+
+void JitPPC64::fcmpX(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITFloatingPointOff);
+  FALLBACK_IF(jo.fp_exceptions);
+
+  PPC64FPRCache::ScopedReg a_doubles, b_doubles;
+  const VSR a = fpr.RForArith(inst.FA, a_doubles);
+  const VSR b = fpr.RForArith(inst.FB, b_doubles);
+
+  XSCMPUDP(CRF::CR1, a, b);
+  // With FPRF, fcmpu and fcmpo set FPSCR[FPCC].
+  if (m_fprf)
+    SetFPCCFromHostFloatCompare(CRF::CR1);
+  SetCRFieldFromHostFloatCompare(inst.CRFD, CRF::CR1);
+}
+
+void JitPPC64::ps_mergeXX(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITPairedOff);
+  INTERPRET_IF(inst.Rc);
+
+  // ps_merge00: a.ps0, b.ps0; 01: a.ps0, b.ps1; 10: a.ps1, b.ps0; 11: a.ps1, b.ps1. xxpermdi
+  // picks the doubleword of A with bit 1 of its DM field, and of B with bit 0, which holds a half
+  // as a double, or as a single twice.
+  const u32 dm = (inst.SUBOP10 - 528) / 32;
+  ASSERT_MSG(DYNA_REC, dm < 4, "Unexpected instruction {:#010x}", inst.hex);
+  if (fpr.HoldsSingles(inst.FA) && fpr.HoldsSingles(inst.FB))
+  {
+    const VSR a = fpr.RSingle(inst.FA);
+    const VSR b = fpr.RSingle(inst.FB);
+    const bool quiet = fpr.IsQuiet(inst.FA) && fpr.IsQuiet(inst.FB);
+    XXPERMDI(fpr.BindForSingles(inst.FD), a, b, dm);
+    fpr.MarkSingles(inst.FD, quiet);
+    return;
+  }
+
+  const VSR a = fpr.R(inst.FA);
+  const VSR b = fpr.R(inst.FB);
+  XXPERMDI(fpr.RW(inst.FD), a, b, dm);
+}
+
+void JitPPC64::EmitEstimate(UGeckoInstruction inst, bool rsqrte, bool paired)
+{
+  // The routines estimate each half. For inputs they leave to the interpreter, call the instruction
+  // in the interpreter from far code.
+  const VSR b = fpr.R(inst.FB);
+  const VSR d = fpr.RW(inst.FD, true);
+  // ps_rsqrte rounds to single precision, depending on FPSCR[NI], on one path only.
+  if (paired && rsqrte)
+    EnsureNILoaded();
+
+  const u8* routine = rsqrte ? m_frsqrte_routine : m_fres_routine;
+  const auto half0 = gpr.GetScopedReg();
+  const auto half1 = gpr.GetScopedReg();
+  // With Power ISA 3.0, the routines test the input in VS0 too.
+  MFVSRD(GPR::R3, b);
+  if (m_isa_3_0)
+    XXLMR(VSR::VS0, b);
+  BL(Routine(routine));
+  MR(half0, GPR::R3);
+  MR(half1, GPR::R4);
+  if (paired)
+  {
+    if (m_isa_3_0)
+    {
+      MFVSRLD(GPR::R3, b);
+      XXSWAPD(VSR::VS0, b);
+    }
+    else
+    {
+      const auto b1 = fpr.GetScopedReg();
+      XXSWAPD(b1, b);
+      MFVSRD(GPR::R3, b1);
+    }
+    BL(Routine(routine));
+    OR(GPR::R4, GPR::R4, half1);
+    MR(half1, GPR::R3);
+  }
+  else
+  {
+    MR(GPR::R4, half1);
+  }
+  CMPDI(CRF::CR1, GPR::R4, 0);
+  const FixupBranch interpret = BCFar(CCFlags::NE, CRF::CR1);
+
+  if (m_isa_3_0 && !rsqrte)
+  {
+    // ps_res and fres write both halves, which mtvsrdd sets from GPRs.
+    MTVSRDD(d, half0, paired ? half1 : half0);
+    if (m_fprf && js.op->wantsFPRF)
+      SetFPRF(d, true);
+  }
+  else
+  {
+    const auto result0 = fpr.GetScopedReg();
+    const auto result1 = fpr.GetScopedReg();
+    MTVSRD(result0, half0);
+    if (paired)
+    {
+      MTVSRD(result1, half1);
+      if (rsqrte)
+      {
+        // ps_rsqrte rounds its estimates to single precision; ps_res's are single already.
+        ForceSingle(result0);
+        ForceSingle(result1);
+      }
+      XXPERMDI(d, result0, result1, 0);
+    }
+    else if (rsqrte)
+    {
+      // frsqrte writes ps0.
+      XXPERMDI(d, result0, d, 1);
+    }
+    else
+    {
+      // fres writes both halves.
+      XXPERMDI(d, result0, result0, 0);
+    }
+    if (m_fprf && js.op->wantsFPRF)
+      SetFPRF(result0, !(rsqrte && !paired));
+  }
+  const u8* done = GetCodePtr();
+
+  SwitchToFarCode();
+  SetJumpTarget(interpret);
+  InterpretFromFarCode(inst, done);
+  SwitchToNearCode();
+}
+
+void JitPPC64::fresx(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITFloatingPointOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions);
+  EmitEstimate(inst, false, false);
+}
+
+void JitPPC64::frsqrtex(UGeckoInstruction inst)
+{
+  INSTRUCTION_START
+  JITDISABLE(bJITFloatingPointOff);
+  INTERPRET_IF(inst.Rc);
+  FALLBACK_IF(jo.fp_exceptions);
+  EmitEstimate(inst, true, false);
+}
