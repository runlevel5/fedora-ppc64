From fff85e760c515ea646d8cf0436d70037dbc87bfe Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Tue, 3 Nov 2026 17:12:40 +1100
Subject: [PATCH] Build against the .NET that Fedora ships

Fedora has no .NET 8, so the runner cannot be built for net8.0. Target
net10.0, and publish framework-dependent so that the runtime comes
from the distribution and is updated with it rather than being
bundled. global.json rolls forward to whichever patch level the SDK
is at. Warnings are no longer errors: a newer compiler finds warnings
this code predates, and a distribution build should not fail on them.
---
 src/Directory.Build.props                      | 2 +-
 src/Runner.Common/Runner.Common.csproj         | 2 +-
 src/Runner.Listener/Runner.Listener.csproj     | 4 ++--
 src/Runner.PluginHost/Runner.PluginHost.csproj | 4 ++--
 src/Runner.Plugins/Runner.Plugins.csproj       | 4 ++--
 src/Runner.Sdk/Runner.Sdk.csproj               | 4 ++--
 src/Runner.Worker/Runner.Worker.csproj         | 4 ++--
 src/Sdk/Sdk.csproj                             | 2 +-
 src/Test/Test.csproj                           | 2 +-
 src/global.json                                | 3 ++-
 10 files changed, 16 insertions(+), 15 deletions(-)

diff --git a/src/Directory.Build.props b/src/Directory.Build.props
index d26b0dc..74a891b 100644
--- a/src/Directory.Build.props
+++ b/src/Directory.Build.props
@@ -61,7 +61,7 @@
 
   <!-- Set Treat tarnings as errors -->
   <PropertyGroup>
-    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
+    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
   </PropertyGroup>
 
   <PropertyGroup>
diff --git a/src/Runner.Common/Runner.Common.csproj b/src/Runner.Common/Runner.Common.csproj
index 9c087c8..61141d4 100644
--- a/src/Runner.Common/Runner.Common.csproj
+++ b/src/Runner.Common/Runner.Common.csproj
@@ -1,7 +1,7 @@
 <Project Sdk="Microsoft.NET.Sdk">
 
   <PropertyGroup>
-    <TargetFramework>net8.0</TargetFramework>
+    <TargetFramework>net10.0</TargetFramework>
     <OutputType>Library</OutputType>
     <RuntimeIdentifiers>win-x64;win-x86;linux-x64;linux-arm64;linux-arm;osx-x64;osx-arm64;win-arm64</RuntimeIdentifiers>
     <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
diff --git a/src/Runner.Listener/Runner.Listener.csproj b/src/Runner.Listener/Runner.Listener.csproj
index b532500..2288ecc 100644
--- a/src/Runner.Listener/Runner.Listener.csproj
+++ b/src/Runner.Listener/Runner.Listener.csproj
@@ -1,10 +1,10 @@
 <Project Sdk="Microsoft.NET.Sdk">
 
   <PropertyGroup>
-    <TargetFramework>net8.0</TargetFramework>
+    <TargetFramework>net10.0</TargetFramework>
     <OutputType>Exe</OutputType>
     <RuntimeIdentifiers>win-x64;win-x86;linux-x64;linux-arm64;linux-arm;osx-x64;osx-arm64;win-arm64</RuntimeIdentifiers>
-    <SelfContained>true</SelfContained>
+    <SelfContained>false</SelfContained>
     <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
     <NoWarn>NU1701;NU1603;SYSLIB0050;SYSLIB0051</NoWarn>
     <Version>$(Version)</Version>
