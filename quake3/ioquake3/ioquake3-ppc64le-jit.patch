From d2eef0c1689d507e25d3b002009ecb958e496e33 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Fri, 14 Aug 2026 18:07:26 +1000
Subject: [PATCH 2/2] Use POWER8 GPR-FPR moves for VM float conversions

When built with -mcpu=power8 or newer, emit mtvsrwa+fcfids for OP_CVIF
and fctiwz+mfvsrwz for OP_CVFI instead of the classic double-magic
sequences, removing the stack round-trips. Add a PPC64LE_CPU cmake
option (power8/power9/power10/native) and schedule for POWER9 by
default while keeping the POWER8 baseline.

A -mcpu already given in CFLAGS, as distribution packagers do, is left
alone.
---
 cmake/compilers/gnu.cmake | 18 ++++++++++++++----
 code/qcommon/vm_powerpc.c | 20 ++++++++++++++++++++
 2 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/cmake/compilers/gnu.cmake b/cmake/compilers/gnu.cmake
index 246b2c48..4efda00c 100644
--- a/cmake/compilers/gnu.cmake
+++ b/cmake/compilers/gnu.cmake
@@ -27,9 +27,19 @@ add_compile_options(-fno-strict-aliasing)
 add_compile_options(-fvisibility=hidden)
 
 # ppc64le: target POWER8 as baseline (the ppc64le minimum), which enables
-# VSX/Altivec.  Big-endian ppc64 is left at the compiler default so builds
-# keep working on pre-POWER8 CPUs (970/G5, POWER5-7).
+# VSX/Altivec.  PPC64LE_CPU can raise the baseline (power9, power10,
+# native) for machine-specific builds.  Big-endian ppc64 is left at the
+# compiler default so builds keep working on pre-POWER8 CPUs
+# (970/G5, POWER5-7).  A -mcpu given in CFLAGS (as distribution packagers
+# do) is left alone.
 include(utils/arch)
-if(ARCH STREQUAL "ppc64" AND CMAKE_C_BYTE_ORDER STREQUAL "LITTLE_ENDIAN")
-    add_compile_options(-mcpu=power8)
