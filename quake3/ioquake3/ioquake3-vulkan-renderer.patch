+void RE_SetColor( const float *rgba )
+{
+    if ( !tr.registered ) {
+        return;
+    }
+    
+    setColorCommand_t* cmd = (setColorCommand_t*) R_GetCommandBuffer( sizeof(setColorCommand_t) );
+	if ( !cmd ) {
+		return;
+	}
+	cmd->commandId = RC_SET_COLOR;
+	
+    if(rgba)
+    {
+        cmd->color[0] = rgba[0];
+        cmd->color[1] = rgba[1];
+        cmd->color[2] = rgba[2];
+        cmd->color[3] = rgba[3];
+    }
+    else
+    {
+        // color white
+        cmd->color[0] = 1.0f;
+        cmd->color[1] = 1.0f;
+        cmd->color[2] = 1.0f;
+        cmd->color[3] = 1.0f;
+    }
