+    out_color = frag_color * texture(texture0, frag_tex_coord);
+
+    if (alpha_test_func == 1) {
+        if (out_color.a == 0.0f) discard;
+    } else if (alpha_test_func == 2) {
+        if (out_color.a >= 0.5f) discard;
+    } else if (alpha_test_func == 3) {
+        if (out_color.a < 0.5f) discard;
+    }
+}
