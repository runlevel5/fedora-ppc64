+    
+    VkMemoryRequirements ib_memory_requirements;
+    qvkGetBufferMemoryRequirements(vk.device, shadingDat.index_buffer, &ib_memory_requirements);
+
+    uint32_t memory_type_bits = ib_memory_requirements.memoryTypeBits;
