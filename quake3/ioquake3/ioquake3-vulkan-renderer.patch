+	// the origin of the camera
+	for ( i = 0 ; i < tr.refdef.num_entities ; i++ ) 
+	{
+		trRefEntity_t* e = &tr.refdef.entities[i];
+		if ( e->e.reType != RT_PORTALSURFACE ) {
