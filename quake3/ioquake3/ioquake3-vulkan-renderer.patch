+
+	ri = *rimp;
+
+	if( apiVersion != REF_API_VERSION )
+	{
+		ri.Printf(PRINT_ALL, "Mismatched REF_API_VERSION: expected %i, got %i\n", REF_API_VERSION, apiVersion );
