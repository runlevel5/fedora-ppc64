diff --git a/cmake/toolchains/linux-ppc64le-clang.cmake b/cmake/toolchains/linux-ppc64le-clang.cmake
new file mode 100644
index 0000000..85f5f6f
--- /dev/null
+++ b/cmake/toolchains/linux-ppc64le-clang.cmake
@@ -0,0 +1,11 @@
+set(CMAKE_C_COMPILER clang)
+set(CMAKE_CXX_COMPILER clang++)
+
+# Native build - prevent CMake from treating this as cross-compilation
+set(CMAKE_CROSSCOMPILING FALSE)
+
+# 64-bit little-endian, baseline POWER8 (the first CPU to support ppc64le).
+set(CMAKE_C_FLAGS_INIT   "-m64 -mcpu=power8")
+set(CMAKE_CXX_FLAGS_INIT "-m64 -mcpu=power8")
+
+set(CMAKE_SYSTEM_PROCESSOR ppc64le CACHE STRING "")
diff --git a/cmake/vcpkg-triplets/ppc64le-linux-clang.cmake b/cmake/vcpkg-triplets/ppc64le-linux-clang.cmake
new file mode 100644
index 0000000..31d6697
--- /dev/null
+++ b/cmake/vcpkg-triplets/ppc64le-linux-clang.cmake
@@ -0,0 +1,9 @@
+set(VCPKG_TARGET_ARCHITECTURE ppc64le)
+set(VCPKG_CRT_LINKAGE dynamic)
+set(VCPKG_LIBRARY_LINKAGE static)
+set(VCPKG_CMAKE_SYSTEM_NAME Linux)
+set(VCPKG_CMAKE_CONFIGURE_OPTIONS "-DCMAKE_POSITION_INDEPENDENT_CODE=ON")
+
+set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE
+    "${CMAKE_CURRENT_LIST_DIR}/../toolchains/linux-ppc64le-clang.cmake"
+)
