Add ORION2RE_USE_SYSTEM_LIBS to build with the system SDL3, libuv, lz4,
miniz, yyjson and Lua instead of the vendors/ submodules.

The targets the vendored libraries provide (SDL3::SDL3-static, uv_a,
orion2re_lz4, miniz, orion2re_lua) become interface targets of the same
names linking the system libraries, and yyjson gets an orion2re_yyjson
target in both modes. Dear ImGui, doctest and libsmacker stay vendored.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -112,10 +112,46 @@
 option(ORION2RE_RELEASE_DEBUG_INFO "Emit debug info for non-Debug MSVC builds" OFF)
 option(ORION2RE_BUILD_GAME "Build the SDL game executable" ON)
 option(ORION2RE_BUILD_TESTS "Build tests" OFF)
+option(ORION2RE_USE_SYSTEM_LIBS
+       "Use the system SDL3, libuv, lz4, miniz, yyjson and Lua instead of vendors/"
+       OFF)
+
+# The vendored libraries are built as these targets; with system libraries
+# they are interface targets of the same names.
+if(ORION2RE_USE_SYSTEM_LIBS)
+    find_package(PkgConfig REQUIRED)
+    find_package(SDL3 REQUIRED CONFIG COMPONENTS SDL3)
+    pkg_check_modules(ORION2RE_SYSTEM_LIBUV REQUIRED IMPORTED_TARGET libuv)
+    pkg_check_modules(ORION2RE_SYSTEM_LZ4 REQUIRED IMPORTED_TARGET liblz4)
+    pkg_check_modules(ORION2RE_SYSTEM_MINIZ REQUIRED IMPORTED_TARGET miniz)
+    pkg_check_modules(ORION2RE_SYSTEM_YYJSON REQUIRED IMPORTED_TARGET yyjson)
+    pkg_check_modules(ORION2RE_SYSTEM_LUA REQUIRED IMPORTED_TARGET lua)
+
+    add_library(SDL3::SDL3-static INTERFACE IMPORTED)
+    target_link_libraries(SDL3::SDL3-static INTERFACE SDL3::SDL3)
+    add_library(uv_a INTERFACE)
+    target_link_libraries(uv_a INTERFACE PkgConfig::ORION2RE_SYSTEM_LIBUV)
+    add_library(orion2re_lz4 INTERFACE)
+    target_link_libraries(orion2re_lz4 INTERFACE PkgConfig::ORION2RE_SYSTEM_LZ4)
+    add_library(miniz INTERFACE)
+    target_link_libraries(miniz INTERFACE PkgConfig::ORION2RE_SYSTEM_MINIZ)
+    add_library(orion2re_yyjson INTERFACE)
+    target_link_libraries(orion2re_yyjson INTERFACE PkgConfig::ORION2RE_SYSTEM_YYJSON)
+    add_library(orion2re_lua INTERFACE)
+    target_link_libraries(orion2re_lua INTERFACE PkgConfig::ORION2RE_SYSTEM_LUA)
+
+    set(ORION2RE_YYJSON_SOURCES "")
+    set(ORION2RE_YYJSON_INCLUDE_DIRS "")
+else()
+    add_library(orion2re_yyjson INTERFACE)
+    set(ORION2RE_YYJSON_SOURCES "${ORION2RE_VENDORED_YYJSON_DIR}/src/yyjson.c")
+    set(ORION2RE_YYJSON_INCLUDE_DIRS "${ORION2RE_VENDORED_YYJSON_DIR}/src")
+endif()
+
