%prep
%setup -q -n %{tarballdir}
%if %{with wasi_sdk}
%setup -q -T -D -n %{tarballdir} -a 50
%endif

# Build patches, can't change backup suffix from default because during build
# there is a compare of config and js/config directories and .orig suffix is
# ignored during this compare.

%patch -P44 -p1 -b .build-arm-libopus
%patch -P71 -p1 -b .0001-GLIBCXX-fix-for-GCC-12
%patch -P78 -p1 -b .firefox-i686
%if 0%{?fedora} >= 44 || 0%{?rhel} >= 11
%patch -P85 -p1 -b .wasm32-wasip1
%endif

# We need to create the wasi.patch with the correct path to the wasm libclang_rt.
%if %{with wasi_sdk}
cat %{SOURCE49} | sed -e "s|LIBCLANG_RT_PLACEHOLDER|`pwd`/wasi-sdk-30/build/sysroot/install/wasi-resource-dir/lib/wasm32-unknown-wasip1/libclang_rt.builtins.a|" > %{_sourcedir}/wasi.patch
%patch -P80 -p1 -b .wasi
%endif
%patch -P90 -p2 -b .pgo-simple

# Fedora patches
%patch -P215 -p1 -b .addons
%patch -P219 -p1 -b .rhbz-1173156
#ARM run-time patch
%ifarch aarch64
%patch -P226 -p1 -b .1354671
%endif
%patch -P228 -p1 -b .disable-openh264-download
%patch -P229 -p1 -b .firefox-nss-addon-hack
%patch -P231 -p1 -b .fedora-customization

%patch -P400 -p1 -b .1196777
%patch -P401 -p1 -b .1667096

# PGO patches
%if %{build_with_pgo}
%if !%{with build_with_clang}
%patch -P600 -p2 -b .pgo
%patch -P602 -p1 -b .1516803
%endif
%endif
%patch -P603 -p1 -b .inline
%patch -P604 -p1 -b .0001-Bug-2085342-Hash-the-little-endian-ICU-data-in-icu-d

%ifarch ppc64le
%patch -P700 -p1 -b .ppc64-001
%patch -P701 -p1 -b .ppc64-002
%patch -P702 -p1 -b .ppc64-003
