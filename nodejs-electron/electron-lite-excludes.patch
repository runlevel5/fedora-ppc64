+
+# Generic test directory excludes for sub-repos (v8, angle, dawn, etc.)
+# Lite tarballs remove test directories from most third_party components
+GENERIC_TEST_EXCLUDES = [
+  'test/*',
+  'tests/*',
+  'resources/*',
+]
+
+def get_excludes_for_repo(repo):
+  if not USE_LITE_EXCLUDES:
+    return None
+  if repo == 'src':
+    return LITE_TARBALL_EXCLUDES
+  # ffmpeg is completely removed when building against system ffmpeg
+  if repo == 'src/third_party/ffmpeg':
+    return ['*']
+  # For all other repos, exclude common test directories
+  return GENERIC_TEST_EXCLUDES
 
