+static int findCacheSlot(dynarec_ppc64le_t* dyn, int ninst, int t, int n, vmxcache_t* cache)
+{
+    vmx_cache_t f;
+    f.n = n;
+    f.t = t;
+    for (int i = 0; i < 32; ++i) {
+        if (cache->vmxcache[i].v == f.v)
+            return i;
+        if (cache->vmxcache[i].n == n) {
+            switch (cache->vmxcache[i].t) {
+                case VMX_CACHE_ST_F:
+                    if (t == VMX_CACHE_ST_D)
+                        return i;
+                    if (t == VMX_CACHE_ST_I64)
+                        return i;
+                    break;
+                case VMX_CACHE_ST_D:
+                    if (t == VMX_CACHE_ST_F)
+                        return i;
+                    if (t == VMX_CACHE_ST_I64)
+                        return i;
+                    break;
+                case VMX_CACHE_ST_I64:
+                    if (t == VMX_CACHE_ST_F)
+                        return i;
+                    if (t == VMX_CACHE_ST_D)
+                        return i;
+                    break;
+                case VMX_CACHE_XMMR:
+                    if (t == VMX_CACHE_XMMW)
+                        return i;
+                    break;
+                case VMX_CACHE_XMMW:
+                    if (t == VMX_CACHE_XMMR)
+                        return i;
+                    break;
+                case VMX_CACHE_YMMR:
+                    if (t == VMX_CACHE_YMMW)
+                        return i;
+                    break;
+                case VMX_CACHE_YMMW:
+                    if (t == VMX_CACHE_YMMR)
+                        return i;
+                    break;
+            }
+        }
+    }
+    return -1;
