-    .long 0x31035088, 0xEC46FA30, 0x8E647309, 0x5321D9B1
-    .long 0x4A21617B, 0x9764CBC3, 0xF54642FA, 0x2803E842
+.type ppc64le_lock_cas_dq, @function
+ppc64le_lock_cas_dq:
+    mr      10, 7           // stqcx. pair r10:r11 = new_hi:new_lo
+    mr      11, 6
+    lwsync
+1:  lqarx   6, 0, 3         // r6 = current high, r7 = current low
+    cmpd    7, 8
+    bne-    2f
+    cmpd    6, 9
+    bne-    2f
+    stqcx.  10, 0, 3
+    bne-    1b
+    lwsync
+    li      3, 1
+    blr
+2:  std     7, 0(4)
+    std     6, 0(5)
+    lwsync
+    li      3, 0
+    blr
+.size ppc64le_lock_cas_dq, .-ppc64le_lock_cas_dq
