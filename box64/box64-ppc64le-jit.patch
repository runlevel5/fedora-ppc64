+                } else {
+                    FCOMD(v1, v2, x1, x2, x3);
+                }
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                break;
+            case 0xE0 ... 0xE7:
+                INST_NAME("FSUBRP STx, ST0");
+                v2 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v1 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                    FSUBS(v1, v2, v1);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                    FSUB(v1, v2, v1);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                break;
+            case 0xE8 ... 0xEF:
+                INST_NAME("FSUBP STx, ST0");
+                v2 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v1 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FSUBS(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FSUB(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                break;
+            case 0xF0 ... 0xF7:
+                INST_NAME("FDIVRP STx, ST0");
+                v2 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v1 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                    FDIVS(v1, v2, v1);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                    FDIV(v1, v2, v1);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                break;
+            case 0xF8 ... 0xFF:
+                INST_NAME("FDIVP STx, ST0");
+                v2 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v1 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FDIVS(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FDIV(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                break;
+            default:
+                DEFAULT;
+                break;
+        }
+    else
+        switch ((nextop >> 3) & 7) {
+            case 0:
+                INST_NAME("FIADD ST0, word[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x3, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LHZ(x2, fixedaddress, wback);
+                EXTSH(x2, x2);
+                MTVSRD(v2, x2);
+                FCFID(v2, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                FADD(v1, v1, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                break;
+            case 1:
+                INST_NAME("FIMUL ST0, word[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x3, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
