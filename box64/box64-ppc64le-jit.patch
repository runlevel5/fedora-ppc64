+// SPDX-License-Identifier: MIT
+// Native replacements for hot functions statically linked into specific 32-bit games.
+// A hook is only installed when the guest function is found in the main ELF symbol table
+// and its bytes match the exact build it was written for, so it can't affect anything else.
+// Disable with BOX64_GAMEHOOKS=0.
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <dlfcn.h>
+#include <pthread.h>
+
+#include "debug.h"
+#include "box64context.h"
+#include "elfloader.h"
+#include "bridge.h"
+#include "alternate.h"
+#include "box32.h"
+#include "x64emu.h"
+#include "wrapper32.h"
+#include "emu/x64emu_private.h"
+#include "emu/x87emu_private.h"
+#include "regs.h"
+
+static uint64_t fnv1a64(const uint8_t* p, size_t n)
+{
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (size_t i = 0; i < n; ++i)
+        h = (h ^ p[i]) * 0x100000001b3ULL;
+    return h;
+}
+
+// ---- libtheoraplayer 1.0 decodeRGBX (Grim Fandango Remastered, GOG Linux 2.3.0.7) ---------------
+// struct TheoraPixelTransform { unsigned char *raw, *y, *u, *v, *out; unsigned int w, h, rawStride, yStride, uStride, vStride; };
+typedef struct theora_pixel_transform32_s {
+    ptr_t raw, y, u, v, out;
+    uint32_t w, h, rawStride, yStride, uStride, vStride;
+} theora_pixel_transform32_t;
+
+// YUV->RGB tables filled at runtime by the game (libtheoraplayer's static int tables),
+// at the addresses the guest code uses (part of the verified bytes)
+static const int32_t* tG_V; // 0xb280054
+static const int32_t* tG_U; // 0xb280454
+static const int32_t* tR_V; // 0xb280854
+static const int32_t* tB_U; // 0xb280c54
+static const int32_t* tY;   // 0xb281054
+
+static inline uint8_t clamp13(int32_t s)
+{
+    int32_t x = s >> 13;
+    x = x < 0 ? 0 : x;     // same saturation as the guest code: <0 -> 0, >255 -> 255 (branch-free: isel)
+    x = x > 255 ? 255 : x;
+    return (uint8_t)x;
+}
+
+// YUV 4:2:0 -> RGBX, two rows per iteration, X bytes left untouched, output stride w*4.
+// All address arithmetic is done in 32 bits like the guest code.
+static void native_decodeRGBX(theora_pixel_transform32_t* t)
+{
+    const uint32_t w = t->w, h = t->h;
+    for (uint32_t row = 0; row < h; row += 2) {
+        if (!w) continue;
+        const uint8_t* y0 = from_ptrv((ptr_t)(t->y + t->yStride * row));
+        const uint8_t* y1 = from_ptrv((ptr_t)(t->y + t->yStride * (row + 1)));
+        const uint8_t* u = from_ptrv((ptr_t)(t->u + ((t->uStride * row) >> 1)));
+        const uint8_t* v = from_ptrv((ptr_t)(t->v + ((t->vStride * row) >> 1)));
+        uint8_t* o0 = from_ptrv((ptr_t)(t->out + w * 4 * row));
+        uint8_t* o1 = from_ptrv((ptr_t)(t->out + w * 4 * (row + 1)));
+        const uint32_t pairs = w / 2;
+        for (uint32_t j = 0; j < pairs; ++j) {
+            const int32_t rV = tR_V[v[j]];
+            const int32_t gUV = tG_V[v[j]] + tG_U[u[j]];
+            const int32_t bU = tB_U[u[j]];
+            int32_t Y;
+            Y = tY[y0[2 * j]];
+            o0[8 * j + 0] = clamp13(Y + rV); o0[8 * j + 1] = clamp13(Y - gUV); o0[8 * j + 2] = clamp13(Y + bU);
+            Y = tY[y0[2 * j + 1]];
+            o0[8 * j + 4] = clamp13(Y + rV); o0[8 * j + 5] = clamp13(Y - gUV); o0[8 * j + 6] = clamp13(Y + bU);
+            Y = tY[y1[2 * j]];
+            o1[8 * j + 0] = clamp13(Y + rV); o1[8 * j + 1] = clamp13(Y - gUV); o1[8 * j + 2] = clamp13(Y + bU);
+            Y = tY[y1[2 * j + 1]];
+            o1[8 * j + 4] = clamp13(Y + rV); o1[8 * j + 5] = clamp13(Y - gUV); o1[8 * j + 6] = clamp13(Y + bU);
+        }
+    }
+}
+
+// ---- libtheora 1.1 decoder API (statically linked in the same game) -> host libtheoradec ---------
+// The decoder context and setup info are opaque: the guest gets 32-bit hash handles for them.
+// th_info has no pointer nor long, so its layout is the same on both sides. ogg_packet and
+// th_img_plane are converted. Decoded planes live in native memory the guest can't reach, so
+// each frame is copied (compact, top-down) into a per-decoder buffer in the 32-bit space.
+typedef struct h_ogg_packet_s { unsigned char* packet; long bytes, b_o_s, e_o_s; int64_t granulepos, packetno; } h_ogg_packet;
+typedef struct h_th_comment_s { char** user_comments; int* comment_lengths; int comments; char* vendor; } h_th_comment;
+typedef struct h_th_img_plane_s { int width, height, stride; unsigned char* data; } h_th_img_plane;
+#pragma pack(push, 4)
+typedef struct g_ogg_packet_s { ptr_t packet; int32_t bytes, b_o_s, e_o_s; int64_t granulepos, packetno; } g_ogg_packet;
+#pragma pack(pop)
+typedef struct g_th_img_plane_s { int32_t width, height, stride; ptr_t data; } g_th_img_plane;
+_Static_assert(sizeof(g_ogg_packet) == 32, "i386 ogg_packet layout");
+_Static_assert(sizeof(g_th_img_plane) == 16, "i386 th_img_plane layout");
+
+#define TH_EIMPL              (-23)
+#define TH_DECCTL_SET_STRIPE_CB 7
+
+static int (*h_headerin)(void* info, h_th_comment* tc, void** setup, h_ogg_packet* op);
+static void* (*h_alloc)(const void* info, const void* setup);
+static void (*h_free)(void* dec);
+static int (*h_ctl)(void* dec, int req, void* buf, size_t sz);
+static int (*h_packetin)(void* dec, const h_ogg_packet* op, int64_t* granpos);
+static int (*h_ycbcr_out)(void* dec, h_th_img_plane* ycbcr);
+static void (*h_setup_free)(void* setup);
+static int64_t (*h_granule_frame)(void* encdec, int64_t granpos);
+static double (*h_granule_time)(void* encdec, int64_t granpos);
+static void (*h_comment_init)(h_th_comment* tc);
+static void (*h_comment_clear)(h_th_comment* tc);
+
+typedef struct theora_dec_s {
+    void* dec;
+    uint8_t* low;   // last decoded frame, in the 32-bit space
+    size_t lowsz;
+} theora_dec_t;
+
+#define ARG32(i) from_ptri(ptr_t, R_ESP + 4 + 4 * (i))
+typedef union { int64_t i; uint32_t d[2]; } gh_ui64_t;
+
+static theora_dec_t* dec_from_handle(ptr_t h) { return (theora_dec_t*)from_hash(h); }
+
+static void conv_packet(h_ogg_packet* h, const g_ogg_packet* g)
+{
+    h->packet = from_ptrv(g->packet);
+    h->bytes = g->bytes;
+    h->b_o_s = g->b_o_s;
+    h->e_o_s = g->e_o_s;
+    h->granulepos = g->granulepos;
+    h->packetno = g->packetno;
+}
+
+// native comment state, keyed by the address of the guest th_comment (which stays empty)
+#define N_THCOMMENT 16
+static struct { ptr_t key; int used; h_th_comment tc; } th_comments[N_THCOMMENT];
+static int th_comment_next = 0;
+static pthread_mutex_t th_comment_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static h_th_comment* get_th_comment(ptr_t key, int reset)
+{
+    pthread_mutex_lock(&th_comment_mutex);
+    int idx = -1;
+    for (int i = 0; i < N_THCOMMENT; ++i)
+        if (th_comments[i].used && th_comments[i].key == key) { idx = i; break; }
+    if (idx < 0) {
+        idx = th_comment_next;
+        th_comment_next = (th_comment_next + 1) % N_THCOMMENT;
+        if (th_comments[idx].used) h_comment_clear(&th_comments[idx].tc);
+        th_comments[idx].used = 1;
+        th_comments[idx].key = key;
+        h_comment_init(&th_comments[idx].tc);
+    } else if (reset) {
+        h_comment_clear(&th_comments[idx].tc);
+        h_comment_init(&th_comments[idx].tc);
+    }
+    h_th_comment* ret = &th_comments[idx].tc;
+    pthread_mutex_unlock(&th_comment_mutex);
+    return ret;
+}
+
+// int th_decode_headerin(th_info*, th_comment*, th_setup_info**, ogg_packet*)
+static void w_th_decode_headerin(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    ptr_t info = ARG32(0), tc = ARG32(1), setup = ARG32(2), op = ARG32(3);
+    h_ogg_packet hop;
+    const g_ogg_packet* gop = op ? (const g_ogg_packet*)from_ptrv(op) : NULL;
+    if (gop) conv_packet(&hop, gop);
+    // the info header (0x80) starts a new stream: forget the comments of a previous one
+    int first = gop && gop->bytes > 0 && gop->packet && ((uint8_t*)from_ptrv(gop->packet))[0] == 0x80;
+    h_th_comment* htc = tc ? get_th_comment(tc, first) : NULL;
+    ptr_t* slot = setup ? (ptr_t*)from_ptrv(setup) : NULL;
+    void* hsetup = slot ? (void*)from_hash(*slot) : NULL;
+    int ret = h_headerin(info ? from_ptrv(info) : NULL, htc, slot ? &hsetup : NULL, gop ? &hop : NULL);
+    if (slot) *slot = to_hash((uintptr_t)hsetup);
+    R_EAX = (uint32_t)ret;
+}
+
+// th_dec_ctx* th_decode_alloc(const th_info*, const th_setup_info*)
+static void w_th_decode_alloc(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    ptr_t info = ARG32(0), setup = ARG32(1);
+    void* dec = h_alloc(info ? from_ptrv(info) : NULL, (void*)from_hash(setup));
+    if (!dec) { R_EAX = 0; return; }
+    theora_dec_t* d = box_calloc(1, sizeof(theora_dec_t));
+    d->dec = dec;
+    R_EAX = to_hash((uintptr_t)d);
+}
+
+// void th_decode_free(th_dec_ctx*)
+static void w_th_decode_free(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    theora_dec_t* d = dec_from_handle(ARG32(0));
+    if (!d) return;
+    to_hash_d((uintptr_t)d);
+    h_free(d->dec);
+    if (d->low) box32_free(d->low);
+    box_free(d);
+}
+
+// void th_setup_free(th_setup_info*)
+static void w_th_setup_free(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    void* s = (void*)from_hash(ARG32(0));
+    if (!s) return;
+    to_hash_d((uintptr_t)s);
+    h_setup_free(s);
+}
+
+// int th_decode_ctl(th_dec_ctx*, int, void*, size_t)
+static void w_th_decode_ctl(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    theora_dec_t* d = dec_from_handle(ARG32(0));
+    int req = (int)ARG32(1);
+    ptr_t buf = ARG32(2);
+    size_t sz = ARG32(3);
+    if (req == TH_DECCTL_SET_STRIPE_CB) { R_EAX = (uint32_t)TH_EIMPL; return; } // guest callbacks: not bridged
+    R_EAX = (uint32_t)h_ctl(d ? d->dec : NULL, req, buf ? from_ptrv(buf) : NULL, sz);
+}
+
+// int th_decode_packetin(th_dec_ctx*, const ogg_packet*, ogg_int64_t*)
+static void w_th_decode_packetin(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    theora_dec_t* d = dec_from_handle(ARG32(0));
+    ptr_t op = ARG32(1), gp = ARG32(2);
+    h_ogg_packet hop;
+    if (op) conv_packet(&hop, (const g_ogg_packet*)from_ptrv(op));
+    R_EAX = (uint32_t)h_packetin(d ? d->dec : NULL, op ? &hop : NULL, gp ? (int64_t*)from_ptrv(gp) : NULL);
+}
+
+// int th_decode_ycbcr_out(th_dec_ctx*, th_ycbcr_buffer)
+static void w_th_decode_ycbcr_out(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    theora_dec_t* d = dec_from_handle(ARG32(0));
+    g_th_img_plane* gb = (g_th_img_plane*)from_ptrv(ARG32(1));
+    h_th_img_plane hb[3];
+    int ret = h_ycbcr_out(d ? d->dec : NULL, hb);
+    if (ret || !d || !gb) { R_EAX = (uint32_t)ret; return; }
+    size_t need = 0;
+    for (int i = 0; i < 3; ++i) need += (size_t)hb[i].width * hb[i].height;
+    if (need > d->lowsz) {
+        if (d->low) box32_free(d->low);
+        d->low = box32_malloc(need);
+        d->lowsz = d->low ? need : 0;
+        if (!d->low) { R_EAX = (uint32_t)-1; return; }
+    }
+    uint8_t* dst = d->low;
+    for (int i = 0; i < 3; ++i) {
+        const int w = hb[i].width, h = hb[i].height;
+        const uint8_t* src = hb[i].data;
+        for (int row = 0; row < h; ++row)
+            memcpy(dst + (size_t)row * w, src + (ptrdiff_t)row * hb[i].stride, w);
+        gb[i].width = w;
+        gb[i].height = h;
+        gb[i].stride = w;
+        gb[i].data = to_ptrv(dst);
+        dst += (size_t)w * h;
+    }
+    R_EAX = 0;
+}
+
+// ogg_int64_t th_granule_frame(void* encdec, ogg_int64_t granpos)
+static void w_th_granule_frame(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    theora_dec_t* d = dec_from_handle(ARG32(0));
+    int64_t gp = from_ptri(int64_t, R_ESP + 8);
+    gh_ui64_t r;
+    r.i = h_granule_frame(d ? d->dec : NULL, gp);
+    R_EAX = r.d[0];
+    R_EDX = r.d[1];
+}
+
+// double th_granule_time(void* encdec, ogg_int64_t granpos)
+static void w_th_granule_time(x64emu_t* emu, uintptr_t fnc)
+{
+    (void)fnc;
+    theora_dec_t* d = dec_from_handle(ARG32(0));
+    int64_t gp = from_ptri(int64_t, R_ESP + 8);
+    double r = h_granule_time(d ? d->dec : NULL, gp);
+    fpu_do_push(emu);
+    ST0.d = r;
+}
+
+static int setup_theora(void)
+{
+    static int done = 0, ok = 0;
+    if (done) return ok;
+    done = 1;
+    void* lib = dlopen("libtheoradec.so.1", RTLD_NOW | RTLD_LOCAL);
+    if (!lib) {
+        printf_log(LOG_INFO, "Game hook: native libtheoradec.so.1 not found, libtheora not hooked\n");
+        return 0;
+    }
+#define GO(V, S) V = dlsym(lib, S); if (!V) return 0;
+    GO(h_headerin, "th_decode_headerin")
+    GO(h_alloc, "th_decode_alloc")
+    GO(h_free, "th_decode_free")
+    GO(h_ctl, "th_decode_ctl")
+    GO(h_packetin, "th_decode_packetin")
+    GO(h_ycbcr_out, "th_decode_ycbcr_out")
+    GO(h_setup_free, "th_setup_free")
+    GO(h_granule_frame, "th_granule_frame")
+    GO(h_granule_time, "th_granule_time")
+    GO(h_comment_init, "th_comment_init")
+    GO(h_comment_clear, "th_comment_clear")
+#undef GO
+    ok = 1;
+    return 1;
+}
+
+typedef struct gamehook32_s {
+    const char* symbol;
+    uint32_t size;
+    uint64_t hash;
+    void* native;
+    wrapper_t wrapper;
+    int (*setup)(void);   // per group: returns 0 if the native side isn't available
+    int group;            // all hooks of a group are installed together, or none
+} gamehook32_t;
+
+static int setup_decodeRGBX(void)
+{
+    tG_V = from_ptrv(0xb280054);
+    tG_U = from_ptrv(0xb280454);
+    tR_V = from_ptrv(0xb280854);
+    tB_U = from_ptrv(0xb280c54);
+    tY = from_ptrv(0xb281054);
+    return 1;
+}
+
+// Grim Fandango Remastered (GOG Linux 2.3.0.7)
+static const gamehook32_t gamehooks32[] = {
+    { "decodeRGBX",          0x2c0,  0xd093c74f420945f9ULL, native_decodeRGBX, vFp_32,                setup_decodeRGBX, 1 },
+    { "th_decode_headerin",  0x7d4,  0xdd267bf0a3193e4aULL, NULL,              w_th_decode_headerin,  setup_theora,     2 },
+    { "th_decode_alloc",     0x2ec,  0xc33ba7a8094a1deaULL, NULL,              w_th_decode_alloc,     setup_theora,     2 },
+    { "th_decode_free",      0x68,   0x58a79757982eb00aULL, NULL,              w_th_decode_free,      setup_theora,     2 },
+    { "th_decode_ctl",       0x151,  0xc8cfdfa3b2885727ULL, NULL,              w_th_decode_ctl,       setup_theora,     2 },
+    { "th_decode_packetin",  0x3d84, 0xbd9e7c86947fb338ULL, NULL,              w_th_decode_packetin,  setup_theora,     2 },
+    { "th_decode_ycbcr_out", 0x30,   0x7faf9ea149635fbdULL, NULL,              w_th_decode_ycbcr_out, setup_theora,     2 },
+    { "th_setup_free",       0x30,   0x5931ba5cb78a0f63ULL, NULL,              w_th_setup_free,       setup_theora,     2 },
+    { "th_granule_frame",    0xba,   0xb58b6907a9aca109ULL, NULL,              w_th_granule_frame,    setup_theora,     2 },
+    { "th_granule_time",     0x120,  0xafe1c990d39d06f6ULL, NULL,              w_th_granule_time,     setup_theora,     2 },
+};
+#define N_GAMEHOOKS32 (sizeof(gamehooks32) / sizeof(gamehooks32[0]))
+
+void InstallGameHooks32(elfheader_t* h)
+{
+    if (!BOX64ENV(gamehooks) || !h)
+        return;
+    uintptr_t starts[N_GAMEHOOKS32] = { 0 };
+    int bad_group[8] = { 0 }, seen_group[8] = { 0 };
+    // pass 1: every hook of a group must match the known build
+    for (size_t i = 0; i < N_GAMEHOOKS32; ++i) {
+        const gamehook32_t* g = &gamehooks32[i];
+        uintptr_t end = 0;
+        if (!ElfGetSymTabStartEnd32(h, &starts[i], &end, g->symbol)) {
+            bad_group[g->group] = 1;
+            continue;
+        }
+        seen_group[g->group] = 1;
+        if (end - starts[i] != g->size || fnv1a64((const uint8_t*)starts[i], g->size) != g->hash) {
+            printf_log(LOG_INFO, "Game hook: %s found at %p but doesn't match the known build\n", g->symbol, (void*)starts[i]);
+            bad_group[g->group] = 1;
+        }
+    }
+    // pass 2: native side available?
+    for (size_t i = 0; i < N_GAMEHOOKS32; ++i) {
+        const gamehook32_t* g = &gamehooks32[i];
+        if (seen_group[g->group] && !bad_group[g->group] && g->setup && !g->setup())
+            bad_group[g->group] = 1;
+    }
+    // pass 3: install
+    for (size_t i = 0; i < N_GAMEHOOKS32; ++i) {
+        const gamehook32_t* g = &gamehooks32[i];
+        if (!seen_group[g->group] || bad_group[g->group])
+            continue;
+        // the native pointers of the theora group are only known after setup: use the wrapper as the bridge key
+        uintptr_t bridge = AddBridge(my_context->system, g->wrapper, g->native ? g->native : (void*)g->wrapper, 0, g->symbol);
+        addAlternate((void*)starts[i], (void*)bridge);
+        printf_log(LOG_INFO, "Game hook: %s at %p redirected to native code\n", g->symbol, (void*)starts[i]);
+    }
+}
diff --git a/src/tools/unityhooks.c b/src/tools/unityhooks.c
new file mode 100644
index 000000000..a86bfc3fd
--- /dev/null
+++ b/src/tools/unityhooks.c
@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: MIT
+// Native replacements for hot math functions of a specific UnityPlayer.so build.
+// Each replacement follows the guest code instruction by instruction (same operations, same
+// operand pairing, no fused multiply-add: see the pragmas below), so the
+// results are bit-identical to the x86 code. A hook is only installed when the guest function
+// bytes match the build it was written for. Disable with BOX64_UNITYHOOKS=0; BOX64_UNITYHOOKS=2
+// also runs the guest code on every call and logs any difference (verification mode).
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+#include "debug.h"
+#include "env.h"
+#include "box64context.h"
+#include "elfloader.h"
+#include "bridge.h"
+#include "alternate.h"
+#include "callback.h"
+#include "wrapper.h"
+
+// a fused multiply-add rounds once instead of twice: the results would differ from the x86 code
+#if defined(__clang__)
+#pragma clang fp contract(off)
+#elif defined(__GNUC__)
+#pragma GCC optimize("fp-contract=off")
+#endif
+
+typedef float v4 __attribute__((vector_size(16)));
+
+// SHUFPS x,x,imm (same register)
+#define SHUF(a, imm) __builtin_shufflevector((a), (a), (imm) & 3, ((imm) >> 2) & 3, ((imm) >> 4) & 3, ((imm) >> 6) & 3)
+// SHUFPD x,x,1
+#define SWAPQ(a) __builtin_shufflevector((a), (a), 2, 3, 0, 1)
+// the last row stores of the guest code: {a0, a1, a2, w}
+#define ROW3(a, w) ((v4) { (a)[0], (a)[1], (a)[2], (w) })
+
+static uint64_t fnv1a64(const uint8_t* p, size_t n)
+{
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (size_t i = 0; i < n; ++i)
+        h = (h ^ p[i]) * 0x100000001b3ULL;
+    return h;
+}
+
+// ---- Unity 2019.4.41f1 (fb553f8fdd6c) UnityPlayer.so, Pillars of Eternity GOG Linux -------------
+static uintptr_t up_CompleteFenceInternal; // CompleteFenceInternal(JobFence&, WorkStealMode)
+static uintptr_t up_ClearFenceWithoutSync; // ClearFenceWithoutSync(JobFence&)
+
+// TransformHierarchy: +0x00 JobFence, +0x18 TransformX* (pos, rot, scale: 3 x 16 bytes), +0x20 int* parent
+// Transform: +0x38 TransformHierarchy*, +0x40 index
+static void native_GetLocalToWorldMatrix(void* self, float* out)
+{
+    const v4 C310 = { 0.f, 1.f, 0.f, 0.f };
+    const v4 C350 = { -2.f, 2.f, -2.f, 0.f };
+    const v4 C360 = { -2.f, 2.f, 2.f, 0.f };
+    const v4 C370 = { -2.f, -2.f, 2.f, 0.f };
+    const v4 C380 = { 2.f, -2.f, 2.f, 0.f };
+    const v4 C390 = { 2.f, -2.f, -2.f, 0.f };
+    const v4 C3A0 = { 2.f, 2.f, -2.f, 0.f };
+    const v4 C3B0 = { 0.f, 0.f, 1.f, 0.f };
+    const v4 ONE = { 1.f, 0.f, 0.f, 0.f };
+
+    uintptr_t h = *(uintptr_t*)((uintptr_t)self + 0x38);
+    if (*(uint64_t*)h) {
+        RunFunctionFmt(up_CompleteFenceInternal, "pi", (void*)h, 0);
+        RunFunctionFmt(up_ClearFenceWithoutSync, "p", (void*)h);
+        h = *(uintptr_t*)((uintptr_t)self + 0x38);
+    }
+    const v4* tx = *(const v4**)(h + 0x18);
+    const int32_t* parent = *(const int32_t**)(h + 0x20);
+    uint32_t idx = *(uint32_t*)((uintptr_t)self + 0x40);
+    const v4* t = tx + 3 * (uintptr_t)idx;
+
+    v4 x13 = t[0], x2 = t[1], x10 = t[2];
+    v4 x6 = SHUF(x2, 0xf1);
+    v4 x5 = SWAPQ(x2);
+    v4 x8 = SHUF(x2, 0xdb);
+    v4 x4 = SHUF(x2, 0xd5);
+    v4 x1 = C350 * x4;
+    x1 = x1 * x6;
+    v4 x7 = SHUF(x2, 0xea);
+    v4 x3 = C360 * x7;
+    x3 = x3 * x5;
+    x3 = x3 + x1;
+    v4 x9 = ONE + x3;
+    x7 = x7 * C370;
+    x7 = x7 * x8;
+    x2 = SHUF(x2, 0xc0);
+    x1 = C380 * x2;
+    x1 = x1 * x6;
+    x1 = x1 + x7;
+    x1 = x1 + C310;
+    x2 = x2 * C390;
+    x2 = x2 * x5;
+    x4 = x4 * C3A0;
+    x4 = x4 * x8;
+    x4 = x4 + x2;
+    x4 = x4 + C3B0;
+    x3 = SHUF(x10, 0xc0) * x9;
+    x2 = SHUF(x10, 0xd5) * x1;
+    x10 = SHUF(x10, 0xea) * x4;
+
+    int32_t p = parent[idx];
+    while (p >= 0) {
+        const v4* pt = tx + 3 * (intptr_t)p;
+        v4 q = pt[1];
+        v4 y1 = SHUF(q, 0xf1);
+        v4 y4 = SWAPQ(q);
+        v4 y8 = SHUF(q, 0xd5);
+        v4 y5 = y8 * C350;
+        v4 y11 = SHUF(q, 0xea);
+        y5 = y5 * y1;
+        v4 y6 = SHUF(q, 0xc0);
+        v4 y12 = y6 * C380;
+        y12 = y12 * y1;
+        y1 = y11 * C360;
+        y1 = y1 * y4;
+        y6 = y6 * C390;
+        y6 = y6 * y4;
+        y1 = y1 + y5;
+        v4 y7 = SHUF(q, 0xdb);
+        y11 = y11 * C370;
+        y11 = y11 * y7;
+        y12 = y12 + y11;
+        v4 s = pt[2];
+        y8 = y8 * C3A0;
+        y8 = y8 * y7;
+        y12 = y12 + C310;
+        y8 = y8 + y6;
+        y8 = y8 + C3B0;
+        y1 = y1 + ONE;
+        y7 = SHUF(s, 0xc0) * y1;  // scaled rotation rows of the parent
+        y6 = SHUF(s, 0xd5) * y12;
+        y5 = SHUF(s, 0xea) * y8;
+        // child rows (x3, x2, x10) and position (x13) times the parent rows
+        v4 a1 = SHUF(x13, 0xc0) * y7;
+        v4 a0 = SHUF(x13, 0xea) * y5;
+        x13 = SHUF(x13, 0xd5) * y6;
+        x13 = x13 + a0;
+        v4 b4 = SHUF(x3, 0xc0) * y7;
+        v4 b0 = SHUF(x3, 0xea) * y5;
+        x3 = SHUF(x3, 0xd5) * y6;
+        x3 = x3 + b0;
+        x13 = x13 + a1;
+        v4 c0 = SHUF(x2, 0xc0);
+        v4 c1 = SHUF(x2, 0xea) * y5;
+        x2 = SHUF(x2, 0xd5) * y6;
+        x2 = x2 + c1;
+        v4 d1 = SHUF(x10, 0xc0);
+        c0 = c0 * y7;
+        d1 = d1 * y7;
+        v4 d7 = SHUF(x10, 0xea) * y5;
+        x3 = x3 + b4;
+        x10 = SHUF(x10, 0xd5) * y6;
+        x10 = x10 + d7;
+        x2 = x2 + c0;
+        x10 = x10 + d1;
+        x13 = x13 + pt[0];
+        p = parent[p];
+    }
+    v4 r;
+    r = ROW3(x3, 0.f);  memcpy(out + 0, &r, 16);
+    r = ROW3(x2, 0.f);  memcpy(out + 4, &r, 16);
+    r = ROW3(x10, 0.f); memcpy(out + 8, &r, 16);
+    r = ROW3(x13, 1.f); memcpy(out + 12, &r, 16);
+}
+
+// x86 abs idiom of the guest code: (x < 0) ? x ^ signmask : x  (keeps -0.0 and NaN as they are)
+static inline float sabs(float x)
+{
+    return (x < 0.f) ? -x : x;
+}
+
+// TransformAABB(AABB const&, Matrix4x4f const&, AABB&): AABB = center[3], extent[3]; column-major matrix
+static void native_TransformAABB(const float* a, const float* m, float* o)
+{
+    const float ex = a[3], ey = a[4], ez = a[5];
+    const float e00 = sabs(ex * m[0]);
+    const float e01 = sabs(ey * m[4]);
+    const float e02 = sabs(ez * m[8]);
+    const float e10 = sabs(ex * m[1]);
+    const float ny = sabs(ez * m[9]) + (sabs(ey * m[5]) + e10);
+    const float nz = sabs(ez * m[10]) + (sabs(ey * m[6]) + sabs(ex * m[2]));
+    const float c0 = a[0], c1 = a[1], c2 = a[2];
+    const float r0 = m[4] * c1 + m[0] * c0;
+    const float r1 = m[5] * c1 + m[1] * c0;
+    const float r2 = m[6] * c1 + m[2] * c0;
+    o[0] = m[12] + (m[8] * c2 + r0);
+    o[1] = m[13] + (m[9] * c2 + r1);
+    o[2] = m[14] + (m[10] * c2 + r2);
+    o[3] = e02 + (e01 + e00);
+    o[4] = ny;
+    o[5] = nz;
+}
+
+static uintptr_t up_VerifyBoneIndices;   // Mesh::VerifyBoneIndices(unsigned int)
+static uintptr_t up_GetCachedBonesBounds; // Mesh::GetCachedBonesBounds() -> dynamic_array<MinMaxAABB>*
+static uintptr_t up_infinityVec;          // Vector3f::infinityVec (set at startup)
+
+// SkinnedMeshRenderer::CalculateBoneBasedBounds(Matrix4x4f const*, unsigned long, MinMaxAABB&) -> bool
+// MinMaxAABB = min[3], max[3]. MINSS/MAXSS semantics: (a < b) ? a : b / (a > b) ? a : b
+static int native_CalculateBoneBasedBounds(void* self, const float* mat, uintptr_t count, float* out)
+{
+    uintptr_t mesh = *(uintptr_t*)((uintptr_t)self + 0x1e0);
+    if (!mesh)
+        return 0;
+    if (!(uint8_t)RunFunctionFmt(up_VerifyBoneIndices, "pu", (void*)mesh, (uint32_t)count))
+        return 0;
+    uintptr_t cache = (uintptr_t)RunFunctionFmt(up_GetCachedBonesBounds, "p", (void*)mesh);
+    if (*(uint64_t*)(cache + 0x10) < count)
+        return 0;
+    const float* inf = (const float*)up_infinityVec;
+    float mnx = inf[0], mny = inf[1], mnz = inf[2];
+    float mxx = -inf[0], mxy = -inf[1], mxz = -inf[2];
+    const float* b = *(const float**)cache;
+    for (uintptr_t i = 0; i < count; ++i, b += 6, mat += 16) {
+        if (b[0] == inf[0] && b[1] == inf[1] && b[2] == inf[2])
+            continue;
+        if (b[3] == -inf[0] && b[4] == -inf[1] && b[5] == -inf[2])
+            continue;
+        float a[6], o[6];
+        a[0] = (b[0] + b[3]) * 0.5f;
+        a[1] = (b[1] + b[4]) * 0.5f;
+        a[2] = (b[2] + b[5]) * 0.5f;
+        a[3] = (b[3] - b[0]) * 0.5f;
+        a[4] = (b[4] - b[1]) * 0.5f;
+        a[5] = (b[5] - b[2]) * 0.5f;
+        native_TransformAABB(a, mat, o);
+        const float lx = o[0] - o[3], ly = o[1] - o[4], lz = o[2] - o[5];
+        const float tnx = (lx < mnx) ? lx : mnx, tny = (ly < mny) ? ly : mny, tnz = (lz < mnz) ? lz : mnz;
+        const float txx = (lx > mxx) ? lx : mxx, txy = (ly > mxy) ? ly : mxy, txz = (lz > mxz) ? lz : mxz;
+        const float hx = o[0] + o[3], hy = o[1] + o[4], hz = o[2] + o[5];
+        mnx = (hx < tnx) ? hx : tnx;
+        mny = (hy < tny) ? hy : tny;
+        mnz = (hz < tnz) ? hz : tnz;
+        mxx = (hx > txx) ? hx : txx;
+        mxy = (hy > txy) ? hy : txy;
+        mxz = (hz > txz) ? hz : txz;
+    }
+    if (mnx == inf[0] && mny == inf[1] && mnz == inf[2])
+        return 0;
+    if (mxx == -inf[0] && mxz == -inf[2] && mxy == -inf[1])
+        return 0;
+    out[0] = mnx; out[1] = mny; out[2] = mnz;
+    out[3] = mxx; out[4] = mxy; out[5] = mxz;
+    return 1;
+}
+
+// ---- verification mode: run both, compare the bytes --------------------------------------------
+static uintptr_t up_GetLocalToWorldMatrix;
+static uint64_t verify_calls, verify_bad;
+
+static void verify_GetLocalToWorldMatrix(void* self, float* out)
+{
+    float mine[16];
+    native_GetLocalToWorldMatrix(self, mine);
+    RunFunctionFmtNoAlt(up_GetLocalToWorldMatrix, "pp", self, out);
+    uint64_t n = __atomic_add_fetch(&verify_calls, 1, __ATOMIC_RELAXED);
+    if (memcmp(mine, out, sizeof(mine))) {
+        uint64_t b = __atomic_add_fetch(&verify_bad, 1, __ATOMIC_RELAXED);
+        if (b <= 8) {
+            printf_log(LOG_NONE, "Unity hook verify: GetLocalToWorldMatrix mismatch #%llu (call %llu):\n", (unsigned long long)b, (unsigned long long)n);
+            for (int i = 0; i < 16; ++i)
+                if (memcmp(&mine[i], &out[i], 4))
+                    printf_log(LOG_NONE, "  [%d] native %a guest %a\n", i, mine[i], out[i]);
+        }
+    }
+    if (!(n & ((1 << 20) - 1)))
+        printf_log(LOG_NONE, "Unity hook verify: GetLocalToWorldMatrix %llu calls, %llu mismatches\n", (unsigned long long)n, (unsigned long long)verify_bad);
+}
+
+static uintptr_t up_TransformAABB, up_CalculateBoneBasedBounds;
+static uint64_t verify_calls2, verify_bad2, verify_calls3, verify_bad3;
+
+static void verify_report(const char* name, uint64_t n, uint64_t b, int bad, const float* mine, const float* guest, int cnt)
+{
+    if (bad && b <= 8) {
+        printf_log(LOG_NONE, "Unity hook verify: %s mismatch #%llu (call %llu):\n", name, (unsigned long long)b, (unsigned long long)n);
+        for (int i = 0; i < cnt; ++i)
+            if (memcmp(&mine[i], &guest[i], 4))
+                printf_log(LOG_NONE, "  [%d] native %a guest %a\n", i, mine[i], guest[i]);
+    }
+    if (!(n & ((1 << 20) - 1)))
+        printf_log(LOG_NONE, "Unity hook verify: %s %llu calls, %llu mismatches\n", name, (unsigned long long)n, (unsigned long long)b);
+}
+
+static void verify_TransformAABB(const float* a, const float* m, float* o)
+{
+    float in[6], mine[6];
+    memcpy(in, a, sizeof(in)); // o may alias a
+    native_TransformAABB(in, m, mine);
+    RunFunctionFmtNoAlt(up_TransformAABB, "ppp", (void*)a, (void*)m, (void*)o);
+    int bad = memcmp(mine, o, sizeof(mine)) != 0;
+    uint64_t n = __atomic_add_fetch(&verify_calls2, 1, __ATOMIC_RELAXED);
+    uint64_t b = bad ? __atomic_add_fetch(&verify_bad2, 1, __ATOMIC_RELAXED) : verify_bad2;
+    verify_report("TransformAABB", n, b, bad, mine, o, 6);
+}
+
+static int verify_CalculateBoneBasedBounds(void* self, const float* mat, uintptr_t count, float* out)
+{
+    float mine[7] = { 0 }, guest[7];
+    memcpy(guest, out, 24);
+    memcpy(mine, out, 24);
+    int r1 = native_CalculateBoneBasedBounds(self, mat, count, mine);
+    int r2 = (uint8_t)RunFunctionFmtNoAlt(up_CalculateBoneBasedBounds, "ppLp", self, (void*)mat, (uint64_t)count, (void*)out);
+    memcpy(guest, out, 24);
+    mine[6] = (float)r1; guest[6] = (float)r2;
+    int bad = memcmp(mine, guest, sizeof(mine)) != 0;
+    uint64_t n = __atomic_add_fetch(&verify_calls3, 1, __ATOMIC_RELAXED);
+    uint64_t b = bad ? __atomic_add_fetch(&verify_bad3, 1, __ATOMIC_RELAXED) : verify_bad3;
+    verify_report("CalculateBoneBasedBounds", n, b, bad, mine, guest, 7);
+    return r2;
+}
+
+typedef struct unityhook_s {
+    const char* name;
+    uintptr_t start;
+    size_t size;
+    uint64_t hash;
+    wrapper_t wrapper;
+    void* native;
+    void* verify;
+    uintptr_t* guest; // where to keep the guest address, for verification
+} unityhook_t;
+
+static const unityhook_t unityhooks[] = {
+    { "Transform::GetLocalToWorldMatrix", 0x103cac0, 0x2e5, 0x72de05b927c6dae2ULL, vFpp, native_GetLocalToWorldMatrix, verify_GetLocalToWorldMatrix, &up_GetLocalToWorldMatrix },
+    { "TransformAABB", 0x873050, 0x23a, 0x4f300a4a974e72a1ULL, vFppp, native_TransformAABB, verify_TransformAABB, &up_TransformAABB },
+    { "SkinnedMeshRenderer::CalculateBoneBasedBounds", 0x952d00, 0x35c, 0xff53c45073095b91ULL, iFpppp, native_CalculateBoneBasedBounds, verify_CalculateBoneBasedBounds, &up_CalculateBoneBasedBounds },
+};
+#define N_UNITYHOOKS (sizeof(unityhooks) / sizeof(unityhooks[0]))
+
+// called once UnityPlayer.so is loaded, before any of its code runs
+void InstallUnityHooks(elfheader_t* h)
+{
+    if (!BOX64ENV(unityhooks) || !h)
+        return;
+    uintptr_t delta = (uintptr_t)GetElfDelta(h);
+    for (size_t i = 0; i < N_UNITYHOOKS; ++i) {
+        const unityhook_t* u = &unityhooks[i];
+        uint64_t hash = fnv1a64((const uint8_t*)(delta + u->start), u->size);
+        if (hash != u->hash) {
+            printf_log(LOG_DEBUG, "Unity hook: %s doesn't match the known build (hash 0x%016llx)\n", u->name, (unsigned long long)hash);
+            continue;
+        }
+        up_CompleteFenceInternal = delta + 0x9895c0;
+        up_ClearFenceWithoutSync = delta + 0x9895b0;
+        up_VerifyBoneIndices = delta + 0x92b9f0;
+        up_GetCachedBonesBounds = delta + 0x92b7b0;
+        up_infinityVec = delta + 0x20d5640;
+        *u->guest = delta + u->start;
+        void* fnc = (BOX64ENV(unityhooks) == 2) ? u->verify : u->native;
+        uintptr_t bridge = AddBridge(my_context->system, u->wrapper, fnc, 0, u->name);
+        addAlternate((void*)(delta + u->start), (void*)bridge);
+        printf_log(LOG_INFO, "Unity hook: %s at %p redirected to native code%s\n", u->name, (void*)(delta + u->start), (fnc == u->verify) ? " (verification mode)" : "");
+    }
+}
