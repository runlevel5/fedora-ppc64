+                    cache.vmxcache[i].t = VMX_CACHE_ST_I64;
+                } else if (cache.vmxcache[i].t == VMX_CACHE_ST_F && cache_i2.vmxcache[i].t == VMX_CACHE_ST_I64) {
+                    MESSAGE(LOG_DUMP, "\t  - Convert %s\n", getCacheName(cache.vmxcache[i].t, cache.vmxcache[i].n));
