+    if(!(alternate_bloom[(h2 >> 6) & 3] & ((uint64_t)1 << (h2 & 63)))) return 0;
+    if(!(alternate_bloom[(h3 >> 6) & 3] & ((uint64_t)1 << (h3 & 63)))) return 0;
+    return 1;  // maybe present — must check khash to confirm
+}
