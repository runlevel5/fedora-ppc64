index 000000000..bf0d7e17e
--- /dev/null
+++ b/src/dynarec/ppc64le/dynarec_ppc64le_d8.c
@@ -0,0 +1,268 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stddef.h>
+#include <errno.h>
+
+#include "debug.h"
+#include "box64context.h"
+#include "box64cpu.h"
+#include "emu/x64emu_private.h"
+#include "x64emu.h"
+#include "box64stack.h"
+#include "callback.h"
+#include "emu/x64run_private.h"
+#include "x64trace.h"
+#include "emu/x87emu_private.h"
+#include "dynarec_native.h"
+
+#include "ppc64le_printer.h"
+#include "dynarec_ppc64le_private.h"
+#include "../dynarec_helper.h"
+#include "dynarec_ppc64le_functions.h"
+
+
+uintptr_t dynarec64_D8(dynarec_ppc64le_t* dyn, uintptr_t addr, uintptr_t ip, int ninst, rex_t rex, int* ok, int* need_epilog)
+{
+    (void)ip;
+    (void)need_epilog;
+
+    uint8_t nextop = F8;
+    uint8_t ed, wback, wb1, u8;
+    int64_t fixedaddress;
+    int unscaled;
+    int v1, v2;
+
+    MAYUSE(u8);
+    MAYUSE(wb1);
+    MAYUSE(v1);
+    MAYUSE(v2);
+
+    if (MODREG)
+        switch (nextop) {
+            case 0xC0 ... 0xC7:
+                INST_NAME("FADD ST0, STx");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v2 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FADDS(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FADD(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 0xC8 ... 0xCF:
+                INST_NAME("FMUL ST0, STx");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v2 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FMULS(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FMUL(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 0xD0 ... 0xD7:
+                INST_NAME("FCOM ST0, STx");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v2 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (ST_IS_F(0)) {
+                    FCOMS(v1, v2, x1, x2, x3);
+                } else {
+                    FCOMD(v1, v2, x1, x2, x3);
+                }
+                break;
+            case 0xD8 ... 0xDF:
+                INST_NAME("FCOMP ST0, STx");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v2 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (ST_IS_F(0)) {
+                    FCOMS(v1, v2, x1, x2, x3);
+                } else {
+                    FCOMD(v1, v2, x1, x2, x3);
+                }
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                break;
+            case 0xE0 ... 0xE7:
+                INST_NAME("FSUB ST0, STx");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v2 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FSUBS(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FSUB(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 0xE8 ... 0xEF:
+                INST_NAME("FSUBR ST0, STx");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v2 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                    FSUBS(v1, v2, v1);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                    FSUB(v1, v2, v1);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 0xF0 ... 0xF7:
+                INST_NAME("FDIV ST0, STx");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v2 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FDIVS(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                    FDIV(v1, v1, v2);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 0xF8 ... 0xFF:
+                INST_NAME("FDIVR ST0, STx");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, X87_COMBINE(0, nextop & 7));
+                v2 = x87_get_st(dyn, ninst, x1, x2, nextop & 7, X87_COMBINE(0, nextop & 7));
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (ST_IS_F(0)) {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                    FDIVS(v1, v2, v1);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                } else {
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                    FDIV(v1, v2, v1);
+                    if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                }
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            default:
+                DEFAULT;
+                break;
+        }
+    else
+        switch ((nextop >> 3) & 7) {
+            case 0:
+                INST_NAME("FADD ST0, float[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x2, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LFS(v2, fixedaddress, wback); // the single is widened exactly
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                FADD(v1, v1, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 1:
+                INST_NAME("FMUL ST0, float[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x2, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LFS(v2, fixedaddress, wback); // the single is widened exactly
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                FMUL(v1, v1, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 2:
+                INST_NAME("FCOM ST0, float[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x2, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LFS(v2, fixedaddress, wback);
+                FCOMD(v1, v2, x1, x6, x3);
+                break;
+            case 3:
+                INST_NAME("FCOMP ST0, float[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x2, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LFS(v2, fixedaddress, wback);
+                FCOMD(v1, v2, x1, x6, x3);
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                break;
+            case 4:
+                INST_NAME("FSUB ST0, float[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x2, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LFS(v2, fixedaddress, wback); // the single is widened exactly
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                FSUB(v1, v1, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 5:
+                INST_NAME("FSUBR ST0, float[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x2, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LFS(v2, fixedaddress, wback); // the single is widened exactly
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                FSUB(v1, v2, v1);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 6:
+                INST_NAME("FDIV ST0, float[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x2, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LFS(v2, fixedaddress, wback); // the single is widened exactly
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                FDIV(v1, v1, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+            case 7:
+                INST_NAME("FDIVR ST0, float[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x2, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LFS(v2, fixedaddress, wback); // the single is widened exactly
+                if (!BOX64ENV(dynarec_fastround)) u8 = x87_setround(dyn, ninst, x1, x5);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                FDIV(v1, v2, v1);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                if (!BOX64ENV(dynarec_fastround)) x87_restoreround(dyn, ninst, u8);
+                break;
+        }
+    return addr;
+}
