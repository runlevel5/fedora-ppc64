+            SRDI(s2, s2, -a * 2);
+        }
+        STH(s2, offsetof(x64emu_t, fpu_tags), xEmu);
+        s3_top = 0;
+        stack_cnt = cache_i2.stack;
+    }
+    MESSAGE(LOG_DUMP, "\t---- Cache Transform\n");
 }
 
