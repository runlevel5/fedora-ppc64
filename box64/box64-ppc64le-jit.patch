+            break;
+    }
+    if (go_fetch) {
+        if (dyn->f == status_unk) {
+            LWZ(s1, offsetof(x64emu_t, df), xEmu);
+            CMPDI(s1, 0);
+            j64 = (GETMARKF2) - (dyn->native_size);
+            BEQ(j64);
+        }
+        TABLE64C(x6, const_updateflags_ppc64le);
+        MTCTR(x6);
+        BCTRL();
+        MARKF2;
+    }
+    MESSAGE(LOG_DUMP, "\t---- Flags fetch\n");
 }
 
