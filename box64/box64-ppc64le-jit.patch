+                EXTSH(x2, x2);
+                MTVSRD(v2, x2);
+                FCFID(v2, v2);
+                FCOMD(v1, v2, x1, x2, x3);
+                break;
+            case 3:
+                INST_NAME("FICOMP ST0, word[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x3, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LHZ(x2, fixedaddress, wback);
+                EXTSH(x2, x2);
+                MTVSRD(v2, x2);
+                FCFID(v2, v2);
+                FCOMD(v1, v2, x1, x2, x3);
+                X87_POP_OR_FAIL(dyn, ninst, x3);
+                break;
+            case 4:
+                INST_NAME("FISUB ST0, word[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x3, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LHZ(x2, fixedaddress, wback);
+                EXTSH(x2, x2);
+                MTVSRD(v2, x2);
+                FCFID(v2, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                FSUB(v1, v1, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                break;
+            case 5:
+                INST_NAME("FISUBR ST0, word[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x3, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LHZ(x2, fixedaddress, wback);
+                EXTSH(x2, x2);
+                MTVSRD(v2, x2);
+                FCFID(v2, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                FSUB(v1, v2, v1);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                break;
+            case 6:
+                INST_NAME("FIDIV ST0, word[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x3, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LHZ(x2, fixedaddress, wback);
+                EXTSH(x2, x2);
+                MTVSRD(v2, x2);
+                FCFID(v2, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v1, v2);
+                FDIV(v1, v1, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                break;
+            case 7:
+                INST_NAME("FIDIVR ST0, word[ED]");
+                v1 = x87_get_st(dyn, ninst, x1, x2, 0, VMX_CACHE_ST_D);
+                v2 = fpu_get_scratch(dyn);
+                addr = geted(dyn, addr, ninst, nextop, &wback, x3, x1, &fixedaddress, rex, NULL, DS_DISP, 0);
+                LHZ(x2, fixedaddress, wback);
+                EXTSH(x2, x2);
+                MTVSRD(v2, x2);
+                FCFID(v2, v2);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_START(v2, v1);
+                FDIV(v1, v2, v1);
+                if (!BOX64ENV(dynarec_fastnan)) X87_ARITH_NAN_END(v1);
+                X87_CHECK_PRECISION(v1);
+                break;
+        }
+    return addr;
+}
