+            unloadCache(dyn, ninst, stack_cnt, s1, s2, s3, &s1_val, &s2_val, &s3_top, &cache, j, cache.vmxcache[j].t, cache.vmxcache[j].n);
+    }
+    for (int i = 0; i < 32; ++i) {
