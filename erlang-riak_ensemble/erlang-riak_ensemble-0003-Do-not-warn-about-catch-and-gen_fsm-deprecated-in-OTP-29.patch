From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Mon, 16 Nov 2026 00:42:05 +1100
Subject: [PATCH] Do not warn about catch and gen_fsm, deprecated in OTP 29

OTP 29 deprecates the catch expression and the callbacks of gen_fsm, which
riak_ensemble uses, and warnings are errors.
---
 rebar.config | 1 +
 1 file changed, 1 insertion(+)

diff --git a/rebar.config b/rebar.config
index 66b1c52..19d5c88 100644
--- a/rebar.config
+++ b/rebar.config
@@ -1,5 +1,7 @@
 {erl_opts, [debug_info,
            warnings_as_errors,
+           nowarn_deprecated_catch,
+           nowarn_deprecated_callback,
            warn_untyped_record,
            {platform_define, "^[0-9]+", namespaced_types},
            {parse_transform, lager_transform}]}.
