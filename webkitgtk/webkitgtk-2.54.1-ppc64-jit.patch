+            ASSERT(simdInfo.lane == SIMDLane::i32x4);
+            isSigned ? m_assembler.vpkswss(vecTemp0, vecTemp0, vecTemp1) : m_assembler.vpkswus(vecTemp0, vecTemp0, vecTemp1);
