+            $asm.puts "fcfid #{dst}, #{dst}"
+        when "cq2d"
+            src = operands[0].ppc64leOperand
+            dst = operands[1].ppc64leOperand
+            $asm.puts "mtvsrd #{dst}, #{src}"
+            $asm.puts "fcfidu #{dst}, #{dst}"
+        when "cq2fs"
+            src = operands[0].ppc64leOperand
+            dst = operands[1].ppc64leOperand
+            $asm.puts "mtvsrd #{dst}, #{src}"
+            $asm.puts "fcfids #{dst}, #{dst}"
+        when "cq2f"
+            src = operands[0].ppc64leOperand
+            dst = operands[1].ppc64leOperand
