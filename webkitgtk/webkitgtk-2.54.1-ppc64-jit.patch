+    {
+        moveZeroToDouble(scratch);
+        return branchDouble(DoubleNotEqualAndOrdered, reg, scratch);
+    }
+    Jump branchDoubleZeroOrNaN(FPRegisterID reg, FPRegisterID scratch)
+    {
+        moveZeroToDouble(scratch);
+        return branchDouble(DoubleEqualOrUnordered, reg, scratch);
+    }
