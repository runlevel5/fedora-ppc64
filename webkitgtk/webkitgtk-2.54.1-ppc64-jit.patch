+    // xxspltw T,B,UIM (XX2, XO=164): UIM sits in bits 14-15.
+    void xxspltw(uint32_t vsrT, uint32_t vsrB, uint32_t uim)
+    {
+        ASSERT(uim < 4);
+        insn(xx2Form(60, vsrT, vsrB, 164) | (uim << 16));
