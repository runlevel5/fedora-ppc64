+        if (imm.m_value == -1) {
+            m_assembler.nor(dest, dest, dest);
+            return;
+        }
+        moveImmToScratch(int64_t(imm.m_value), dataTempRegister);
+        m_assembler.xor_(dest, dataTempRegister, dest);
