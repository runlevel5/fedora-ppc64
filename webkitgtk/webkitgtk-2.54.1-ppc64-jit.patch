+    void compare8(RelationalCondition cond, Address left, RegisterID right, RegisterID dest)
+    {
+        load8(left, dataTempRegister); // zero-extended byte
+        emitCompare32(cond, dataTempRegister, right);
+        setFromCondition(cond, dest);
+    }
