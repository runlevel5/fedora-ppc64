From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Sat, 7 Nov 2026 00:32:25 +1100
Subject: [PATCH] DFG: store OpInfoWrapper integers independently of byte
 order, and key DataView heaps by their fields

OpInfoWrapper kept a union of uint32_t and uint64_t and wrote a 32-bit
operand into the uint32_t member, so reading it back through int64 (or
storing through one width and reading through the other) gave a value
shifted by 32 bits on big-endian hosts. Store every integer zero-extended in
the uint64_t and read it back truncated, which is the same bits on both byte
orders.

DataViewData was used as an AbstractHeap payload through asQuadWord, but
AbstractHeap keeps only the low 48 bits of a payload, which on big-endian
drops byteSize and isSigned and so merges heaps that must stay apart. key()
packs the fields into the low bits in a fixed order.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 Source/JavaScriptCore/dfg/DFGClobberize.h |  2 +-
 Source/JavaScriptCore/dfg/DFGNode.h       | 26 ++++++++++++++++-------
 2 files changed, 19 insertions(+), 9 deletions(-)

diff --git a/Source/JavaScriptCore/dfg/DFGClobberize.h b/Source/JavaScriptCore/dfg/DFGClobberize.h
index 847c764a7c17..e58f6daef598 100644
--- a/Source/JavaScriptCore/dfg/DFGClobberize.h
+++ b/Source/JavaScriptCore/dfg/DFGClobberize.h
@@ -2659,7 +2659,7 @@ void clobberize(Graph& graph, Node* node, const ReadFunctor& read, const WriteFu
             write(TypedArrayProperties);
         } else {
             LocationKind indexedPropertyLoc = indexedPropertyLocToOutOfBoundsSaneChain(indexedPropertyLocForResultType(node->result()));
-            def(HeapLocation(indexedPropertyLoc, AbstractHeap(TypedArrayProperties, node->dataViewData().asQuadWord), node->child1(), node->child2(), node->child3()), LazyNode(node));
+            def(HeapLocation(indexedPropertyLoc, AbstractHeap(TypedArrayProperties, node->dataViewData().key()), node->child1(), node->child2(), node->child3()), LazyNode(node));
         }
         return;
     }
diff --git a/Source/JavaScriptCore/dfg/DFGNode.h b/Source/JavaScriptCore/dfg/DFGNode.h
index d65063d72a90..438e1f3f31dd 100644
--- a/Source/JavaScriptCore/dfg/DFGNode.h
+++ b/Source/JavaScriptCore/dfg/DFGNode.h
@@ -166,6 +166,18 @@ struct DataViewData {
         };
         uint64_t asQuadWord;
     };
+
+    // The fields as one integer in the low bits, independent of byte order. AbstractHeap keeps
+    // only the low 48 bits of a payload, which on big-endian would drop byteSize and isSigned
+    // from asQuadWord.
+    uint64_t key() const
+    {
+        return static_cast<uint64_t>(byteSize)
+            | static_cast<uint64_t>(isSigned) << 8
+            | static_cast<uint64_t>(isResizable) << 16
+            | static_cast<uint64_t>(isFloatingPoint) << 24
+            | static_cast<uint64_t>(static_cast<uint8_t>(isLittleEndian)) << 32;
+    }
 };
 static_assert(sizeof(DataViewData) == sizeof(uint64_t));
 
@@ -3985,10 +3997,11 @@ private:
         {
             u.int64 = 0;
         }
+        // Integers are stored zero-extended in int64 and read back truncated, so that a
+        // value stored at either width reads back the same on either byte order.
         OpInfoWrapper(uint32_t intValue)
         {
-            u.int64 = 0;
-            u.int32 = intValue;
+            u.int64 = intValue;
         }
         OpInfoWrapper(uint64_t intValue)
         {
@@ -4016,14 +4029,12 @@ private:
         }
         OpInfoWrapper& operator=(uint32_t int32)
         {
-            u.int64 = 0;
-            u.int32 = int32;
+            u.int64 = int32;
             return *this;
         }
         OpInfoWrapper& operator=(int32_t int32)
         {
-            u.int64 = 0;
-            u.int32 = int32;
+            u.int64 = static_cast<uint32_t>(int32);
             return *this;
         }
         OpInfoWrapper& operator=(uint64_t int64)
@@ -4076,7 +4087,7 @@ private:
             requires (IntegralOrEnum<T> && sizeof(T) <= 4)
         ALWAYS_INLINE T as() const
         {
-            return static_cast<T>(u.int32);
+            return static_cast<T>(static_cast<uint32_t>(u.int64));
         }
         template<typename T>
             requires (IntegralOrEnum<T> && sizeof(T) == 8)
@@ -4099,7 +4110,6 @@ private:
         }
 
         union {
-            uint32_t int32;
             uint64_t int64;
             void* pointer;
             const void* constPointer;
