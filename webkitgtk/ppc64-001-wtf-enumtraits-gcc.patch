From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Sat, 7 Nov 2026 00:32:19 +1100
Subject: [PATCH] WTF: find the template argument in GCC's __PRETTY_FUNCTION__
 by its marker

enumTypeNameImpl and enumNameImpl cut the enumerator name out of
__PRETTY_FUNCTION__ at a fixed offset, assuming GCC spells the signature as
"constexpr std::span<const char> WTF::enumNameImpl() [with auto V = ". Some GCC
builds spell out std::span's default extent ("std::span<const char,
18446744073709551615>"), which shifts the name and makes every enumName()
wrong, so look for the " V = " (or " E = ") marker instead and stop at the
next ';' or ']'.

While here, enumName() of a value inside the enum's range that is not an
enumerator returns an empty span (GCC spells such a value as a cast,
"(Foo)50"), which EnumDumpWithDefault relies on; the tests expected the
out-of-range string for those, and compared only a prefix of the result.
The out-of-range literal is returned without its terminating NUL.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 Source/WTF/wtf/EnumTraits.h                  | 35 +++++++++++++++-----
 Tools/TestWebKitAPI/Tests/WTF/EnumTraits.cpp | 12 ++++---
 2 files changed, 35 insertions(+), 12 deletions(-)

diff --git a/Source/WTF/wtf/EnumTraits.h b/Source/WTF/wtf/EnumTraits.h
index 3ce4c9172063..60b23dc6f290 100644
--- a/Source/WTF/wtf/EnumTraits.h
+++ b/Source/WTF/wtf/EnumTraits.h
@@ -164,6 +164,28 @@ template <typename, auto>
 inline constexpr bool isEnumConstexprStaticCastValid = true;
 #endif
 
+#if COMPILER(GCC)
+// Returns the spelling of template parameter `parameter` in a GCC __PRETTY_FUNCTION__ such as
+// "constexpr std::span<const char> WTF::enumNameImpl() [with auto V = Foo::Bar]". GCC's spelling of
+// the rest of the signature is not stable -- some builds spell out std::span's default extent,
+// "std::span<const char, 18446744073709551615>" -- so a fixed-length prefix is wrong. Find the
+// argument by its " <parameter> = " marker and stop at the next ';' or the closing ']'.
+// prettyFunction includes the terminating NUL.
+constexpr std::span<const char> gccPrettyFunctionTemplateArgument(std::span<const char> prettyFunction, char parameter)
+{
+    for (size_t i = 1; i + 3 < prettyFunction.size(); ++i) {
+        if (prettyFunction[i - 1] != ' ' || prettyFunction[i] != parameter || prettyFunction[i + 1] != ' ' || prettyFunction[i + 2] != '=' || prettyFunction[i + 3] != ' ')
+            continue;
+        size_t start = i + 4;
+        size_t end = start;
+        while (end < prettyFunction.size() && prettyFunction[end] != ';' && prettyFunction[end] != ']' && prettyFunction[end])
+            ++end;
+        return prettyFunction.subspan(start, end - start);
+    }
+    return { };
+}
+#endif
+
 template<typename E>
 constexpr std::span<const char> enumTypeNameImpl()
 {
@@ -174,9 +196,7 @@ constexpr std::span<const char> enumTypeNameImpl()
     const size_t suffix = sizeof("]") - 1;
     std::span<const char> name = std::span { __PRETTY_FUNCTION__ }.subspan(prefix, sizeof(__PRETTY_FUNCTION__) - prefix - suffix - 1);
 #elif COMPILER(GCC)
-    const size_t prefix = sizeof("constexpr std::span<const char> WTF::enumTypeNameImpl() [with auto V = ") - 1;
-    const size_t suffix = sizeof("]") - 1;
-    std::span<const char> name = std::span { __PRETTY_FUNCTION__ }.subspan(prefix, sizeof(__PRETTY_FUNCTION__) - prefix - suffix - 1);
+    std::span<const char> name = gccPrettyFunctionTemplateArgument(std::span { __PRETTY_FUNCTION__ }, 'E');
 #else
 #error "Unsupported compiler"
 #endif
@@ -205,10 +225,9 @@ constexpr std::span<const char> enumNameImpl()
     if (name[0] == '(' || name[0] == '-' || ('0' <= name[0] && name[0] <= '9'))
         return { };
 #elif COMPILER(GCC)
-    const size_t prefix = sizeof("constexpr std::span<const char> WTF::enumNameImpl() [with auto V = ") - 1;
-    const size_t suffix = sizeof("]") - 1;
-    std::span<const char> name = std::span { __PRETTY_FUNCTION__ }.subspan(prefix, sizeof(__PRETTY_FUNCTION__) - prefix - suffix - 1);
-    if (name[0] == '(')
+    // A value that is not an enumerator is spelled as a cast, e.g. "(Foo)50".
+    std::span<const char> name = gccPrettyFunctionTemplateArgument(std::span { __PRETTY_FUNCTION__ }, 'V');
+    if (name.empty() || name[0] == '(')
         name = { };
 #else
 #error "Unsupported compiler"
@@ -307,7 +326,7 @@ constexpr std::span<const char> enumName(E v)
 
     Underlying value = static_cast<Underlying>(v);
     if (value < min || value > max)
-        return { "enum out of range" };
+        return std::span<const char> { "enum out of range", sizeof("enum out of range") - 1 };
 
     // Compute index safely using unsigned extension.
     size_t index = static_cast<size_t>(static_cast<Unsigned>(value - min));
diff --git a/Tools/TestWebKitAPI/Tests/WTF/EnumTraits.cpp b/Tools/TestWebKitAPI/Tests/WTF/EnumTraits.cpp
index bb459fc1b72c..6380578754d6 100644
--- a/Tools/TestWebKitAPI/Tests/WTF/EnumTraits.cpp
+++ b/Tools/TestWebKitAPI/Tests/WTF/EnumTraits.cpp
@@ -159,6 +159,8 @@ TEST(WTF_EnumTraits, ZeroBasedContiguousEnum)
 static bool isExpectedEnumString(const ASCIILiteral& expected, const std::span<const char>& result)
 {
     // result won't have a null terminator.
+    if (expected.length() != result.size())
+        return false;
     bool equal = true;
     for (size_t i = 0; i < result.size(); ++i)
         equal &= expected[i] == result[i];
@@ -250,14 +252,16 @@ TEST(WTF_EnumTraits, EnumNameValid)
 
 TEST(WTF_EnumTraits, EnumNameMediumEnumGaps)
 {
-    EXPECT_TRUE(isExpectedEnumString("enum out of range"_s, enumName(static_cast<MediumEnum>(50))));
-    EXPECT_TRUE(isExpectedEnumString("enum out of range"_s, enumName(static_cast<MediumEnum>(200))));
+    // A value inside the name range that is not an enumerator has no name. EnumDumpWithDefault relies on that.
+    EXPECT_TRUE(enumName(static_cast<MediumEnum>(50)).empty());
+    EXPECT_TRUE(enumName(static_cast<MediumEnum>(200)).empty());
 }
 
 TEST(WTF_EnumTraits, EnumNameOutOfRange)
 {
-    EXPECT_TRUE(isExpectedEnumString("enum out of range"_s, enumName(static_cast<EmptyEnum>(0))));
-    EXPECT_TRUE(isExpectedEnumString("enum out of range"_s, enumName(static_cast<SmallEnum>(300))));
+    // These two are inside the name range (300 truncates to 44 in a uint8_t), so they are gaps, not out of range.
+    EXPECT_TRUE(enumName(static_cast<EmptyEnum>(0)).empty());
+    EXPECT_TRUE(enumName(static_cast<SmallEnum>(300)).empty());
     EXPECT_TRUE(isExpectedEnumString("enum out of range"_s, enumName(static_cast<MediumEnum>(600))));
     EXPECT_TRUE(isExpectedEnumString("enum out of range"_s, enumName(static_cast<LargeEnum>(5000))));
     EXPECT_TRUE(isExpectedEnumString("enum out of range"_s, enumName(static_cast<SignedSmallEnum>(-5))));
