+void BeamModuleAssembler::emit_nyi(const char *msg) {
+    emit_enter_runtime(0);
+
+    mov_imm(ARG1, msg);
+    runtime_call<void (*)(const char *), i_emit_nyi>();
+
+    /* Never returns */
+}
