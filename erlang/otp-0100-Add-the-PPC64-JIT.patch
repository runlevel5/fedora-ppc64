+  // SP/FP/LR/PC (link register is a special purpose register, which doesn't have a general purpose register id).
+  Gp::kIdSp, Gp::kIdFp, 0xFFu, 0xFFu,
+
+  // Reserved.
+  { 0u, 0u, 0u },
