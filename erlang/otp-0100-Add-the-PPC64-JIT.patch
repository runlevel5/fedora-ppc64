+BeamModuleAssembler::BeamModuleAssembler(BeamGlobalAssembler *ga,
+                                         Eterm mod,
+                                         int num_labels,
+                                         int num_functions,
+                                         const BeamFile *file)
+        : BeamModuleAssembler(ga, mod, num_labels, file) {
