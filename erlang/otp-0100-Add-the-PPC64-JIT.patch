+             * are done before branching on their combined result. */
+            a.andi_rc(LR_TMP, Src, imm(_TAG_PRIMARY_MASK - TAG_PRIMARY_LIST));
+            cmp(Src, NIL, ppc::cr1);
+            a.cror(ppc::cr0.eq(), ppc::cr0.eq(), ppc::cr1.eq());
+            a.bne(Fail);
+        });
+    }
