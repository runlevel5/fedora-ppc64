+void BeamGlobalAssembler::emit_dispatch_return() {
+    a.mflr(ARG3);
+    a.li(LR_TMP, imm(0));
+    a.std(LR_TMP, ppc::Mem(c_p, offsetof(Process, current)));
+    mov_imm(TMP1, 1);
+    a.stb(TMP1, ppc::Mem(c_p, offsetof(Process, arity)));
+    a.b(labels[context_switch_simplified]);
+}
+
+void BeamModuleAssembler::emit_dispatch_return(bool set_I) {
+    if (erts_alcu_enable_code_atags || set_I) {
+        /* See emit_i_test_yield. */
+        a.mflr(LR_TMP);
+        a.std(LR_TMP, ppc::Mem(c_p, offsetof(Process, i)));
+    }
