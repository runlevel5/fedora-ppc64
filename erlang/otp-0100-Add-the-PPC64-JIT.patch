+void BeamModuleAssembler::emit_move_call_ext_last(const ArgYRegister &Src,
+                                                  const ArgRegister &Dst,
+                                                  const ArgExport &Exp,
+                                                  const ArgWord &Deallocate) {
+    mov_arg(Dst, Src);
+    emit_deallocate(Deallocate);
+    emit_i_call_ext_only(Exp);
+}
+
+static ErtsCodeMFA apply3_mfa = {am_erlang, am_apply, 3};
+
+ppc::Mem BeamModuleAssembler::emit_variable_apply(bool includeI) {
+    Label dispatch = a.new_label(), entry = a.new_label();
+
+    a.bind(entry);
+
+    emit_enter_runtime<Update::eReductions | Update::eHeapAlloc |
+                       Update::eXRegs>(3);
+
+    a.mr(ARG1, c_p);
+    load_x_reg_array(ARG2);
+
+    if (includeI) {
+        emit_adr(ARG3, entry);
+    } else {
+        mov_imm(ARG3, 0);
+    }
+
+    mov_imm(ARG4, 0);
+
+    comment("apply()");
+    runtime_call<const Export *(*)(Process *, Eterm *, ErtsCodePtr, Uint),
+                 apply>();
+
+    /* Any number of X registers can be live at this point. */
+    emit_leave_runtime<Update::eReductions | Update::eHeapAlloc |
+                       Update::eXRegs>();
+
+    cmp(ARG1, 0);
+    a.bne(dispatch);
+    emit_raise_exception(entry, &apply3_mfa);
+
+    a.bind(dispatch);
+    return emit_setup_dispatchable_call(ARG1);
+}
+
+void BeamModuleAssembler::emit_i_apply() {
+    ppc::Mem target = emit_variable_apply(false);
+    erlang_call(target);
+}
+
+void BeamModuleAssembler::emit_i_apply_last(const ArgWord &Deallocate) {
+    emit_deallocate(Deallocate);
+    emit_i_apply_only();
+}
+
+void BeamModuleAssembler::emit_i_apply_only() {
+    ppc::Mem target = emit_variable_apply(true);
+
+    emit_leave_erlang_frame();
+    branch(target);
+    mark_unreachable();
+}
+
+ppc::Mem BeamModuleAssembler::emit_fixed_apply(const ArgWord &Arity,
+                                               bool includeI) {
+    Label dispatch = a.new_label(), entry = a.new_label();
+
+    a.bind(entry);
+
+    mov_arg(ARG3, Arity);
+
+    emit_enter_runtime<Update::eReductions | Update::eHeapAlloc |
+                       Update::eXRegs>(Arity.get() + 2);
+
+    a.mr(ARG1, c_p);
+    load_x_reg_array(ARG2);
+
+    if (includeI) {
+        emit_adr(ARG4, entry);
+    } else {
+        mov_imm(ARG4, 0);
+    }
+
+    mov_imm(ARG5, 0);
+
+    runtime_call<const Export *(*)(Process *, Eterm *, Uint, ErtsCodePtr, Uint),
+                 fixed_apply>();
+
+    /* We will need to reload all X registers in case there has been
+     * an error. */
+    emit_leave_runtime<Update::eReductions | Update::eHeapAlloc |
+                       Update::eXRegs>();
+
+    cmp(ARG1, 0);
+    a.bne(dispatch);
+    emit_raise_exception(entry, &apply3_mfa);
+
+    a.bind(dispatch);
+
+    return emit_setup_dispatchable_call(ARG1);
+}
+
+void BeamModuleAssembler::emit_apply(const ArgWord &Arity) {
+    ppc::Mem target = emit_fixed_apply(Arity, false);
+    erlang_call(target);
+}
+
+void BeamModuleAssembler::emit_apply_last(const ArgWord &Arity,
+                                          const ArgWord &Deallocate) {
+    emit_deallocate(Deallocate);
+
+    ppc::Mem target = emit_fixed_apply(Arity, true);
+
+    emit_leave_erlang_frame();
+    branch(target);
+    mark_unreachable();
+}
